{
  "name": "cfl-tournament-hub",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "data:check": "node scripts/check-data.mjs",
    "data:new-match": "node scripts/new-match.mjs",
    "build:check": "node scripts/check-build.mjs",
    "db:seed:generate": "node scripts/generate-d1-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply cflesportsid --local",
    "db:seed:local": "wrangler d1 execute cflesportsid --local --file=.generated/seed-s1-s2.sql",
    "db:validate": "wrangler d1 execute cflesportsid --local --file=scripts/validate-d1.sql",
    "db:parity": "node scripts/check-d1-parity.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "^4.0.0"
  }
}
