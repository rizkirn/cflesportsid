---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'img'> {
  src: string;
  width: number;
  fallback?: string;
}

const {
  src,
  width,
  fallback,
  ...attributes
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/public/**/*.webp',
  { eager: true }
);

const original = images[`/public${src}`]?.default;

const small = original
  ? await getImage({
      src: original,
      width,
      format: 'webp',
      quality: 80
    })
  : undefined;

const retina = original
  ? await getImage({
      src: original,
      width: width * 2,
      format: 'webp',
      quality: 80
    })
  : undefined;

const outputSrc = small?.src || (original ? src : fallback || src);
const outputSrcset =
  small && retina
    ? `${small.src} 1x, ${retina.src} 2x`
    : undefined;
---

<img
  {...attributes}
  width={width}
  src={outputSrc}
  srcset={outputSrcset}
  onerror={fallback ? `this.onerror=null;this.removeAttribute('srcset');this.src='${fallback}'` : attributes.onerror}
/>