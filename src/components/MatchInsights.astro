---
import { imageFallbackHandler } from '../utils/assets.mjs';
interface Player {
  uid: string;
  profileId?: string;
  ign: string;
  teamId: string | null;
  teamTag: string;
  teamName: string;
  avatar: string;
  avatarLegacy?: string;
  totalKills: number;
  totalDeaths: number;
  totalAssists: number;
}

interface Props {
  players: Player[];
  team1Id?: string;
  team2Id?: string;
  team1Name: string;
  team2Name: string;
  comparison?: boolean;
  overviewOnly?: boolean;
  leadersOnly?: boolean;
}

const {
  players,
  team1Id,
  team2Id,
  team1Name,
  team2Name,
  comparison = false,
  overviewOnly = false,
  leadersOnly = false
} = Astro.props;

const left = players.filter(p => p.teamId === team1Id);
const right = players.filter(p => p.teamId === team2Id);

const ratio = (p: Player) =>
  (p.totalKills + p.totalAssists) / Math.max(p.totalDeaths, 1);

const metrics = [
  { label: 'Kills', key: 'totalKills' },
  { label: 'Deaths', key: 'totalDeaths' },
  { label: 'Assists', key: 'totalAssists' }
] as const;

const leaders = [
  { title: 'Top kills', value: (p: Player) => p.totalKills },
  { title: 'Top assists', value: (p: Player) => p.totalAssists },
  { title: 'Top KDA', value: ratio }
];
---

{!comparison ? (
  <>
    {!leadersOnly && (
      <>
        <h2 class="section-title" style="text-align:center;">
          Overview
        </h2>

        <section class="insight-summary" aria-label="Match summary">
          <div class="comparison-row team-labels">
            <strong>{team1Name}</strong>
            <span></span>
            <strong>{team2Name}</strong>
          </div>

          {metrics.map(metric => {
            const a = left.reduce(
              (n, p) => n + p[metric.key],
              0
            );

            const b = right.reduce(
              (n, p) => n + p[metric.key],
              0
            );

            return (
              <div class="comparison-row">
                <strong class:list={[a > b && 'larger']}>
                  {a}
                </strong>

                <span>{metric.label}</span>

                <strong class:list={[b > a && 'larger']}>
                  {b}
                </strong>
              </div>
            );
          })}
        </section>
      </>
    )}

    {!overviewOnly && (
      <>
        <h2 class="section-title">Match Leaders</h2>

        <div class="match-leaders">
          {leaders.map(board => {
            const ranked = [...players]
              .sort((a, b) => board.value(b) - board.value(a))
              .slice(0, 3);

            const top = ranked[0];

            return (
              <article class="match-leader">
                <h3>{board.title}</h3>

                {top && (
                  <div class="leader-photo">
                    <img
                      src={top.avatar}
                      alt=""
                      width="100"
                      height="110"
                      onerror={imageFallbackHandler(top.avatar,[top.avatarLegacy,'/players/default.webp'])}
                    />

                    <div class="featured-leader-info">
                      <a href={`/players/${top.profileId || top.uid}`}>
                        {top.ign}
                      </a>

                      <span>{top.teamName}</span>

                      <strong>
                        {board.title === 'Top KDA'
                          ? board.value(top).toFixed(2)
                          : `${board.value(top)} ${
                              board.title === 'Top kills'
                                ? 'kills'
                                : 'assists'
                            }`}
                      </strong>
                    </div>
                  </div>
                )}

                {ranked.map((p, i) => (
                  <a
                    href={`/players/${p.profileId || p.uid}`}
                    class="leader-entry"
                  >
                    <span>{i + 1}</span>

                    <strong>
                      {p.ign}
                      <small>{p.teamTag}</small>
                    </strong>

                    <b>
                      {board.title === 'Top KDA'
                        ? board.value(p).toFixed(2)
                        : board.value(p)}
                    </b>
                  </a>
                ))}
              </article>
            );
          })}
        </div>
      </>
    )}
  </>
) : (
  <section class="player-comparison">
    <h2 class="section-title">Player comparison</h2>

    <p class="comparison-help">
      Compare recorded stats from this match. KDA = (kills + assists)
      ÷ deaths, using 1 when deaths are zero.
    </p>

    <div class="comparison-selects">
      {[
        {
          id: 'a',
          name: team1Name,
          items: left
        },
        {
          id: 'b',
          name: team2Name,
          items: right
        }
      ].map(side => (
        <label>
          {side.name}

          <select data-compare-side={side.id}>
            <option value="">Select a player</option>

            {side.items.map(p => (
              <option value={p.uid}>
                {p.ign}
              </option>
            ))}
          </select>
        </label>
      ))}
    </div>

    <div class="comparison-profiles">
      {['a', 'b'].map(side => (
        <div
          class="comparison-profile"
          data-compare-profile={side}
          hidden
        >
          <img
            width="110"
            height="120"
            alt=""
          />

          <a></a>
          <span></span>
        </div>
      ))}
    </div>

    <div
      class="insight-summary"
      data-comparison-stats
      hidden
    >
      {[
        'Kills',
        'Deaths',
        'Assists',
        'KDA ratio'
      ].map((label, i) => (
        <div class="comparison-row">
          <strong data-value={`a-${i}`}>
            —
          </strong>

          <span>{label}</span>

          <strong data-value={`b-${i}`}>
            —
          </strong>
        </div>
      ))}
    </div>

    <button
      type="button"
      data-compare-reset
      hidden
    >
      Reset comparison
    </button>

    <script
      type="application/json"
      data-comparison-data
      set:html={JSON.stringify({
        a: left,
        b: right
      }).replace(/</g, '\u003c')}
    />
  </section>
)}

<script>
  document
    .querySelectorAll<HTMLElement>('.player-comparison')
    .forEach(root => {
      const data = JSON.parse(
        root.querySelector('[data-comparison-data]')!.textContent!
      );

      function update() {
        const values: Record<
          string,
          number[] | undefined
        > = {};

        for (const side of ['a', 'b']) {
          const select =
            root.querySelector<HTMLSelectElement>(
              `[data-compare-side="${side}"]`
            )!;

          const id = select.value;

          const p = data[side].find(
            (p: { uid: string }) => p.uid === id
          );

          const profile =
            root.querySelector<HTMLElement>(
              `[data-compare-profile="${side}"]`
            )!;

          profile.hidden = !p;

          if (p) {
            const img =
              profile.querySelector('img')!;

            const sources=[...new Set([p.avatarLegacy,'/players/default.webp'].filter(source=>source&&source!==p.avatar))];
            let fallbackIndex=0;
            img.hidden=false;
            img.onerror = () => {
              img.removeAttribute('srcset');
              if(fallbackIndex<sources.length)img.src=sources[fallbackIndex++];
              else {img.onerror=null;img.hidden=true;}
            };

            img.src = p.avatar;
            img.alt = p.ign;

            const link =
              profile.querySelector('a')!;

            link.textContent = p.ign;
            link.href =
              `/players/${encodeURIComponent(p.profileId || p.uid)}`;

            profile.querySelector('span')!.textContent =
              p.teamTag;

            values[side] = [
              p.totalKills,
              p.totalDeaths,
              p.totalAssists,
              (p.totalKills + p.totalAssists) /
                Math.max(p.totalDeaths, 1)
            ];
          }
        }

        const stats =
          root.querySelector<HTMLElement>(
            '[data-comparison-stats]'
          )!;

        const reset =
          root.querySelector<HTMLButtonElement>(
            '[data-compare-reset]'
          )!;

        const hasA = !!values.a;
        const hasB = !!values.b;
        const hasSelection = hasA || hasB;

        /*
         * Comparison stats only appear once
         * both players are selected.
         */
        stats.hidden = !(hasA && hasB);

        /*
         * Reset only appears after at least
         * one player has been selected.
         */
        reset.hidden = !hasSelection;

        /*
         * When both players are selected,
         * place Reset below the stats.
         * Otherwise keep it below the selects.
         */
        if (hasA && hasB) {
          stats.after(reset);
        } else {
          root
            .querySelector('.comparison-selects')!
            .after(reset);
        }

        for (const side of ['a', 'b']) {
          for (let i = 0; i < 4; i++) {
            const cell =
              root.querySelector<HTMLElement>(
                `[data-value="${side}-${i}"]`
              )!;

            const value =
              values[side]?.[i];

            const other =
              values[
                side === 'a' ? 'b' : 'a'
              ]?.[i];

            cell.textContent =
              value === undefined
                ? '—'
                : i === 3
                  ? value.toFixed(2)
                  : String(value);

            cell.classList.toggle(
              'larger',
              value !== undefined &&
                other !== undefined &&
                value > other
            );
          }
        }
      }

      root
        .querySelectorAll<HTMLSelectElement>('select')
        .forEach(select => {
          select.addEventListener(
            'change',
            update
          );
        });

      root
        .querySelector<HTMLButtonElement>(
          '[data-compare-reset]'
        )!
        .addEventListener('click', () => {
          root
            .querySelectorAll<HTMLSelectElement>(
              'select'
            )
            .forEach(select => {
              select.value = '';
            });

          update();
        });

      /*
       * Important:
       * establish correct initial state.
       */
      update();
    });
</script>

<style>
  .insight-summary {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 22px;
    margin: 24px 0;
  }

  .insight-summary h2 {
    text-align: center;
    font-size: 20px;
    margin-bottom: 18px;
  }

  .comparison-row {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(80px, 1fr)
      minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }

  .comparison-row:last-child {
    border: 0;
  }

  .comparison-row > span {
    text-align: center;
    color: var(--text-muted);
  }

  .comparison-row > strong:last-child {
    text-align: right;
    justify-self: end;
  }

  .comparison-row > strong {
    justify-self: start;
    padding: 3px 9px;
    border-radius: 5px;
    overflow-wrap: anywhere;
  }

  .larger {
    background: var(--accent);
    color: #171719;
  }

  .match-leaders {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .match-leader {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-secondary);
    overflow: hidden;
  }

  .match-leader h3 {
    font-size: 17px;
    padding: 16px;
  }

  .leader-photo {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 14px;
    padding: 12px 14px 0;
    background:
      linear-gradient(
        120deg,
        #403023,
        #252528
      );
  }

  .leader-photo img {
    flex-shrink: 0;
    object-fit: contain;
    object-position: bottom;
  }

  .featured-leader-info {
    min-width: 0;
    padding-bottom: 12px;
  }

  .featured-leader-info a,
  .featured-leader-info span,
  .featured-leader-info strong {
    display: block;
    overflow-wrap: anywhere;
  }

  .featured-leader-info a {
    font-size: 15px;
    font-weight: 700;
  }

  .featured-leader-info span {
    font-size: 12px;
    color: var(--text-muted);
    margin: 4px 0;
  }

  .featured-leader-info strong {
    font-size: 17px;
  }

  .leader-entry {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--text-primary);
  }

  .leader-entry strong {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .leader-entry small {
    display: block;
    color: var(--text-muted);
  }

  .leader-entry b {
    color: var(--accent);
  }

  .comparison-help {
    color: var(--text-muted);
    font-size: 14px;
  }

  .comparison-selects,
  .comparison-profiles {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 20px 0;
  }

  .comparison-selects label {
    font-size: 14px;
  }

  .comparison-selects select {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 10px;
  }

  .comparison-profile {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-align: center;
    padding: 15px;
    overflow-wrap: anywhere;
  }

  .comparison-profile img {
    object-fit: contain;
    display: block;
    margin: auto;
  }

  .comparison-profile a,
  .comparison-profile span {
    display: block;
  }

  .comparison-profile span {
    color: var(--text-muted);
    font-size: 13px;
  }

  /*
   * Reset button
   */
  .player-comparison [data-compare-reset] {
    display: block;
    margin: 0 auto;
    background: #ff742e;
    color: #ffffff;
    border: 1px solid #ff742e;
    border-radius: 6px;
    padding: 10px 15px;
    cursor: pointer;
    font-weight: 600;
    transition:
      background-color .18s,
      box-shadow .18s,
      transform .18s;
  }

  .player-comparison [data-compare-reset]:hover {
    background: #ff955f;
    border-color: #ff955f;
    box-shadow:
      0 3px 12px #ff742e33;
    transform: translateY(-1px);
  }

  .player-comparison [data-compare-reset]:active {
    transform: translateY(0);
  }

  /*
   * These MUST come after the normal component rules.
   * They prevent display:block from overriding hidden.
   */
  .player-comparison [data-compare-reset][hidden],
  .player-comparison
    [data-comparison-stats][hidden],
  .player-comparison
    .comparison-profile[hidden] {
    display: none !important;
  }

  @media (max-width: 640px) {
    .match-leaders {
      grid-template-columns: 1fr;
    }

    .comparison-selects,
    .comparison-profiles {
      gap: 10px;
    }

    .insight-summary {
      padding: 14px;
    }

    .comparison-row {
      gap: 5px;
      font-size: 13px;
    }

    .team-labels {
      grid-template-columns:
        1fr 20px 1fr;
    }
  }
</style>
