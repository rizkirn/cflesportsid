---
const { round, index } = Astro.props;
---
<fieldset class="setup-round">
  <legend>Round {index + 1}</legend>
  <input type="hidden" name={`rounds.${index}.id`} value={round.id} />
  <div><label for={`round-${index}-name`}>Round name</label><input id={`round-${index}-name`} name={`rounds.${index}.name`} value={round.name} maxlength="80" required /></div>
  <div><label for={`round-${index}-order`}>Order</label><input id={`round-${index}-order`} name={`rounds.${index}.sort_order`} value={round.sort_order} type="number" min="1" max="16" required /></div>
  <div><label for={`round-${index}-placement`}>Placement</label><select id={`round-${index}-placement`} name={`rounds.${index}.placement`}><option value="" selected={round.placement === ''}>Progression</option><option value="3" selected={round.placement === '3'}>3: Bronze</option><option value="1" selected={round.placement === '1'}>1: Final</option></select></div>
  <button class="admin-outline" type="submit" name="remove_round" value={index} formnovalidate aria-label={`Remove round ${index + 1}`}>Remove</button>
</fieldset>
