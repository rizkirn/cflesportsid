---
import Status from './StatusBadge.astro';
const {db,tournamentId}=Astro.props;
let matches=[];let failed=false;
try{if(!tournamentId)throw new Error('Tournament context required');const result=await db.prepare(`SELECT m.*,t.name AS tournament_name,r.name AS round_name,a.name AS team1_name,b.name AS team2_name,(SELECT status FROM match_detail_edits WHERE match_id=m.id) AS detail_status,(SELECT count(*) FROM match_maps WHERE match_id=m.id)+(SELECT count(*) FROM match_map_walkovers WHERE match_id=m.id) AS detail_maps FROM matches m JOIN tournaments t ON t.id=m.tournament_id JOIN tournament_rounds r ON r.tournament_id=m.tournament_id AND r.stage_id=m.stage_id AND r.id=m.round_id LEFT JOIN teams a ON a.id=m.team1_id LEFT JOIN teams b ON b.id=m.team2_id WHERE m.tournament_id=? ORDER BY m.date DESC,r.sort_order,m.bracket_slot`).bind(tournamentId).all();if(!result.success)throw new Error();matches=result.results;}catch{failed=true;Astro.response.status=503;}
const q=Astro.url.searchParams.get('q')??'';const status=Astro.url.searchParams.get('status')??'';
const rows=matches.filter(row=>`${row.id} ${row.team1_name} ${row.team2_name}`.toLowerCase().includes(q.toLowerCase())&&(!status||row.status===status));
const link=row=>row.result_type==='walkover'||row.status!=='completed'?`/admin/tournaments/${row.tournament_id}/bracket?match=${encodeURIComponent(row.id)}`:`/admin/tournaments/${row.tournament_id}/matches/${row.id}`;
---
{failed?<p class="admin-error" role="alert">Could not load matches. Reload to try again.</p>:<>
<form method="get" class="admin-toolbar"><label>Search teams<input type="search" name="q" value={q}/></label><label>Status<select name="status"><option value="">All</option>{['upcoming','live','completed'].map(value=><option value={value} selected={value===status}>{value==='completed'?'Confirmed':value==='live'?'Live':'Upcoming'}</option>)}</select></label>{!tournamentId&&<label>Tournament<select name="tournament"><option value="">All</option>{Array.from(new Map(matches.map(row=>[row.tournament_id,row.tournament_name]))).map(([id,name])=><option value={id} selected={id===tournament}>{name}</option>)}</select></label>}<button class="admin-outline" type="submit">Filter</button></form>
{rows.length?<table class="admin-table operational-table"><thead><tr><th>Match</th>{!tournamentId&&<th>Tournament</th>}<th>Result</th><th>Details</th></tr></thead><tbody>{rows.map(row=><tr><td data-label="Match"><a href={link(row)}>{row.team1_name??'TBD'} vs {row.team2_name??'TBD'}</a><small>{row.round_name} · Match {row.bracket_slot}</small></td>{!tournamentId&&<td data-label="Tournament">{row.tournament_name}</td>}<td data-label="Result"><strong class="match-score">{row.result_type==='walkover'?'Full-match W/O':`${row.score1}-${row.score2}`}</strong><Status label={row.status==='completed'?'Confirmed':row.status==='live'?'Live':'Upcoming'} tone={row.status==='completed'?'ready':'info'}/></td><td data-label="Details"><Status label={row.result_type==='walkover'?'Not required':row.detail_status==='complete'?'Completed':row.detail_status==='draft'?'Draft':row.detail_maps?'Imported':row.status==='completed'?'Details Pending':'Awaiting result'} tone={row.result_type==='walkover'?'neutral':row.detail_status==='complete'?'ready':row.status==='completed'?'pending':'neutral'}/></td></tr>)}</tbody></table>:<p class="admin-empty">No matches. Confirm the official draw in Bracket to create matches.</p>}
</>}
