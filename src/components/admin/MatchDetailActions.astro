---
interface Props {
  tournamentId: string;
  match: { id: string; status: string; result_type?:string; detail_status?: string | null; detail_maps: number; detail_entries: number; detail_rounds: number };
}
const { tournamentId, match } = Astro.props;
const complete = match.detail_status === 'complete';
const imported = Boolean(match.detail_maps || match.detail_entries || match.detail_rounds);
const draft = match.detail_status === 'draft';
const status = complete ? 'Details completed' : imported ? 'Details entered (read-only)' : draft ? 'Details draft' : 'Details not entered';
const action = complete || imported ? 'View Match Details' : draft ? 'Continue Match Details' : 'Enter Match Details';
---
<span>{match.result_type==='walkover'?'W/O · Match Details not required':status}</span>
<div class="admin-actions match-detail-actions">
  {match.status === 'completed' && match.result_type!=='walkover' && <a class="admin-button" href={`/admin/tournaments/${tournamentId}/matches/${match.id}`}>{action}</a>}
  <a href={`/matches/${match.id}`}>View public match</a>
</div>
