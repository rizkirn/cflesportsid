---
import Thumbnail from './Thumbnail.astro';
interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo" aria-label="CFL Esports Indonesia home"><Thumbnail src="/brand/cflesports-id.webp" width={192} height="70" alt="CFL Esports Indonesia" /></a>
    
    <!-- Mobile menu button -->
    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu" aria-controls="main-nav" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    
    <!-- Navigation -->
    <nav class="nav" id="main-nav">
      <a href="/" class:list={[current === 'Home' && 'active']}>Home</a>
      <a href="/teams" class:list={[current === 'Teams' && 'active']}>Teams</a>
      <a href="/players" class:list={[current === 'Players' && 'active']}>Players</a>
      <a href="/matches" class:list={[current === 'Matches' && 'active']}>Matches</a>
      <a href="/tournament" class:list={[current === 'Tournaments' && 'active']}>Tournaments</a>
      <a href="/maps" class:list={[current === 'Maps' && 'active']}>Maps</a>
      <a href="/veto" class:list={[current === 'Veto' && 'active']}>Veto</a>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('main-nav');
    
    if (menuBtn && nav) {
      const mobileViewport = window.matchMedia('(max-width: 768px)');
      const closeMenu = () => {
        nav.classList.remove('active');
        document.body.classList.remove('menu-open');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.classList.remove('active');
      };

      mobileViewport.addEventListener('change', (event) => {
        if (!event.matches) closeMenu();
      });

      menuBtn.addEventListener('click', () => {
        nav.classList.toggle('active');
        document.body.classList.toggle('menu-open', nav.classList.contains('active'));
        menuBtn.setAttribute('aria-expanded', String(nav.classList.contains('active')));
        menuBtn.classList.toggle('active');
      });
      
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav.classList.contains('active')) {
          closeMenu();
          menuBtn.focus();
        }
      });
      nav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          closeMenu();
        });
      });
    }
  });
</script>

<style>
  .site-header {
    position:sticky;
    top:0;
    z-index:1000;
  }
  @media (max-width: 768px) {
    :global(body.menu-open) {
      overflow: hidden;
    }
  }
  .logo img { display:block; width:154px; height:56px; object-fit:contain; background:transparent; border-radius:4px; }
  @media (max-width:768px) { .logo img { width:132px; height:48px; } }
  /* Mobile menu button - hidden on desktop */
  .mobile-menu-btn {
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 101;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: all 0.3s;
    border-radius: 2px;
  }

  /* Hamburger animation when active */
  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  @media (max-width: 768px) {
    .site-header .container {
      position: relative;
      gap: 0.5rem;
    }

    .logo { font-size: 1.1rem; }

    .mobile-menu-btn {
      display: flex;
    }
    
    /* Mobile navigation - hidden by default */
    .nav {
      width:100%;
      flex-wrap:nowrap;
      visibility:hidden;
      position:fixed;
      top:64px;
      left:0;
      right:0;
      bottom:0;
      background:rgba(12,13,15,.90);
      backdrop-filter:blur(10px);
      -webkit-backdrop-filter:blur(10px);
      flex-direction:column;
      gap:0;
      padding:0;
      max-height:0;
      overflow-y:auto;
      transition:max-height .3s ease;
      z-index:999;
    }

    .nav.active {
      visibility:visible;
      max-height:calc(100dvh - 64px);
      box-shadow:0 4px 20px rgba(0,0,0,.3);
    }
    
    .nav a {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.95rem;
      display: block;
    }
    
    .nav a:last-child {
      border-bottom: none;
    }
    
    .nav a:hover,
    .nav a.active {
      background: var(--bg-card);
      color: var(--accent);
    }
  }

</style>
