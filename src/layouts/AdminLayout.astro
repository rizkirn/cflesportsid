---
import Layout from './Layout.astro';
import '../styles/admin.css';
import Status from '../components/admin/StatusBadge.astro';
import type { ParticipantState } from '../admin/participants.mjs';
import { rosterReadiness } from '../admin/roster-snapshot.mjs';
interface Props { title: string; workspace?: ParticipantState | null; }
const { title, workspace } = Astro.props;
const savedState = workspace ? JSON.parse(workspace.snapshot) : null;
const roster = workspace ? rosterReadiness(workspace.participants, savedState.roster ?? savedState.participants.roster) : null;
const base = workspace ? `/admin/tournaments/${workspace.tournament.id}` : '';
const sections = workspace ? [
  ['Overview','',workspace.tournament.status],
  ['Participants','/participants',`${workspace.participants.length} teams${workspace.locked ? ' · Read-only' : ''}`],
  ['Roster','/roster',`${roster?.teams.filter(team => team.ready).length} / ${workspace.participants.length} ready${workspace.locked ? ' · Read-only' : ''}`],
  ['Maps','/maps','Official round and match maps'],
  ['Bracket','/bracket','Tournament bracket and results'],
  ['Matches','/matches','Tournament match details'],
] : [];
---
<Layout title={`${title} | CFL Esports ID Admin`} noindex admin>
  <div class="admin-page admin-shell">
    <aside class="admin-global"><a href="/admin" class="admin-brand"><span>CFL</span> Operations</a><span class="admin-help">Local admin · Staging</span><details class="admin-menu" open><summary>Admin Menu</summary><nav aria-label="Admin">
      <a href="/admin" aria-current={Astro.url.pathname==='/admin'?'page':undefined}>Overview</a>
      <a href="/admin/tournaments" aria-current={Astro.url.pathname.startsWith('/admin/tournaments')?'page':undefined}>Tournaments</a>
      <h2>Database</h2>{['Teams','Players','Maps'].map(label=><a href={`/admin/${label.toLowerCase()}`} aria-current={Astro.url.pathname===`/admin/${label.toLowerCase()}`?'page':undefined}>{label}</a>)}
    </nav></details></aside>
    <div class="tournament-content" id="admin-content">
      {workspace&&<header class="tournament-context"><a href="/admin/tournaments">Tournaments</a><span aria-hidden="true">/</span><strong>{workspace.tournament.name}</strong>{workspace.tournament.is_test===1&&<span class="test-badge">TEST</span>}<Status label={workspace.tournament.status==='upcoming'?'Upcoming':workspace.tournament.status==='ongoing'?'Ongoing':'Completed'} tone={workspace.tournament.status==='completed'?'ready':'info'}/></header>}
      {workspace && <nav class="tournament-tabs" aria-label="Tournament workspace">{sections.map(([label,path,status]) => <a href={`${base}${path}`} aria-current={Astro.url.pathname.replace(/\/$/,'') === `${base}${path}` || path==='/matches'&&Astro.url.pathname.startsWith(`${base}/matches/`) ? 'page' : undefined} title={status}><strong>{label}</strong></a>)}</nav>}
      <slot />
    </div>
  </div>
</Layout>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-pending-form]').forEach(form => {
    let pending = false;
    const status = form.querySelector('.admin-submit-status');
    form.addEventListener('submit', event => {
      if (event.defaultPrevented) return;
      if (pending) { event.preventDefault(); return; }
      pending = true; form.setAttribute('aria-busy','true');
      form.querySelectorAll('button[type="submit"]').forEach(button => button.setAttribute('aria-disabled','true'));
      if (status) status.textContent = 'Saving changes. Please wait.';
    });
    window.addEventListener('pageshow', () => { pending = false; form.removeAttribute('aria-busy'); form.querySelectorAll('button[type="submit"]').forEach(button => button.removeAttribute('aria-disabled')); if (status) status.textContent = ''; });
  });
</script>
<script>
  const menu=document.querySelector<HTMLDetailsElement>('.admin-menu');
  const narrow=window.matchMedia('(max-width:760px)');
  const updateMenu=()=>{if(menu)menu.open=!narrow.matches;};
  updateMenu();narrow.addEventListener('change',updateMenu);
</script>
