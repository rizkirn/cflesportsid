---
import Thumbnail from '../components/Thumbnail.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getOverallStandings } from '../utils/standings';
import { calculateStatistics, emptyStats } from '../utils/statistics';
import { getMatchTeam1Id, getMatchTeam2Id } from '../utils/content';
import '../styles/home.css';

const teams = await getCollection('teams');
const allPlayers = await getCollection('players');
const matches = await getCollection('matches');
const tournaments = await getCollection('tournaments');

const calculated = calculateStatistics(matches);

const players = allPlayers.map(player => ({
  ...player,
  data: {
    ...player.data,
    stats:
      calculated.players.get(player.data.uid || player.id) ??
      emptyStats()
  }
}));

const standings = getOverallStandings(teams, matches, tournaments);

const teamById = new Map(
  teams.map(team => [team.id, team])
);

const teamName = (id: string | null) =>
  teamById.get(id ?? '')?.data.name ??
  id ??
  'TBD';

const teamLogo = (id: string | null) => {
  const team = teamById.get(id ?? '');

  return team
    ? team.data.logo || `/logos/${team.data.tag}.webp`
    : '/logos/default.webp';
};

const completedMatches = matches.filter(
  match => match.data.status === 'completed'
);

const recentMatches = [...completedMatches]
  .sort(
    (a, b) =>
      b.data.date.localeCompare(a.data.date) ||
      b.id.localeCompare(a.id, undefined, { numeric: true })
  )
  .slice(0, 5);

const upcomingMatches = matches
  .filter(match => match.data.status === 'upcoming')
  .sort((a, b) => a.data.date.localeCompare(b.data.date));

const nextMatch = upcomingMatches[0];

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    timeZone: 'UTC'
  });

const leaders = [
  {
    title: 'Top fraggers',
    unit: 'Kills',
    entries: [...players]
      .sort((a, b) => b.data.stats.kills - a.data.stats.kills)
      .slice(0, 3)
      .map(player => ({
        player,
        value: player.data.stats.kills
      }))
  },
  {
    title: 'Top assists',
    unit: 'Assists',
    entries: [...players]
      .sort((a, b) => b.data.stats.assists - a.data.stats.assists)
      .slice(0, 3)
      .map(player => ({
        player,
        value: player.data.stats.assists
      }))
  },
  {
    title: 'Top MVPs',
    unit: 'Awards',
    entries: [...players]
      .filter(player => player.data.stats.mvpCount > 0)
      .sort((a, b) => b.data.stats.mvpCount - a.data.stats.mvpCount)
      .slice(0, 3)
      .map(player => ({
        player,
        value: player.data.stats.mvpCount
      }))
  }
];

const seasons = [
  'August',
  'September',
  'October',
  'November'
].map((month, index) => {
  const number = index + 1;

  const tournament = tournaments.find(item =>
    new RegExp(`\\bS${number}\\b`, 'i').test(item.data.name)
  );

  return {
    number,
    month,
    tournament,
    status: tournament?.data.status ?? null
  };
});

const placements = [
  { label: 'Champion', rank: '01', points: 10 },
  { label: 'Runner-up', rank: '02', points: 6 },
  { label: 'Third place', rank: '03', points: 4 },
  { label: 'Fourth place', rank: '04', points: 2 }
];

const latestTournament = [...tournaments]
  .sort((a, b) =>
    b.data.startDate.localeCompare(a.data.startDate)
  )[0];

/*
 * Tournament winners are the teams already guaranteed
 * an All-Star position.
 *
 * The standings utility already determines this through
 * isTournamentWinner, so we reuse that instead of
 * hard-coding qualified teams.
 */
const qualifiedTeams = standings.filter(
  team => team.isTournamentWinner
);

const allStarSpots = 10;

const remainingSpots = Math.max(0, allStarSpots - qualifiedTeams.length);

const qualificationPercent = Math.min(
  (qualifiedTeams.length / allStarSpots) * 100,
  100
);
---

<Layout
  title="Clash for Glory — Road to All-Star"
  current="Home"
>
  <div class="home-page">

    <!-- HERO -->
    <section
      class="home-hero"
      aria-labelledby="home-title"
    >
      <picture class="home-hero-picture">
        <source
          media="(max-width: 768px)"
          srcset="/images/cfl-hero-mobile.webp"
        />

        <img
          class="home-hero-art"
          src="/images/cfl-hero.webp"
          alt=""
          width="2079"
          height="756"
          fetchpriority="high"
        />
      </picture>

      <div class="hero-shade" aria-hidden="true"></div>

      <div class="home-shell hero-copy">
        <p class="home-kicker">
          Crossfire Legends · Indonesia
        </p>

        <h1 id="home-title">
          <span>Clash for Glory</span>
          <strong>
            Road to <em>All-Star</em>
          </strong>
        </h1>

        <p class="hero-description">
          Four tournaments. Ten All-Star spots.<br />
          Indonesia fights for a bigger stage.
        </p>

        <div class="hero-actions">
          <a
            class="home-primary"
            href="#standings"
          >
            View standings
            <span aria-hidden="true">→</span>
          </a>

          <a
            class="home-secondary"
            href="#qualification"
          >
            All-Star qualification
          </a>
        </div>
      </div>
    </section>

    <!-- SEASON NUMBERS -->
    <div class="competition-strip">
      <div class="home-shell competition-inner">

        <dl class="competition-numbers">
          <div>
            <dd>{teams.length}</dd>
            <dt>Teams</dt>
          </div>

          <div>
            <dd>{players.length}</dd>
            <dt>Players</dt>
          </div>

          <div>
            <dd>4</dd>
            <dt>Tournaments</dt>
          </div>

          <div>
            <dd>10</dd>
            <dt>All-Star spots</dt>
          </div>
        </dl>

        <p class="competition-region">
          Indonesia
          <span>Road to All-Star</span>
        </p>

      </div>
    </div>

    <main class="home-shell home-content">

      <!-- QUALIFICATION -->
      <section
        class="home-panel qualification-section"
        id="qualification"
        aria-labelledby="qualification-title"
      >
        <div class="panel-heading qualification-heading">

          <div>
            <p class="home-kicker">
              The destination
            </p>

            <h2 id="qualification-title">
              All-Star qualification
            </h2>

            <p class="panel-description">
              Tournament winners secure their place.
              Remaining spots are decided by the final
              Road to All-Star standings.
            </p>
          </div>

          <div class="qualification-count">
            <strong>{qualifiedTeams.length}</strong>
            <span>/ {allStarSpots} qualified</span>
          </div>

        </div>

        <div
          class="qualification-progress"
          aria-hidden="true"
        >
          <span
            style={`width:${qualificationPercent}%`}
          ></span>
        </div>

        <div class="qualification-summary">
          {qualifiedTeams.map(team => (
            <a class="qualification-team" href={`/teams/${team.id}`}>
              <Thumbnail src={team.logo} fallback="/logos/default.webp" width={40} height="40" alt="" />
              <span><strong>{team.name}</strong><small>Qualified</small></span>
            </a>
          ))}
          <p class="qualification-remaining">
            <strong>{remainingSpots}</strong>
            <span>{remainingSpots === 1 ? 'place remaining' : remainingSpots === 0 ? 'All places filled' : 'places remaining'}</span>
          </p>
        </div>
      </section>

      <!-- ROAD + POINTS -->
      <div class="season-row">

        <section
          class="home-panel season-road"
          aria-labelledby="season-title"
        >
          <div class="panel-heading">
            <div>
              <p class="home-kicker">
                Four tournaments. One journey.
              </p>

              <h2 id="season-title">
                Road to All-Star
              </h2>
            </div>

            <a href="/tournament">
              View tournaments
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <ol class="season-timeline">
            {seasons.map(season => (
              <li
                class:list={[
                  season.status === 'completed' &&
                    'is-complete',
                  season.status === 'ongoing' &&
                    'is-live'
                ]}
              >
                <div class="season-number">
                  S{season.number}
                </div>

                <span class="season-month">
                  {season.month}
                </span>

                <span
                  class="timeline-point"
                  aria-hidden="true"
                >
                  {season.status === 'completed'
                    ? '✓'
                    : ''}
                </span>

                {season.tournament ? (
                  <a
                    href={`/tournament/${season.tournament.id}`}
                  >
                    {season.status === 'completed'
                      ? 'Completed'
                      : season.status === 'ongoing'
                        ? 'In progress'
                        : 'Upcoming'}

                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="season-state">
                    Planned
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>

        <section
          class="home-panel scoring-panel"
          aria-labelledby="points-title"
        >
          <h2 id="points-title">
            How points work
          </h2>

          <p>
            Kill points + placement points = total score
          </p>

          <dl class="points-grid">
            {placements.map(place => (
              <div>
                <dt>
                  <span>#{place.rank}</span>
                  {place.label}
                </dt>

                <dd>+{place.points}</dd>
              </div>
            ))}
          </dl>

          <details class="points-rules">
            <summary>
              Qualification rules
              <span aria-hidden="true">+</span>
            </summary>

            <p>
              Tournament winners qualify automatically.
              All-Star has 10 spots; remaining places are
              decided by overall standings. Repeat winners
              count once. Standings remain provisional
              until all four tournaments are complete.
            </p>
          </details>
        </section>

      </div>

      <!-- STANDINGS -->
      <section
        class="home-panel standings-section"
        id="standings"
        aria-labelledby="standings-title"
      >
        <div class="panel-heading">

          <div class="heading-inline">
            <h2 id="standings-title">
              Team standings
            </h2>

            <span>Road to All-Star</span>
          </div>

          <a href="/teams">
            Team directory
            <span aria-hidden="true">↗</span>
          </a>

        </div>

        <div class="standings-data">
          <label class="standings-breakdown-toggle">
            <input type="checkbox" id="standings-breakdown" />
            Show point breakdown and qualification
          </label>

          <div
            class="home-table-scroll"
            role="region"
            aria-label="Overall team standings"
            tabindex="0"
          >
            <table class="home-standings">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Team</th>
                  <th scope="col">Kill pts</th>
                  <th scope="col">Place pts</th>
                  <th scope="col">Total</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>

              <tbody>
                {standings.slice(0, 5).map((team, index) => (
                  <tr>
                    <td>
                      {String(index + 1).padStart(2, '0')}
                    </td>

                    <th scope="row">
                      <a href={`/teams/${team.id}`}>
                        <Thumbnail
                          src={team.logo}
                          fallback="/logos/default.webp"
                          width={32}
                          height="32"
                          alt=""
                        />

                        <span>{team.name}</span>
                      </a>
                    </th>

                    <td>{team.killPoints}</td>
                    <td>{team.placementPoints}</td>

                    <td class="standing-total">
                      {team.totalScore}
                    </td>

                    <td>
                      {team.isTournamentWinner ? (
                        <span class="qualified-label">
                          Qualified
                        </span>
                      ) : (
                        <span
                          class="pending-status"
                          aria-label="Not yet qualified"
                        >
                          —
                        </span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {standings.length > 5 && (
            <details class="full-standings">
              <summary>
                All {standings.length} teams
                <span aria-hidden="true">+</span>
              </summary>

              <div
                class="home-table-scroll"
                role="region"
                aria-label="Remaining team standings"
                tabindex="0"
              >
                <table class="home-standings">
                  <thead>
                    <tr>
                      <th scope="col">#</th>
                      <th scope="col">Team</th>
                      <th scope="col">Kill pts</th>
                      <th scope="col">Place pts</th>
                      <th scope="col">Total</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>

                  <tbody>
                    {standings
                      .slice(5)
                      .map((team, index) => (
                        <tr>
                          <td>
                            {String(index + 6).padStart(2, '0')}
                          </td>

                          <th scope="row">
                            <a href={`/teams/${team.id}`}>
                              <Thumbnail
                                src={team.logo}
                                fallback="/logos/default.webp"
                                width={32}
                                height="32"
                                alt=""
                                loading="lazy"
                              />

                              <span>{team.name}</span>
                            </a>
                          </th>

                          <td>{team.killPoints}</td>
                          <td>{team.placementPoints}</td>

                          <td class="standing-total">
                            {team.totalScore}
                          </td>

                          <td>
                            {team.isTournamentWinner ? (
                              <span class="qualified-label">
                                Qualified
                              </span>
                            ) : (
                              <span
                                class="pending-status"
                                aria-label="Not yet qualified"
                              >
                                —
                              </span>
                            )}
                          </td>
                        </tr>
                      ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {!standings.length && (
            <p class="home-empty">
              Standings will appear when teams are registered.
            </p>
          )}

        </div>
      </section>

      <!-- PLAYERS + MATCHES -->
      <div class="performance-row">

        <section
          class="home-panel players-section"
          aria-labelledby="players-title"
        >
          <div class="panel-heading">

            <div class="heading-inline">
              <h2 id="players-title">
                Top players
              </h2>

              <span>Overall performance</span>
            </div>

            <a href="/players">
              View all players
              <span aria-hidden="true">↗</span>
            </a>

          </div>

          <div class="home-leaderboards">
            {leaders.map(board => (
              <article class="home-leaderboard">

                <h3>
                  {board.title}
                  <span>{board.unit}</span>
                </h3>

                {board.entries.map(
                  ({ player, value }, index) => (
                    <a
                      class="home-player"
                      href={`/players/${player.id}`}
                    >
                      <span class="player-position">
                        {index + 1}
                      </span>

                      <Thumbnail
                        src={
                          player.data.avatar ||
                          (player.data.uid
                            ? `/players/${player.data.uid}.webp`
                            : '/players/default.webp')
                        }
                        fallback="/players/default.webp"
                        width={42}
                        height="48"
                        alt=""
                        loading="lazy"
                      />

                      <span class="player-identity">
                        <strong>
                          {player.data.ign}
                        </strong>

                        <small>
                          {teamName(player.data.team)}
                        </small>
                      </span>

                      <span class="player-value">
                        {value}
                      </span>
                    </a>
                  )
                )}

                {!board.entries.length && (
                  <p class="home-empty">
                    No recorded {board.unit.toLowerCase()} yet.
                  </p>
                )}

              </article>
            ))}
          </div>
        </section>

        <section
          class="home-panel latest-section"
          aria-labelledby="latest-title"
        >
          <div class="panel-heading">
            <h2 id="latest-title">
              Latest matches
            </h2>

            <a href="/matches">
              View all
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="home-match-list">
            {recentMatches.map(match => (
              <a
                class="home-match"
                href={`/matches/${match.id}`}
              >
                <time datetime={match.data.date}>
                  {formatDate(match.data.date)}
                </time>

                <div class="match-team">
                  <Thumbnail
                    fallback="/logos/default.webp"
                    src={teamLogo(
                      getMatchTeam1Id(match)
                    )}
                    width={24}
                    height="24"
                    alt=""
                    loading="lazy"
                  />

                  <span>
                    {teamName(
                      getMatchTeam1Id(match)
                    )}
                  </span>

                  <strong
                    class:list={[
                      match.data.score1 >
                        match.data.score2 &&
                        'winning-score'
                    ]}
                  >
                    {match.data.score1}
                  </strong>
                </div>

                <div class="match-team">
                  <Thumbnail
                    fallback="/logos/default.webp"
                    src={teamLogo(
                      getMatchTeam2Id(match)
                    )}
                    width={24}
                    height="24"
                    alt=""
                    loading="lazy"
                  />

                  <span>
                    {teamName(
                      getMatchTeam2Id(match)
                    )}
                  </span>

                  <strong
                    class:list={[
                      match.data.score2 >
                        match.data.score1 &&
                        'winning-score'
                    ]}
                  >
                    {match.data.score2}
                  </strong>
                </div>
              </a>
            ))}
          </div>

          {!recentMatches.length && (
            <p class="home-empty">
              Completed matches will appear here.
            </p>
          )}
        </section>

      </div>

      <!-- NEXT MATCH -->
      <section
        class="home-panel next-match"
        aria-labelledby="next-title"
      >
        <h2 id="next-title">
          Next match
        </h2>

        <div>
          {nextMatch ? (
            <>
              <p>
                {teamName(getMatchTeam1Id(nextMatch))}

                <span class="versus">
                  vs
                </span>

                {teamName(getMatchTeam2Id(nextMatch))}
              </p>

              <time datetime={nextMatch.data.date}>
                {formatDate(nextMatch.data.date)}
              </time>
            </>
          ) : (
            <>
              <p>
                No upcoming match at the moment.
              </p>

              <span>
                Stay tuned for the next matchup.
              </span>
            </>
          )}
        </div>

        <a
          href={
            nextMatch
              ? `/matches/${nextMatch.id}`
              : '/veto'
          }
        >
          {nextMatch
            ? 'Match details'
            : 'Plan a scrim'}

          <span aria-hidden="true">→</span>
        </a>
      </section>

      {latestTournament && (
        <p class="home-record-note">
          Latest recorded tournament:
          {' '}
          <a
            href={`/tournament/${latestTournament.id}`}
          >
            {latestTournament.data.name}
          </a>

          <span>
            {completedMatches.length} completed matches
            {' · '}
            {calculated.totals.kills.toLocaleString('en-US')}
            {' '}recorded kills
          </span>
        </p>
      )}

    </main>

  </div>
</Layout>
