<script is:inline>
  (() => {
    function drawConnectors() {
      document.querySelectorAll('.bracket-wrapper').forEach(wrapper => {
        const grid = wrapper.querySelector('.bracket-grid');
        const svg = wrapper.querySelector('.bracket-connectors');
        if (!grid || !svg) return;
        const nodes = new Map(Array.from(grid.querySelectorAll('[data-node]')).map(node => [node.dataset.node, node]));
        svg.replaceChildren();
        const bounds = wrapper.getBoundingClientRect();
        const svgTop = bounds.top + 20;
        svg.setAttribute('viewBox', `0 0 ${bounds.width} ${Math.max(1, bounds.height - 20)}`);
        const makePath = (d, dashed = false) => {
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', d);
          path.setAttribute('stroke', '#3a4258');
          path.setAttribute('stroke-width', '2');
          path.setAttribute('fill', 'none');
          path.setAttribute('vector-effect', 'non-scaling-stroke');
          if (dashed) path.setAttribute('stroke-dasharray', '5 5');
          svg.appendChild(path);
        };
        nodes.forEach(target => {
          const source1 = nodes.get(target.dataset.source1);
          const source2 = nodes.get(target.dataset.source2);
          if (!source1 && !source2) return;
          const targetRect = target.getBoundingClientRect();
          const x2 = targetRect.left - bounds.left;
          const y2 = targetRect.top + targetRect.height / 2 - svgTop;
          const drawOne = (source, kind) => {
            if (!source) return;
            const from = source.getBoundingClientRect();
            const x1 = from.right - bounds.left;
            const y1 = from.top + from.height / 2 - svgTop;
            const middle = (x1 + x2) / 2;
            makePath(`M ${x1} ${y1} H ${middle} V ${y2} H ${x2}`, kind === 'loser');
          };
          drawOne(source1, target.dataset.sourceKind1);
          drawOne(source2, target.dataset.sourceKind2);
        });
      });
    }
    const scheduleDraw = () => requestAnimationFrame(() => requestAnimationFrame(drawConnectors));
    document.addEventListener('DOMContentLoaded', scheduleDraw);
    if (document.fonts?.ready) document.fonts.ready.then(scheduleDraw);
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(scheduleDraw, 100);
    });
  })();
</script>

