---
import { getFrontendMatches } from '../../data-access/frontend-matches';
import { getFrontendTeams, getFrontendTournaments } from '../../data-access/frontend-bracket';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { calculateStatistics } from '../../utils/statistics';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getParticipantLabel, getSourceNode, resolveSourceTeam, validateTournament } from '../../utils/tournament';

const tournament = (await getFrontendTournaments()).find(entry => entry.id === Astro.params.id);
if (!tournament) return new Response(null, { status: 404 });
const tournamentName = tournament.data.name;
const matches = await getFrontendMatches();
const teamsMap = new Map((await getFrontendTeams()).map(t => [t.id, t]));
validateTournament(tournament, matches, new Set(teamsMap.keys()), { allowPendingDetails: !['clash-for-glory-s1','clash-for-glory-s2'].includes(tournament.id) });
const tMatches = matches.filter(m => m.data.tournamentId === tournament.id);
const totalKills = calculateStatistics(tMatches).totals.kills;
const winner = tournament.data.winner ? teamsMap.get(tournament.data.winner) : undefined;
const season = tournamentName.match(/\bS\d+\b/i)?.[0].toUpperCase();
const month = new Date(tournament.data.startDate).toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' });
const dateRange = [tournament.data.startDate, tournament.data.endDate].map(date =>
  new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
).join(' – ');
type Stage = CollectionEntry<'tournaments'>['data']['stages'][number];
function getEntries(stage: Stage, roundId: string) {
  return [
    ...tMatches.filter(m => m.data.stageId === stage.id && m.data.roundId === roundId)
      .map(match => ({ kind: 'match' as const, slot: match.data.bracketSlot, match })),
    ...stage.byes.filter(b => b.roundId === roundId)
      .map(bye => ({ kind: 'bye' as const, slot: bye.slot, bye })),
  ].sort((a, b) => a.slot - b.slot);
}
function formatDate(value: string) {
  return new Date(value).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function bracketRow(slot: number, roundIndex: number) {
  return (2 * slot - 1) * (2 ** roundIndex);
}
---

<Layout title={`CFL Esports ID - ${tournamentName}`} current="Tournaments" canonicalPath={`/tournament/${tournament.id}`}>
  <div class="container tournament-detail">
    <a class="back-to-tournaments" href="/tournament"><span aria-hidden="true">←</span> All tournaments</a>
    <section class="tournament-hero">
      <div class="tournament-hero-top">
        <span class="tournament-kicker">
          {[season, month].filter(Boolean).join(' · ')}
        </span>

        <span class:list={[
          'tournament-status',
          tournament.data.winner ? 'completed' : 'ongoing'
        ]}>
          {tournament.data.winner ? 'Completed' : 'Ongoing'}
        </span>
      </div>

      <div class="tournament-hero-main">
        <h1>
          {tournamentName.includes(':') ? (
            <>
              {tournamentName.slice(0, tournamentName.indexOf(':') + 1)}
              <br />
              <span>
                {tournamentName.slice(tournamentName.indexOf(':') + 1).trim()}
              </span>
            </>
          ) : (
            tournamentName
          )}
        </h1>

        <p class="tournament-date">{dateRange}</p>
      </div>

      <div class="tournament-metrics">
        <div class="tournament-metric teams-metric">
          <strong>{tournament.data.teams.length}</strong>
          <span>Teams</span>
        </div>

        <div class="tournament-metric kills-metric">
          <strong>{totalKills.toLocaleString('en-US')}</strong>
          <span>Total Kills</span>
        </div>

        <div class="tournament-metric winner-metric">
          {winner ? (
            <a href={`/teams/${winner.id}`}>
              <strong class="winner-name">
                <img class="winner-medal" src="/icons/gold-medal.webp" alt="" width="22" height="22" />
                <span class="winner-team-name">{winner.data.name}</span>
              </strong>
            </a>
          ) : (
            <strong>TBD</strong>
          )}
          <span>Winner</span>
        </div>
      </div>
    </section>
    {tournament.data.stages.map(stage => {
      const rounds = stage.rounds.filter(r => r.placement !== 3).sort((a, b) => a.order - b.order);
      const placementRounds = stage.rounds.filter(r => r.placement === 3).sort((a, b) => a.order - b.order);
      const firstRoundEntries = rounds[0] ? getEntries(stage, rounds[0].id) : [];
      const rowCount = Math.max(2, firstRoundEntries.length * 2);
      return (
        <section class="tournament-stage">
          <h2>{stage.name}</h2>
          <p class="series-format">All {stage.series.mapCount} maps played per match</p>
          <p class="bracket-scroll-hint">Swipe to view the full bracket →</p>
          <div class="bracket-scroll">
            <div class="bracket-wrapper" style={`--round-count:${rounds.length};--bracket-rows:${rowCount};`}>
              <div class="bracket-grid">
                {rounds.map((round, roundIndex) => {
                  const entries = getEntries(stage, round.id);
                  const dates = [...new Set(tMatches.filter(m => m.data.stageId === stage.id && m.data.roundId === round.id).map(m => m.data.date))];
                  return (
                    <div class="bracket-round-header" style={`grid-column:${roundIndex + 1};grid-row:1;--mobile-order:${roundIndex * 100};`}>
                      <div class="bracket-round-title">{round.name}</div>
                      {dates.length > 0 && <div class="bracket-round-date">{dates.map(formatDate).join(' & ')}</div>}
                    </div>
                  );
                })}
                {rounds.flatMap((round, roundIndex) =>
                  getEntries(stage, round.id).map(entry => {
                    const gridRow = 2 + bracketRow(entry.slot, roundIndex);
                    if (entry.kind === 'bye') {
                      const team = teamsMap.get(entry.bye.teamId);
                      return (
                        <div
                          class="bracket-match bye"
                          data-node={`${stage.id}:${entry.bye.id}`}
                          data-round-index={roundIndex}
                          data-slot={entry.slot}
                          style={`grid-column:${roundIndex + 1};grid-row:${gridRow};order:${roundIndex * 100 + entry.slot};`}
                        >
                          <div class="bracket-team-row winner" style={`--team-color:${team?.data.color || '#777B82'};`}>
                            <div class="bracket-team-info">
                              {team && (
                                <img
                                  class="bracket-team-logo"
                                  src={team.data.logo || `/logos/${team.data.tag}.webp`}
                                  alt={`${team.data.name} logo`}
                                  loading="lazy"
                                  onerror="this.onerror=null;this.src='/logos/default.webp'"
                                />
                              )}
                              <span class="bracket-team-name">{team?.data.name ?? entry.bye.teamId}</span>
                            </div>
                            <span class="bracket-bye-label">BYE</span>
                          </div>
                          <div class="bracket-team-row empty"><span class="bracket-team-name">No opponent</span></div>
                        </div>
                      );
                    }
                    const m = entry.match;
                    const complete = m.data.status === 'completed';
                    const team1Id = m.data.team1Id ?? resolveSourceTeam(m, 1, tournament, tMatches);
                    const team2Id = m.data.team2Id ?? resolveSourceTeam(m, 2, tournament, tMatches);
                    const team1 = team1Id ? teamsMap.get(team1Id) : undefined;
                    const team2 = team2Id ? teamsMap.get(team2Id) : undefined;
                    const win1 = complete && Boolean(m.data.winnerId) && m.data.winnerId === team1Id;
                    const win2 = complete && Boolean(m.data.winnerId) && m.data.winnerId === team2Id;
                    return (
                      <a
                        href={`/matches/${m.id}`}
                        class={`bracket-match ${complete ? '' : 'upcoming'}`}
                        data-node={m.id}
                        data-round-index={roundIndex}
                        data-slot={entry.slot}
                        data-source1={getSourceNode(m, 1)}
                        data-source2={getSourceNode(m, 2)}
                        data-source-kind1={m.data.team1Source?.type}
                        data-source-kind2={m.data.team2Source?.type}
                        style={`grid-column:${roundIndex + 1};grid-row:${gridRow};order:${roundIndex * 100 + entry.slot};`}
                      >
                        <div class={`bracket-team-row ${win1 ? 'winner' : win2 ? 'loser' : ''}`} style={`--team-color:${team1?.data.color || '#777B82'};`}>
                          <div class="bracket-team-info">
                            {team1 && (
                              <img
                                class="bracket-team-logo"
                                src={team1.data.logo || `/logos/${team1.data.tag}.webp`}
                                alt={`${team1.data.name} logo`}
                                loading="lazy"
                                onerror="this.onerror=null;this.src='/logos/default.webp'"
                              />
                            )}
                            <span class="bracket-team-name">{team1?.data.name ?? team1Id ?? getParticipantLabel(m, 1)}</span>
                          </div>
                          <span class="bracket-team-score">{complete || m.data.status === 'live' ? m.data.score1 : '–'}</span>
                        </div>
                        <div class={`bracket-team-row ${win2 ? 'winner' : win1 ? 'loser' : ''}`} style={`--team-color:${team2?.data.color || '#777B82'};`}>
                          <div class="bracket-team-info">
                            {team2 && (
                              <img
                                class="bracket-team-logo"
                                src={team2.data.logo || `/logos/${team2.data.tag}.webp`}
                                alt={`${team2.data.name} logo`}
                                loading="lazy"
                                onerror="this.onerror=null;this.src='/logos/default.webp'"
                              />
                            )}
                            <span class="bracket-team-name">{team2?.data.name ?? team2Id ?? getParticipantLabel(m, 2)}</span>
                          </div>
                          <span class="bracket-team-score">{complete || m.data.status === 'live' ? m.data.score2 : '–'}</span>
                        </div>
                      </a>
                    );
                  })
                )}
              </div>
              <svg class="bracket-connectors" aria-hidden="true"></svg>
              {placementRounds.map(section => {
                const entries = getEntries(stage, section.id);
                const dates = [...new Set(tMatches.filter(m => m.data.stageId === stage.id && m.data.roundId === section.id).map(m => m.data.date))];
                return (
                  <div class="bracket-bronze" style={`--bronze-col:${rounds.length};--final-slot-offset:${2 ** (rounds.length - 1)};`}>
                    <div class="bracket-round-header">
                      <div class="bracket-round-title">{section.name}</div>
                      {dates.length > 0 && <div class="bracket-round-date">{dates.map(formatDate).join(' & ')}</div>}
                    </div>
                    <div class="bracket-bronze-matches">
                      {entries.map(entry => {
                        if (entry.kind === 'bye') return null;
                        const m = entry.match;
                        const complete = m.data.status === 'completed';
                        const team1Id = m.data.team1Id ?? resolveSourceTeam(m, 1, tournament, tMatches);
                        const team2Id = m.data.team2Id ?? resolveSourceTeam(m, 2, tournament, tMatches);
                        const team1 = team1Id ? teamsMap.get(team1Id) : undefined;
                        const team2 = team2Id ? teamsMap.get(team2Id) : undefined;
                        const win1 = complete && m.data.winnerId === team1Id;
                        const win2 = complete && m.data.winnerId === team2Id;
                        return (
                          <a href={`/matches/${m.id}`} class={`bracket-match ${complete ? '' : 'upcoming'}`}>
                            <div class={`bracket-team-row ${win1 ? 'winner' : win2 ? 'loser' : ''}`} style={`--team-color:${team1?.data.color || '#777B82'};`}>
                              <div class="bracket-team-info">
                                {team1 && (
                                  <img
                                    class="bracket-team-logo"
                                    src={team1.data.logo || `/logos/${team1.data.tag}.webp`}
                                    alt={`${team1.data.name} logo`}
                                    loading="lazy"
                                    onerror="this.onerror=null;this.src='/logos/default.webp'"
                                  />
                                )}
                                <span class="bracket-team-name">{team1?.data.name ?? team1Id ?? getParticipantLabel(m, 1)}</span>
                              </div>
                              <span class="bracket-team-score">{complete || m.data.status === 'live' ? m.data.score1 : '–'}</span>
                            </div>

                            <div class={`bracket-team-row ${win2 ? 'winner' : win1 ? 'loser' : ''}`} style={`--team-color:${team2?.data.color || '#777B82'};`}>
                              <div class="bracket-team-info">
                                {team2 && (
                                  <img
                                    class="bracket-team-logo"
                                    src={team2.data.logo || `/logos/${team2.data.tag}.webp`}
                                    alt={`${team2.data.name} logo`}
                                    loading="lazy"
                                    onerror="this.onerror=null;this.src='/logos/default.webp'"
                                  />
                                )}
                                <span class="bracket-team-name">{team2?.data.name ?? team2Id ?? getParticipantLabel(m, 2)}</span>
                              </div>
                              <span class="bracket-team-score">{complete || m.data.status === 'live' ? m.data.score2 : '–'}</span>
                            </div>
                          </a>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
  .tournament-hero {
    position: relative;
    overflow: hidden;
    margin-top: 20px;
    margin-bottom: 36px;
    padding: 28px 32px 0;
    background:
      radial-gradient(
        circle at 85% 15%,
        rgba(255, 116, 46, .12),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        rgba(255, 116, 46, .035),
        transparent 45%
      ),
      var(--bg-secondary);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 10px;
  }

  .tournament-hero::after {
    content: "";
    position: absolute;
    top: -80px;
    right: -40px;
    width: 280px;
    height: 280px;
    border: 1px solid rgba(255, 116, 46, .07);
    border-radius: 50%;
    pointer-events: none;
  }

  .tournament-hero-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .tournament-kicker {
    color: var(--accent);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .tournament-status {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 0 10px;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, .04);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .tournament-status.completed {
    color: #22c55e;
    background: rgba(34, 197, 94, .08);
    border-color: rgba(34, 197, 94, .32);
  }

  .status-ongoing {
    color: var(--accent);
    background: rgba(255, 116, 46, .08);
    border-color: rgba(255, 116, 46, .30);
  }

  .status-upcoming {
    color: #e7bf59;
    background: rgba(231, 191, 89, .08);
    border-color: rgba(231, 191, 89, .30);
  }

  .tournament-hero-main {
    position: relative;
    z-index: 1;
    padding: 38px 0 42px;
  }

  .tournament-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(36px, 5vw, 58px);
    line-height: .98;
    font-weight: 800;
    letter-spacing: -.045em;
  }

  .tournament-hero h1 span {
    color: var(--text-secondary);
  }

  .tournament-date {
    margin: 18px 0 0;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 600;
  }

  .tournament-metrics {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: .7fr .9fr 1.4fr;
    margin: 0 -32px;
    border-top: 1px solid var(--border);
  }

  .tournament-metric {
    min-width: 0;
    padding: 18px 32px 20px;
  }

  .teams-metric strong {
    color: var(--accent);
  }

  .kills-metric strong {
    color: #fff;
  }

  .winner-metric .winner-name {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #e7bf59;
  }

  .winner-crown {
    display: inline-block;
    font-size: 15px;
    line-height: 1;
  }

  .winner-team-name {
    display: inline-block;
    line-height: 1;
  }
  .tournament-metric + .tournament-metric {
    border-left: 1px solid var(--border);
  }

  .tournament-metric strong {
    display: block;
    overflow: hidden;
    color: var(--text-primary);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tournament-metric > span {
    display: block;
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .winner-metric a {
    color: inherit;
    text-decoration: none;
  }

  winner-metric a:hover .winner-name {
    color: #f2cf72;
  }

  .tournament-stage { margin-bottom: 40px; }
  .tournament-stage > h2 {
    margin: 0;
    font-size: 26px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -.025em;
  }
  .series-format { 
    color: var(--text-muted); 
    margin: 8px 0 18px;
    font-size: 14px;
  }

  .bracket-empty {
    margin: 0;
    padding: 18px;
    color: var(--text-muted);
    font-size: 12px;
    text-align: center;
  }

  .bracket-main-section { 
    display: flex; 
    flex-direction: column; 
    flex: 1; 
  }
  .bracket-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .back-link {
    color: var(--text-secondary);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }
  
  .teams-metric strong {
  color: var(--accent);
  }

  .kills-metric strong {
    color: #fff;
  }

  .winner-metric .winner-name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #e7bf59;
  }

  .winner-crown {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-size: 15px;
    line-height: 1;
    transform: translateY(-1px);
  }

  #tourney-select {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  #tourney-select:focus { outline: none; border-color: var(--accent); }

  .bracket-scroll { 
    overflow-x: visible;
    padding: 8px 20px 28px;
    background:
      linear-gradient(
        180deg,
        rgba(255, 116, 46, .018),
        transparent 160px
      ),
      var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 10px;
    scrollbar-width: none;
  }
  .bracket-scroll::-webkit-scrollbar { display:none; }

  .bracket-scroll-hint {
    display: none;
  }

  .bracket-wrapper {
    position:relative;
    width:100%;
    min-width:0;
    padding:20px 0 8px;
  }
  .bracket-grid {
    position:relative;
    z-index:1;
    display:grid;
    grid-template-columns:repeat(var(--round-count),minmax(0,1fr));
    grid-template-rows:64px repeat(var(--bracket-rows),58px);
    column-gap:36px;
    width:100%;
  }
  .bracket-grid > .bracket-round-header { align-self:start; }
  .bracket-round-header { margin-bottom:16px; }
  .bracket-round-title {
    padding-bottom:11px;
    color:var(--accent);
    border-bottom:1px solid rgba(255,116,46,.35);
    font-size:12px;
    font-weight:800;
    letter-spacing:.06em;
    text-align:center;
    text-transform:uppercase;
  }
  .bracket-round-date { margin-top:9px;color:var(--text-muted);font-size:11px;font-weight:500;text-align:center; }
  .bracket-match {
    position:relative;
    display:block;
    align-self:center;
    overflow:hidden;
    color:inherit;
    background:var(--bg-card);
    border:1px solid var(--border);
    border-radius:7px;
    text-decoration:none;
    transition:border-color .18s,background-color .18s;
  }
  .bracket-match:hover { background:var(--bg-card-hover);border-color:rgba(255,116,46,.45); }
  .bracket-match.upcoming { border-style:dashed; }
  .bracket-match.bye { opacity:.72;border-style:dashed;pointer-events:none; }
  .bracket-team-row {
    position:relative;
    display:flex;
    align-items:center;
    justify-content:space-between;
    min-height:42px;
    padding:8px 11px 8px 14px;
    font-size:13px;
  }
  .bracket-team-row::before {
    content:'';
    position:absolute;
    top:0;
    bottom:0;
    left:0;
    width:3px;
    background:var(--team-color,transparent);
  }
  .bracket-team-row + .bracket-team-row { border-top:1px solid var(--border); }
  .bracket-team-row.winner { background:rgba(231,191,89,.07); }
  .bracket-team-row.loser { opacity:.48; }
  .bracket-team-row.empty { opacity:.4; }
  .bracket-team-info { display:flex;flex:1;min-width:0;align-items:center;gap:9px; }
  .bracket-team-logo {
    display:block;
    flex:0 0 28px;
    width:28px;
    height:28px;
    object-fit:contain;
  }
  .bracket-team-row.winner .bracket-team-name { color:var(--text-primary); }
  .bracket-team-name { overflow:hidden;color:var(--text-secondary);font-size:12px;font-weight:650;text-overflow:ellipsis;white-space:nowrap; }
  .bracket-team-score { min-width:22px;margin-left:8px;color:var(--text-secondary);font-size:14px;font-weight:800;text-align:right;font-variant-numeric:tabular-nums; }
  .bracket-team-row.winner .bracket-team-score { color:#e7bf59; }
  .bracket-team-row.loser .bracket-team-score { color:var(--text-muted); }
  .bracket-bye-label { flex-shrink:0;padding:3px 6px;color:var(--text-muted);background:rgba(255,255,255,.04);border-radius:4px;font-size:9px;font-weight:800;letter-spacing:.05em; }
  .bracket-connectors { position:absolute;top:20px;left:0;width:100%;height:calc(100% - 20px);pointer-events:none;z-index:0;overflow:visible; }
  .bracket-bronze {
    position:absolute;
    z-index:2;
    right:0;
    left:auto;
    top:calc(20px + 64px + var(--final-slot-offset) * 58px + 260px);
    width:calc((100% - 108px) / var(--bronze-col));
    margin:0;
  }
  .bracket-bronze-matches { display:flex;flex-direction:column;gap:12px;margin-top:18px; }
