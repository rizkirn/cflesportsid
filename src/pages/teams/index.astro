---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateStatistics, emptyStats } from '../../utils/statistics';

const allMatches = await getCollection('matches');
const calculated = calculateStatistics(allMatches);

const teams = (await getCollection('teams')).map(team => {
  const record = calculated.teams.get(team.id) ?? emptyStats();

  return {
    id: team.id,
    name: team.data.name,
    tag: team.data.tag,
    logo: team.data.logo,
    region: team.data.region,

    // Optional team identity color.
    // Teams without one remain neutral.
    color: team.data.color ?? '#777B82',

    wins: record.wins,
    losses: record.losses,
    totalKills: record.kills,
  };
});

const teamCount = teams.length;
---

<Layout
  title="Teams - CFL Esports Indonesia"
  current="Teams"
>
  <section class="teams-page" aria-labelledby="teams-title">
    <div class="container">

      <!-- =========================
           PAGE HEADER
           ========================= -->

      <header class="page-header teams-header">
        <h1 id="teams-title">The teams</h1>

        <p>
          {teamCount} teams competing in Clash for Glory: Road to All-Star.
        </p>
        <a class="teams-standings-link" href="/#standings">Overall standings <span aria-hidden="true">↗</span></a>
      </header>


      <!-- =========================
           SEARCH / SORT
           ========================= -->

      <div class="teams-toolbar">

        <div class="teams-search-wrap">

          <svg
            class="teams-search-icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="6.5"
              stroke="currentColor"
              stroke-width="1.8"
            />

            <path
              d="M16 16L21 21"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>

          <input
            type="text"
            id="searchInput"
            aria-label="Search teams"
            placeholder="Search team name or tag..."
            class="teams-search"
          />

        </div>


        <select
          id="sortSelect"
          aria-label="Sort teams"
          class="teams-sort"
        >
          <option value="name-asc">
            Name (A–Z)
          </option>

          <option value="name-desc">
            Name (Z–A)
          </option>

          <option value="wins-desc">
            Wins (High–Low)
          </option>

          <option value="wins-asc">
            Wins (Low–High)
          </option>

          <option value="losses-desc">
            Losses (High–Low)
          </option>

          <option value="losses-asc">
            Losses (Low–High)
          </option>

          <option value="kills-desc">
            Kills (High–Low)
          </option>

          <option value="kills-asc">
            Kills (Low–High)
          </option>
        </select>

      </div>


      <!-- =========================
           TEAM GRID
           ========================= -->

      <div
        class="teams-grid"
        id="teamsGrid"
      >

        {teams.map(team => {
          const region =
            team.region === 'ID'
              ? 'Indonesia'
              : team.region;

          return (

            <a
              class="team-card"
              href={`/teams/${team.id}`}
              aria-label={`View ${team.name} team information`}
              style={`--team-color: ${team.color};`}
              data-name={team.name.toLowerCase()}
              data-tag={team.tag.toLowerCase()}
              data-wins={team.wins}
              data-losses={team.losses}
              data-kills={team.totalKills}
            >

              <!-- =========================
                   CARD CONTENT
                   ========================= -->

              <div class="team-card-body">

                <!-- LOGO + NAME -->

                <div class="club-identity">

                  <div class="club-logo">

                    <img
                      src={
                        team.logo ||
                        `/logos/${team.tag}.webp`
                      }
                      alt={`${team.name} logo`}
                      width="56"
                      height="56"
                      loading="lazy"
                      onerror="this.onerror=null; this.src='/logos/default.webp'"
                    />

                  </div>

                  <h2>
                    {team.name}
                  </h2>

                </div>


                <!-- TAG + LOCATION -->

                <div class="club-meta">

                  <strong class="club-tag">
                    {team.tag}
                  </strong>


                  <span class="club-location">

                    <svg
                      class="location-icon"
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M12 21s7-6.2 7-12A7 7 0 1 0 5 9c0 5.8 7 12 7 12Z"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />

                      <circle
                        cx="12"
                        cy="9"
                        r="2.4"
                        stroke="currentColor"
                        stroke-width="1.7"
                      />
                    </svg>

                    <span>
                      {region}
                    </span>

                  </span>

                </div>

              </div>


              <dl class="team-record" aria-label={`${team.name} recorded results`}>
                <div><dt>Wins</dt><dd>{team.wins}</dd></div>
                <div><dt>Losses</dt><dd>{team.losses}</dd></div>
                <div><dt>Kills</dt><dd>{team.totalKills.toLocaleString('en-US')}</dd></div>
              </dl>

              <div
                class="club-info"
              >

                <span>
                  Team info
                </span>

                <span
                  class="club-info-arrow"
                  aria-hidden="true"
                >
                  →
                </span>

              </div>

            </a>

          );
        })}

      </div>


      <!-- EMPTY SEARCH STATE -->

      <p
        id="noResults"
        class="no-results"
        role="status"
      >
        No teams found.
      </p>

    </div>
  </section>


  <!-- =========================
       SEARCH / SORT
       ========================= -->

  <script>

    const searchInput =
      document.getElementById(
        'searchInput'
      ) as HTMLInputElement;

    const sortSelect =
      document.getElementById(
        'sortSelect'
      ) as HTMLSelectElement;

    const grid =
      document.getElementById(
        'teamsGrid'
      ) as HTMLElement;

    const noResults =
      document.getElementById(
        'noResults'
      ) as HTMLElement;

    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>(
        '.team-card'
      )
    );


    function render() {

      const search =
        searchInput.value
          .trim()
          .toLowerCase();


      const [key, dir] =
        sortSelect.value.split('-');


      const isNumeric =
        [
          'wins',
          'losses',
          'kills'
        ].includes(key);


      const ascending =
        dir === 'asc';


      /* FILTER */

      const visible =
        cards.filter(card => {

          const name =
            card.dataset.name || '';

          const tag =
            card.dataset.tag || '';

          return (
            !search ||
            name.includes(search) ||
            tag.includes(search)
          );

        });


      /* SORT */

      visible.sort((a, b) => {

        if (isNumeric) {

          const valA =
            Number(
              a.dataset[key] || 0
            );

          const valB =
            Number(
              b.dataset[key] || 0
            );

          return ascending
            ? valA - valB
            : valB - valA;

        }


        const valA =
          a.dataset[key] || '';

        const valB =
          b.dataset[key] || '';


        return ascending
          ? valA.localeCompare(valB)
          : valB.localeCompare(valA);

      });


      /* HIDE ALL */

      cards.forEach(card => {
        card.style.display = 'none';
      });


      /* SHOW FILTERED / SORTED */

      visible.forEach(card => {

        card.style.display = '';

        grid.appendChild(card);

      });


      /* EMPTY STATE */

      noResults.style.display =
        visible.length === 0
          ? 'block'
          : 'none';

    }


    searchInput.addEventListener(
      'input',
      render
    );


    sortSelect.addEventListener(
      'change',
      render
    );


    render();

  </script>

</Layout>


<style>

  /* ========================================
     TEAMS PAGE
     ======================================== */

  .teams-page {
    padding-bottom: 4rem;
  }


  /* ========================================
     HEADER
     ======================================== */

  .teams-header {
    margin-bottom: 1.5rem;
  }


  .teams-header h1 {
    margin: 0;

    color: var(--text-primary);

    font-size: clamp(
      2rem,
      4vw,
      3rem
    );

    line-height: 1;
  }


  .teams-header p {
    max-width: 650px;

    margin:
      0.8rem
      0
      0;

    color: var(--text-secondary);

    font-size: 0.95rem;

    line-height: 1.55;
  }


  /* ========================================
     TOOLBAR
     ======================================== */

  .teams-toolbar {
    display: flex;

    gap: 0.75rem;

    margin-bottom: 1.25rem;
  }


  .teams-search-wrap {
    position: relative;

    flex: 1;

    min-width: 0;
  }


  .teams-search-icon {
    position: absolute;

    top: 50%;
    left: 0.9rem;

    transform:
      translateY(-50%);

    color: var(--text-muted);

    pointer-events: none;
  }


  .teams-search,
  .teams-sort {
    min-height: 46px;

    background: #151619;

    border:
      1px
      solid
      #303136;

    border-radius: 0;

    color: var(--text-primary);

    font: inherit;

    font-size: 0.86rem;

    transition:
      border-color
      150ms ease;
  }


  .teams-search {
    width: 100%;

    padding:
      0.7rem
      0.9rem
      0.7rem
      2.7rem;
  }


  .teams-search::placeholder {
    color: var(--text-muted);
  }


  .teams-sort {
    width: 190px;

    padding:
      0.7rem
      0.85rem;

    cursor: pointer;
  }


  .teams-search:hover,
  .teams-sort:hover {
    border-color: #44454b;
  }


  .teams-search:focus,
  .teams-sort:focus {
    outline: none;

    border-color:
      var(--accent);
  }


  /* ========================================
     GRID
     ======================================== */

  .teams-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 1rem;
  }


  /* ========================================
     TEAM CARD
     ======================================== */

  .team-card {
    --team-color: #777B82;
    color: var(--text-primary);
    text-decoration: none;

    position: relative;

    display: flex;

    flex-direction: column;

    min-width: 0;

    overflow: hidden;

    background: #151619;

    border:
      1px
      solid
      #303136;

    border-radius: 0;

    padding: 0 !important;

    margin: 0;

    box-shadow: none;

    isolation: isolate;

    transition:
      border-color
      150ms ease;
  }


  /* The SVG mask carries team identity; interface accents remain CFL orange. */

  .team-card::before {
    content: '';

    position: absolute;
    inset: 0;
    z-index: 0;

    background: var(--team-color);
    -webkit-mask: url('/patterns/team-card.svg') center / 100% 100% no-repeat;
    mask: url('/patterns/team-card.svg') center / 100% 100% no-repeat;
    opacity: 0.32;

    pointer-events: none;
  }

  .team-card::after {
    display: none;
  }


  /* ========================================
     CARD BODY
     ======================================== */

  .team-card-body {
    position: relative;

    z-index: 2;

    display: flex;

    flex-direction: column;

    min-height: 180px;

    padding:
      1.4rem
      1.2rem
      1.1rem !important;

    margin: 0 !important;
  }


  /* ========================================
     LOGO + NAME
     ======================================== */

  .club-identity {
    display: flex;

    align-items: center;

    gap: 0.8rem;

    min-width: 0;

    margin: 0;

    padding: 0;
  }


  .club-logo {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 56px;
    height: 56px;

    flex:
      0
      0
      56px;
  }


  .club-logo img {
    display: block;

    width: 56px;
    height: 56px;

    object-fit: contain;
  }


  .club-identity h2 {
    min-width: 0;

    margin: 0;

    padding: 0;

    color:
      var(--text-primary);

    font-size: 1.05rem;

    font-weight: 700;

    line-height: 1.2;
  }


  /* ========================================
     TAG + LOCATION
     ======================================== */

  .club-meta {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 1rem;

    width: 100%;

    margin:
      auto
      0
      0 !important;

    padding:
      1.2rem
      0
      0 !important;

    background: none !important;

    border: 0 !important;

    color:
      var(--text-muted);

    font-size: 0.78rem;
  }


  .club-tag {
    margin: 0;

    padding: 0;

    background: none;

    border: 0;

    color:
      var(--text-secondary);

    font-size: 0.76rem;

    font-weight: 700;

    letter-spacing: 0.025em;
  }


  .club-location {
    display: inline-flex;

    align-items: center;

    gap: 0.4rem;

    margin: 0 !important;

    padding: 0 !important;

    background:
      transparent !important;

    border:
      0 !important;

    outline: 0 !important;

    border-radius:
      0 !important;

    box-shadow:
      none !important;

    color:
      var(--text-muted);

    font-size: 0.78rem;

    font-weight: 400;

    text-transform: none;

    letter-spacing: normal;

    white-space: nowrap;
  }


  .club-location span {
    margin: 0 !important;

    padding: 0 !important;

    background:
      transparent !important;

    border:
      0 !important;

    outline:
      0 !important;

    border-radius:
      0 !important;

    box-shadow:
      none !important;
  }


  .location-icon {
    display: block;

    width: 13px;
    height: 13px;

    flex:
      0
      0
      13px;

    color:
      var(--text-muted);

    opacity: 0.7;
  }


  /* ========================================
     TEAM INFO FOOTER
     ======================================== */

  .team-card > .club-info {
    position: relative;

    z-index: 3;

    display: flex;

    align-items: center;

    justify-content:
      space-between;

    width:
      100% !important;

    min-height: 48px;

    margin:
      0 !important;

    padding:
      0
      1.2rem !important;

    box-sizing:
      border-box;

    background:
      #101114 !important;

    border:
      0 !important;

    border-top:
      1px
      solid
      #303136 !important;

    border-radius:
      0 !important;

    color:
      var(--accent);

    font-size: 0.78rem;

    font-weight: 700;

    text-decoration: none;

    box-shadow:
      none !important;

    transition:
      background
      150ms ease,
      color
      150ms ease;
  }


  .club-info-arrow {
    display: inline-block;

    font-size: 1rem;

    transition:
      transform
      150ms ease;
  }


  .team-card:is(:hover, :focus-visible) > .club-info {
    background:
      #131417 !important;

    color:
      var(--accent-hover);
  }


  .team-card:is(:hover, :focus-visible)
  .club-info-arrow {
    transform:
      translateX(3px);
  }


  .team-card:focus-visible {
    outline:
      2px
      solid
      var(--accent);

    outline-offset: -2px;
  }


  /* ========================================
     EMPTY STATE
     ======================================== */

  .no-results {
    display: none;

    margin: 0;

    padding:
      3rem
      1rem;

    color:
      var(--text-muted);

    text-align: center;
  }


  /* ========================================
     TABLET
     ======================================== */

  @media (
    max-width: 900px
  ) {

    .teams-grid {
      grid-template-columns:
        repeat(
          2,
          minmax(0, 1fr)
        );
    }

  }


  /* ========================================
     MOBILE
     ======================================== */

  @media (
    max-width: 600px
  ) {

    .teams-page {
      padding-bottom: 3rem;
    }


    .teams-header {
      margin-bottom: 1.1rem;
    }


    .teams-header p {
      font-size: 0.88rem;
    }


    .teams-toolbar {
      flex-direction: column;

      gap: 0.6rem;
    }


    .teams-sort {
      width: 100%;
    }


    .teams-grid {
      grid-template-columns: 1fr;

      gap: 0.8rem;
    }


    .team-card-body {
      min-height: 160px;

      padding:
        1.2rem
        1rem
        1rem !important;
    }


    .club-logo {
      width: 52px;
      height: 52px;

      flex-basis: 52px;
    }


    .club-logo img {
      width: 52px;
      height: 52px;
    }


    .club-identity {
      gap: 0.75rem;
    }


    .club-identity h2 {
      font-size: 1rem;
    }


    .club-meta {
      padding-top:
        1rem !important;
    }


    .team-card > .club-info {
      min-height: 46px;

      padding:
        0
        1rem !important;
    }


  }

  /* Keep the directory aligned with home while retaining each team's identity. */
  :global(body:has(.teams-page)) {
    --bg-primary: #090a0c;
    --bg-secondary: #101114;
    --bg-card: #16171b;
    --border: #303137;
    --text-primary: #f4f3ef;
    --text-secondary: #c4c3bf;
    --text-muted: #a4a6ac;
    --teams-display: 'DIN Condensed', 'Arial Narrow', 'Avenir Next Condensed', sans-serif;
  }
  :global(body:has(.teams-page) .site-header) { background: #0c0d0f; backdrop-filter: none; }
  :global(body:has(.teams-page) .site-header .nav a) { font-family: var(--teams-display); font-size: 17px; font-weight: 500; }
  .teams-page { font-family: 'Arial Narrow', 'Avenir Next Condensed', sans-serif; }
  .teams-page > .container { max-width: 1344px; padding-inline: 32px; }
  .teams-page .teams-header { position: relative; background: none; padding-block: 34px 26px; margin-bottom: 24px; }
  .teams-page .teams-header h1 { font-family: var(--teams-display); font-size: clamp(44px,6vw,68px); text-transform: uppercase; }
  .teams-page .teams-header p { font-size: 17px; max-width: 70%; }
  .teams-standings-link { display: inline-flex; align-items: center; gap: 14px; min-height: 44px; position: absolute; bottom: 24px; right: 0; font-size: 15px; text-transform: uppercase; }
  .teams-page .teams-toolbar { gap: 12px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .teams-page :is(.teams-search,.teams-sort) { border-radius: 0; font-size: 16px; }
  .teams-page :is(.teams-search,.teams-sort):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .teams-page .club-identity h2 { font-family: var(--teams-display); font-size: 29px; font-weight: 700; }
  .teams-page .club-identity { min-height: 64px; }
  .teams-page .team-card-body { min-height: 156px; }
  .team-record { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3,1fr); margin: 0 20px 16px; padding-top: 12px; border-top: 1px solid #ffffff20; }
  .team-record > div { padding-left: 14px; border-left: 1px solid #ffffff18; }
  .team-record > div:first-child { padding-left: 0; border: 0; }
  .team-record dt { color: var(--text-secondary); font-size: 12px; text-transform: uppercase; }
  .team-record dd { font-family: var(--teams-display); font-size: 28px; line-height: 1.25; font-variant-numeric: tabular-nums; }
  .teams-page .club-info { font-family: var(--teams-display); font-size: 19px; text-transform: uppercase; }
  @media(max-width:900px) { .teams-page #teamsGrid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; } }
  @media(max-width:600px) {
    .teams-page > .container { padding-inline: 16px; }
    .teams-page .teams-header { padding-block: 24px 15px; }
    .teams-page .teams-header p { max-width: 100%; font-size: 16px; }
    .teams-standings-link { position: static; margin-top: 10px; }
    .teams-page #teamsGrid { grid-template-columns: minmax(0,1fr); gap: 14px; }
    .teams-page .club-identity h2 { font-size: 28px; }
    .teams-page .team-card-body { min-height: 140px; }
    .team-record { margin-inline: 16px; }
  }
</style>
