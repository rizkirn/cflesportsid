---
import Layout from '../layouts/Layout.astro';
import MapRandomizerTool from '../components/tools/MapRandomizerTool.astro';
import {getOfficialToolContext} from '../data-access/official-tool-context';
export const prerender=false;
const official=await getOfficialToolContext(Astro.request,import.meta.env.DEV,'randomizer');
---
<Layout title="Map Randomizer - CFL Esports ID" current="Map Randomizer"><MapRandomizerTool official={official}/></Layout>
