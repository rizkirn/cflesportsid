---
import Layout from '../layouts/Layout.astro';
import '../styles/bracket-generator.css';
import { getCollection } from 'astro:content';

const maps = (await getCollection('maps'))
  .filter(map => map.data.active)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout title="Map Randomizer - CFL Esports ID" current="Map Randomizer">
  <div
    class="container generator randomizer"
    data-maps={JSON.stringify(maps.map(map => ({
      id: map.id,
      name: map.data.name
    })))}
  >
    <div class="page-header">
      <h1>Map Randomizer</h1>
      <p>Randomize one unique map for each round.</p>
    </div>

    <noscript>Enable JavaScript to randomize maps.</noscript>

    <form id="randomizer-form">
      <h2>1. Match settings</h2>

      <div class="settings-row">
        <div class="round-field">
          <label for="round-count">Rounds per match</label>
          <input
            id="round-count"
            type="number"
            min="1"
            max={maps.length}
            step="1"
            value={Math.min(3, maps.length)}
            required
            aria-describedby="round-help"
          />
        </div>

        <button
          id="initial-draw"
          type="submit"
          class="primary"
          disabled={maps.length === 0}
        >
          Randomize maps
        </button>
      </div>

      <p id="round-help">
        {
          maps.length
            ? `Choose 1–${maps.length} rounds. Maps cannot repeat within a match.`
            : 'No active maps available.'
        }
      </p>
    </form>

    <section class="pool" aria-labelledby="pool-heading">
      <h2 id="pool-heading" tabindex="-1">
        Available maps ({maps.length})
      </h2>

      <ul>
        {maps.map(map => (
          <li data-map-id={map.id}>
            <img
              src={`/maps/${map.id}.webp`}
              alt=""
              width="800"
              height="360"
              loading="lazy"
              onerror="this.onerror=null;this.src='/maps/placeholder.svg'"
            />
            <strong>{map.data.name}</strong>
            <span class="selection-label"></span>
          </li>
        ))}
      </ul>
    </section>

    <section id="draw" aria-labelledby="result-heading" hidden>
      <div class="result-heading">
        <h2 id="result-heading" tabindex="-1">2. Map results</h2>
        <p id="draw-status" role="status"></p>
      </div>

      <ol id="map-results"></ol>

      <div class="generator-actions">
        <button id="copy-results" type="button">
          Copy results
        </button>
        <button id="draw-again" type="button" class="primary">
          Randomize again
        </button>
      </div>

      <p id="copy-status" role="status"></p>

      <textarea
        id="manual-copy"
        aria-label="Map results to copy manually"
        readonly
        hidden
      ></textarea>
    </section>
  </div>
</Layout>

<script>
  import { randomizeMaps } from '../utils/map-randomizer';

  const root = document.querySelector<HTMLElement>('.randomizer')!;
  const maps: { id: string; name: string }[] = JSON.parse(root.dataset.maps!);

  const form = document.querySelector<HTMLFormElement>('#randomizer-form')!;
  const count = document.querySelector<HTMLInputElement>('#round-count')!;
  const draw = document.querySelector<HTMLElement>('#draw')!;
  const results = document.querySelector<HTMLOListElement>('#map-results')!;
  const copyStatus = document.querySelector<HTMLElement>('#copy-status')!;
  const drawStatus = document.querySelector<HTMLElement>('#draw-status')!;
  const manual = document.querySelector<HTMLTextAreaElement>('#manual-copy')!;
  const initialDraw = document.querySelector<HTMLButtonElement>('#initial-draw')!;
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-results')!;
  const pool = document.querySelector<HTMLElement>('.pool')!;

  const cards = [
    ...pool.querySelectorAll<HTMLElement>('[data-map-id]')
  ];

  const buttons = [
    ...root.querySelectorAll<HTMLButtonElement>('button')
  ];

  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  );

  const pause = (ms: number) =>
    new Promise(resolve => window.setTimeout(resolve, ms));

  let drawing = false;
  let generation = 0;
  let copyText = '';
  let copyTimer: ReturnType<typeof setTimeout> | undefined;

  const resetCopy = () => {
    clearTimeout(copyTimer);
    copyButton.textContent = 'Copy results';
  };

  form.addEventListener('submit', async event => {
    event.preventDefault();

    if (drawing || !form.reportValidity()) return;

    const selected = randomizeMaps(maps, count.valueAsNumber);

    generation++;
    drawing = true;

    resetCopy();

    buttons.forEach(button => {
      button.disabled = true;
    });

    count.disabled = true;
    pool.setAttribute('aria-busy', 'true');

    results.replaceChildren();

    copyText = '';
    copyStatus.textContent = '';
    drawStatus.textContent = '';
    manual.hidden = true;
    draw.hidden = true;

    cards.forEach(card => {
      card.classList.remove('is-selected', 'is-highlighted');

      const label = card.querySelector<HTMLElement>('.selection-label');
      if (label) label.textContent = '';
    });

    document
      .querySelector<HTMLElement>('#pool-heading')!
      .focus({ preventScroll: true });

    pool.scrollIntoView({
      behavior: reducedMotion.matches ? 'auto' : 'smooth',
      block: 'start'
    });

    try {
      for (const [index, map] of selected.entries()) {
        const available = cards.filter(
          card => !card.classList.contains('is-selected')
        );

        const winner = available.find(
          card => card.dataset.mapId === map.id
        )!;

        if (!reducedMotion.matches) {
          const stop = available.indexOf(winner);
          const steps = available.length + stop + 1;

          for (let step = 0; step < steps; step++) {
            cards.forEach(card =>
              card.classList.remove('is-highlighted')
            );

            available[step % available.length]
              .classList.add('is-highlighted');

            await pause(
              55 + 120 * Math.pow(step / steps, 3)
            );

            if (reducedMotion.matches) break;
          }
        }

        cards.forEach(card =>
          card.classList.remove('is-highlighted')
        );

        winner.classList.add('is-selected');

        const selectionLabel =
          winner.querySelector<HTMLElement>('.selection-label');

        if (selectionLabel) {
          selectionLabel.textContent = `Round ${index + 1}`;
        }

        const item = document.createElement('li');

        const label = document.createElement('span');
        label.textContent = `Round ${index + 1}`;

        const name = document.createElement('strong');
        name.textContent = map.name;

        item.append(label, name);
        results.append(item);

        if (!reducedMotion.matches) {
          await pause(350);
        }
      }
    } finally {
      drawing = false;

      buttons.forEach(button => {
        button.disabled = false;
      });

      count.disabled = false;
      pool.setAttribute('aria-busy', 'false');

      cards.forEach(card =>
        card.classList.remove('is-highlighted')
      );
    }

    drawStatus.textContent =
      `${selected.length} ${selected.length === 1 ? 'map' : 'maps'} drawn.`;

    copyText = [
      'Map draw',
      ...selected.map(
        (map, index) => `Round ${index + 1}: ${map.name}`
      )
    ].join('\n');

    draw.hidden = false;

    /*
     * Once a result exists, Randomize Again becomes
     * the single randomization action.
     */
    initialDraw.hidden = true;

    document
      .querySelector<HTMLElement>('#result-heading')!
      .focus({ preventScroll: true });
  });

  document
    .querySelector<HTMLButtonElement>('#draw-again')!
    .addEventListener('click', () => {
      form.requestSubmit();
    });

  copyButton.addEventListener('click', async () => {
    const currentGeneration = generation;

    try {
      await navigator.clipboard.writeText(copyText);

      if (currentGeneration !== generation) return;

      resetCopy();

      copyButton.textContent = '✓ COPIED';
      copyStatus.textContent = '';
      manual.hidden = true;

      copyTimer = setTimeout(resetCopy, 1500);
    } catch {
      if (currentGeneration !== generation) return;

      manual.value = copyText;
      manual.hidden = false;
      manual.focus();
      manual.select();

      copyStatus.textContent =
        'Automatic copy is unavailable. Copy the selected text below.';
    }
  });
</script>

<style>
  /* -----------------------------
     Match settings
  ----------------------------- */

  #randomizer-form {
    margin-bottom:28px;
  }

  #randomizer-form h2 {
    margin-bottom:18px;
  }

  .settings-row {
    display:flex;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:12px;
  }

  .round-field {
    display:flex;
    flex-direction:column;
    gap:8px;
  }

  .randomizer #round-count {
    width:120px;
    max-width:100%;
    margin:0;
  }

  #round-help {
    margin:10px 0 0;
    color:var(--text-secondary);
  }

  /* -----------------------------
     Available maps
  ----------------------------- */

  .pool {
    margin:28px 0;
    padding-top:24px;
    border-top:1px solid var(--border);
    scroll-margin-top:88px;
  }

  .pool ul {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:12px;
    list-style:none;
    padding:0;
    margin:16px 0 0;
  }

  .pool li {
    position:relative;
    min-width:0;
    overflow:hidden;
    border:2px solid var(--border);
    background:var(--bg-secondary);
    transition:
      border-color .18s ease,
      box-shadow .18s ease;
  }

  /*
   * Default state:
   * maps intentionally stay dark until selected.
   */
  .pool img {
    display:block;
    width:100%;
    height:auto;
    aspect-ratio:20 / 9;
    object-fit:cover;
    filter:brightness(.42);
    transition:filter .22s ease;
  }

  /*
   * Small gradient keeps the title readable without
   * covering the entire map with a heavy overlay.
   */
  .pool li::after {
    content:'';
    position:absolute;
    inset:0;
    pointer-events:none;
    background:linear-gradient(
      to bottom,
      rgb(0 0 0 / 8%),
      rgb(0 0 0 / 30%)
    );
    transition:background .22s ease;
  }

  .pool strong {
    position:absolute;
    inset:0;
    z-index:1;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:12px;
    color:#fff;
    text-align:center;
    text-shadow:
      0 2px 5px #000,
      0 0 12px #000;
    font-family:var(--generator-display);
    font-size:clamp(20px,2.4vw,30px);
    line-height:1.1;
    text-transform:uppercase;
  }

  .selection-label {
    position:absolute;
    z-index:2;
    right:5px;
    bottom:5px;
    padding:2px 6px;
    background:rgb(0 0 0 / 82%);
    color:var(--accent);
    font-size:12px;
    line-height:1.2;
  }

  .selection-label:empty {
    display:none;
  }

  /*
   * Map currently being cycled through during the draw.
   */
  .pool li.is-highlighted {
    border-color:var(--accent);
    box-shadow:0 0 0 1px var(--accent);
  }

  .pool li.is-highlighted img {
    filter:brightness(.9);
  }

  .pool li.is-highlighted::after {
    background:linear-gradient(
      to bottom,
      rgb(0 0 0 / 2%),
      rgb(0 0 0 / 18%)
    );
  }

  /*
   * Final selected maps stay bright.
   */
  .pool li.is-selected {
    border-color:var(--accent);
    box-shadow:0 0 0 1px var(--accent);
  }

  .pool li.is-selected img {
    filter:brightness(1);
  }

  .pool li.is-selected::after {
    background:linear-gradient(
      to bottom,
      transparent,
      rgb(0 0 0 / 18%)
    );
  }

  /* -----------------------------
     Map results
  ----------------------------- */

  #draw {
    padding-top:24px;
    border-top:1px solid var(--border);
    scroll-margin-top:88px;
  }

  .result-heading {
    margin-bottom:18px;
  }

  #result-heading {
    margin-bottom:6px;
    scroll-margin-top:88px;
  }

  #draw-status {
    margin:0;
    color:var(--text-secondary);
  }

  #map-results {
    display:grid;
    grid-template-columns:repeat(
      auto-fit,
      minmax(min(100%,240px),1fr)
    );
    gap:12px;
    list-style:none;
    padding:0;
    margin:0 0 24px;
  }

  #map-results :global(li) {
    min-width:0;
    padding:18px 20px;
    border:1px solid var(--border);
    border-left:3px solid var(--accent);
    background:var(--bg-secondary);
  }

  #map-results :global(span) {
    display:block;
    margin-bottom:7px;
    color:var(--text-secondary);
    font-size:13px;
    text-transform:uppercase;
  }

  #map-results :global(strong) {
    display:block;
    font-family:var(--generator-display);
    font-size:27px;
    line-height:1.1;
    text-transform:uppercase;
    overflow-wrap:anywhere;
  }

  /* -----------------------------
     Actions
  ----------------------------- */

  .generator-actions {
    display:flex;
    flex-wrap:wrap;
    gap:10px;
  }

  textarea {
    width:100%;
    min-height:160px;
    margin-top:12px;
    padding:16px;
    border:1px solid var(--border);
    border-radius:0;
    background:var(--bg-card);
    color:var(--text-primary);
    font:inherit;
  }

  textarea:focus-visible {
    outline:3px solid var(--accent);
    outline-offset:4px;
  }

  /* -----------------------------
     Responsive
  ----------------------------- */

  @media (prefers-reduced-motion:reduce) {
    .pool li,
    .pool img,
    .pool li::after {
      transition:none;
    }
  }

  @media (max-width:1000px) {
    .pool ul {
      grid-template-columns:repeat(3,minmax(0,1fr));
    }
  }

  @media (max-width:640px) {
    #randomizer-form {
      margin-bottom:24px;
    }

    #randomizer-form h2 {
      margin-bottom:16px;
    }

    .settings-row {
      align-items:stretch;
    }

    .round-field {
      width:100%;
    }

    .randomizer #round-count {
      width:112px;
    }

    #round-help {
      margin-top:10px;
    }

    .pool {
      margin:24px 0;
      padding-top:22px;
    }

    .pool ul {
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:10px;
      margin-top:14px;
    }

    .pool strong {
      padding:8px;
      font-size:20px;
    }

    .selection-label {
      right:4px;
      bottom:4px;
      font-size:11px;
    }

    #draw {
      padding-top:22px;
    }

    #map-results {
      grid-template-columns:1fr;
      gap:10px;
      margin-bottom:22px;
    }

    #map-results :global(li) {
      padding:17px 20px;
    }

    #map-results :global(strong) {
      font-size:26px;
    }

    .generator-actions {
      display:grid;
      grid-template-columns:1fr;
      gap:10px;
    }

    .generator-actions button {
      width:100%;
    }
  }

  @media (max-width:480px) {
    /*
     * After the first draw this button is hidden.
     * Before the first draw it remains compact rather
     * than unnecessarily spanning the whole page.
     */
    .settings-row #initial-draw {
      width:auto;
    }
  }
</style>