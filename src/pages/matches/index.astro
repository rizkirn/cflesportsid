---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRoundName, getRoundOrder, getParticipantLabel } from '../../utils/tournament';
import {
  getTeamMap, getTeamMatchStats, getTournamentMap,
  getMatchTournamentId, getMatchWinnerId,
  getMatchTeam1Id, getMatchTeam2Id,
} from '../../utils/content';

const teamsMap = await getTeamMap();
const tournamentsMap = await getTournamentMap();

const matches = (await getCollection('matches'))
  .filter((m) => {
    const team1Id = getMatchTeam1Id(m);
    const team2Id = getMatchTeam2Id(m);

    // Kalau kedua slot sudah punya team asli, selalu tampilkan.
    // Termasuk semifinal/final yang statusnya upcoming.
    if (team1Id && team2Id) return true;

    // Kalau belum ada team, cek apakah masih placeholder bracket.
    const participant1 = getParticipantLabel(m, 1).trim().toLowerCase();
    const participant2 = getParticipantLabel(m, 2).trim().toLowerCase();

    const isUnresolvedParticipant = (name: string) =>
      name.startsWith('winner of') ||
      name.startsWith('loser of');

    return !isUnresolvedParticipant(participant1) &&
           !isUnresolvedParticipant(participant2);
  })
  .sort((a, b) => {
    if (a.data.status !== b.data.status) {
      if (a.data.status === 'upcoming') return -1;
      if (b.data.status === 'upcoming') return 1;
      if (a.data.status === 'live') return -1;
      if (b.data.status === 'live') return 1;
    }

    const dateDiff =
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime();

    return dateDiff ||
      getRoundOrder(b, tournamentsMap) -
      getRoundOrder(a, tournamentsMap);
  });

const rounds = [...new Set(matches.map(m => getRoundName(m, tournamentsMap)))];
---

<Layout title="Matches - CFL Esports ID Tournament Hub" current="Matches">
  <div class="container matches-page">
    <div class="page-header">
      <h1>Matches</h1>
      <p>{matches.length} matches · Fixtures and results across all tournaments</p>
    </div>

    <div class="matches-toolbar">
      <div class="match-search-wrap">
        <span class="match-search-icon" aria-hidden="true">⌕</span>
        <input type="text" id="searchInput" aria-label="Search matches" placeholder="Search tournament or team..." class="matches-search" />
      </div>

      <select id="statusFilter" aria-label="Filter by status" class="matches-select">
        <option value="">All Status</option>
        <option value="upcoming">Upcoming</option>
        <option value="live">Live</option>
        <option value="completed">Completed</option>
      </select>

      <select id="roundFilter" aria-label="Filter by round" class="matches-select">
        <option value="">All Rounds</option>
        {rounds.map(round => <option value={round}>{round}</option>)}
      </select>

      <select id="sortSelect" aria-label="Sort matches" class="matches-select sort-select">
        <option value="default">Default</option>
        <option value="date">Date</option>
        <option value="tournament">Tournament</option>
        <option value="round">Round</option>
        <option value="status">Status</option>
      </select>
    </div>

    <div class="matches-context">
      <p id="matchCount" role="status" aria-live="polite"></p>
      <p id="sortContext">Sorted by default</p>
    </div>

    <div id="matchesGrid" class="matches-grid">
      {matches.map(m => {
        const team1Id = getMatchTeam1Id(m);
        const team2Id = getMatchTeam2Id(m);
        const winnerId = getMatchWinnerId(m);
        const tournamentId = getMatchTournamentId(m);
        const tournament = tournamentId ? tournamentsMap.get(tournamentId) : undefined;
        const tournamentName = tournament?.data.name ?? tournamentId ?? 'TBD';
        const t1 = team1Id ? teamsMap.get(team1Id) : undefined;
        const t2 = team2Id ? teamsMap.get(team2Id) : undefined;

        const team1Name = t1?.data.name ?? team1Id ?? getParticipantLabel(m, 1);
        const team2Name = t2?.data.name ?? team2Id ?? getParticipantLabel(m, 2);
        const team1Tag = t1?.data.tag ?? team1Id ?? 'TBD';
        const team2Tag = t2?.data.tag ?? team2Id ?? 'TBD';
        const team1Color = t1?.data.color || '#777B82';
        const team2Color = t2?.data.color || '#777B82';

        const team1Won = Boolean(winnerId && winnerId === team1Id);
        const team2Won = Boolean(winnerId && winnerId === team2Id);
        const completed = m.data.status === 'completed';
        const roundName = getRoundName(m, tournamentsMap);
        const stats1 = getTeamMatchStats([m], team1Id ?? '');
        const stats2 = getTeamMatchStats([m], team2Id ?? '');
        const hasStats = stats1.kills > 0 || stats2.kills > 0;

        const searchText = [
          tournamentName, tournamentId,
          team1Name, team2Name,
          team1Tag, team2Tag,
          team1Id, team2Id
        ].filter(Boolean).join(' ').toLowerCase();

        return (
          <a
            href={`/matches/${m.id}`}
            class={`match-card status-card-${m.data.status}`}
            data-search={searchText}
            data-status={m.data.status}
            data-round={roundName}
            data-date={m.data.date}
            data-round-order={getRoundOrder(m, tournamentsMap)}
            data-tournament={tournamentName}
            style={`--team1-color:${team1Color};--team2-color:${team2Color};`}
          >
            <div class="match-card-head">
              <div class="match-event">
                <strong>{tournamentName}</strong>
                <time datetime={m.data.date}>{m.data.date}</time>
              </div>

              <div class="match-meta">
                <strong>{roundName}</strong>
                <span class={`match-status status-${m.data.status}`}>{m.data.status}</span>
              </div>
            </div>

            <div class="match-versus">
              <div class="match-team">
                <div class="team-logo-wrap">
                  <img
                    src={t1?.data.logo || `/logos/${team1Tag}.webp`}
                    alt={team1Name}
                    loading="lazy"
                    onerror="this.onerror=null;this.src='/logos/default.webp'"
                  />
                </div>
                <strong>{team1Name}</strong>
              </div>

              <div class="match-score">
                {completed ? (
                  <>
                    <div class="score-line">
                      <strong class:list={{ 'score-winner': team1Won }}>{m.data.score1}</strong>
                      <span>—</span>
                      <strong class:list={{ 'score-winner': team2Won }}>{m.data.score2}</strong>
                    </div>
                    <small>Completed</small>
                  </>
                ) : (
                  <>
                    <div class="versus-label">VS</div>
                    <small class={`status-${m.data.status}`}>{m.data.status}</small>
                  </>
                )}
              </div>

              <div class="match-team">
                <div class="team-logo-wrap">
                  <img
                    src={t2?.data.logo || `/logos/${team2Tag}.webp`}
                    alt={team2Name}
                    loading="lazy"
                    onerror="this.onerror=null;this.src='/logos/default.webp'"
                  />
                </div>
                <strong>{team2Name}</strong>
              </div>
            </div>

            {completed && hasStats && (
              <div class="match-stats">
                <div class="team-kda team-kda-left">
                  <strong class="kda-team">{team1Tag}</strong>
                  <div class="kda-values">
                    <span>{stats1.kills}</span>
                    <span>{stats1.deaths}</span>
                    <span>{stats1.assists}</span>
                  </div>
                  <div class="kda-labels"><span>K</span><span>D</span><span>A</span></div>
                </div>

                <div class="team-kda team-kda-right">
                  <strong class="kda-team">{team2Tag}</strong>
                  <div class="kda-values">
                    <span>{stats2.kills}</span>
                    <span>{stats2.deaths}</span>
                    <span>{stats2.assists}</span>
                  </div>
                  <div class="kda-labels"><span>K</span><span>D</span><span>A</span></div>
                </div>
              </div>
            )}

            <div class="match-info">
              <span>Match info</span>
              <span aria-hidden="true">→</span>
            </div>
          </a>
        );
      })}
    </div>

    <p id="noResults" class="no-results" role="status">No matches found.</p>
    <div class="pagination" id="pagination" role="navigation" aria-label="Match pages"></div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInput');
      const statusFilter = document.getElementById('statusFilter');
      const roundFilter = document.getElementById('roundFilter');
      const sortSelect = document.getElementById('sortSelect');
      const sortContext = document.getElementById('sortContext');
      const matchCount = document.getElementById('matchCount');
      const grid = document.getElementById('matchesGrid');
      const noResults = document.getElementById('noResults');
      const pagination = document.getElementById('pagination');
      const cards = Array.from(grid.querySelectorAll('.match-card'));

      const perPage = 10;
      const sortLabels = {
        default: 'DEFAULT',
        date: 'DATE',
        tournament: 'TOURNAMENT',
        round: 'ROUND',
        status: 'STATUS'
      };

      let currentPage = 1;
      let sortColumn = 'default';

      function getVisibleCards() {
        const search = searchInput.value.toLowerCase().trim();
        const status = statusFilter.value;
        const round = roundFilter.value;

        return cards.filter(card =>
          (!search || card.dataset.search.includes(search)) &&
          (!status || card.dataset.status === status) &&
          (!round || card.dataset.round === round)
        );
      }

      function sortCards(visible) {
        visible.sort((a, b) => {
          if (sortColumn === 'tournament')
            return a.dataset.tournament.localeCompare(b.dataset.tournament);

          if (sortColumn === 'date')
            return new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime();

          if (sortColumn === 'round')
            return Number(b.dataset.roundOrder) - Number(a.dataset.roundOrder);

          if (sortColumn === 'status') {
            const order = { live: 0, upcoming: 1, completed: 2 };
            return (order[a.dataset.status] ?? 9) - (order[b.dataset.status] ?? 9);
          }

          const statusOrder = { upcoming: 0, live: 1, completed: 2 };
          const statusDiff =
            (statusOrder[a.dataset.status] ?? 9) -
            (statusOrder[b.dataset.status] ?? 9);

          if (statusDiff) return statusDiff;

          const dateDiff =
            new Date(b.dataset.date).getTime() -
            new Date(a.dataset.date).getTime();

          return dateDiff ||
            Number(b.dataset.roundOrder) -
            Number(a.dataset.roundOrder);
        });
      }

      function pageButton(label, ariaLabel, disabled, callback) {
        const btn = document.createElement('button');
        btn.className = 'page-btn';
        btn.textContent = label;
        btn.disabled = disabled;
        btn.setAttribute('aria-label', ariaLabel);
        btn.addEventListener('click', callback);
        return btn;
      }

      function renderPagination(totalPages) {
        pagination.innerHTML = '';
        if (totalPages <= 1) return;

        pagination.appendChild(
          pageButton('‹', 'Previous page', currentPage === 1, () => {
            currentPage--;
            render();
            scrollToMatches();
          })
        );

        for (let i = 1; i <= totalPages; i++) {
          const btn = pageButton(String(i), `Page ${i}`, false, () => {
            currentPage = i;
            render();
            scrollToMatches();
          });

          if (i === currentPage) {
            btn.classList.add('active');
            btn.setAttribute('aria-current', 'page');
          }

          pagination.appendChild(btn);
        }

        pagination.appendChild(
          pageButton('›', 'Next page', currentPage === totalPages, () => {
            currentPage++;
            render();
            scrollToMatches();
          })
        );
      }

      function scrollToMatches() {
        const toolbar = document.querySelector('.matches-toolbar');
        if (!toolbar) return;
        const top = toolbar.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top, behavior: 'smooth' });
      }

      function render() {
        const visible = getVisibleCards();
        sortCards(visible);

        cards.forEach(card => {
          card.style.display = 'none';
          grid.appendChild(card);
        });

        const totalPages = Math.ceil(visible.length / perPage);
        if (totalPages && currentPage > totalPages) currentPage = 1;

        const start = (currentPage - 1) * perPage;
        const end = start + perPage;

        visible.slice(start, end).forEach(card => {
          card.style.display = '';
          grid.appendChild(card);
        });

        noResults.style.display = visible.length ? 'none' : 'block';

        matchCount.textContent = visible.length
          ? `SHOWING ${start + 1}–${Math.min(end, visible.length)} OF ${visible.length} ${visible.length === 1 ? 'MATCH' : 'MATCHES'}`
          : 'SHOWING 0 MATCHES';

        sortContext.textContent = `SORTED BY ${sortLabels[sortColumn]}`;
        renderPagination(totalPages);
      }

      searchInput.addEventListener('input', () => { currentPage = 1; render(); });
      statusFilter.addEventListener('change', () => { currentPage = 1; render(); });
      roundFilter.addEventListener('change', () => { currentPage = 1; render(); });
      sortSelect.addEventListener('change', () => {
        sortColumn = sortSelect.value;
        currentPage = 1;
        render();
      });

      render();
    });
  </script>
</Layout>

<style>

  :global(body:has(.matches-page)) {
    --bg-primary: #090a0c;
    --bg-secondary: #101114;
    --bg-card: #16171b;
    --bg-card-hover: #202126;
    --border: #303137;
    --text-primary: #f4f3ef;
    --text-secondary: #c4c3bf;
    --text-muted: #a4a6ac;
    --matches-display: 'DIN Condensed', 'Arial Narrow', 'Avenir Next Condensed', sans-serif;
  }

  :global(body:has(.matches-page) .site-header) {
    background: #0c0d0f;
    backdrop-filter: none;
  }

  :global(body:has(.matches-page) .site-header .nav a) {
    font-family: var(--matches-display);
    font-size: 17px;
    font-weight: 500;
  }

  body:has(.matches-page) {
    --bg-primary: #090a0c;
    --bg-secondary: #101114;
    --bg-card: #16171b;
    --bg-card-hover: #202126;
    --border: #303137;
    --text-primary: #f4f3ef;
    --text-secondary: #c4c3bf;
    --text-muted: #a4a6ac;
    --matches-display: 'DIN Condensed', 'Arial Narrow', 'Avenir Next Condensed', sans-serif;
  }

  body:has(.matches-page) .site-header {
    background: #0c0d0f;
    backdrop-filter: none;
  }

  body:has(.matches-page) .site-header .nav a {
    font-family: var(--matches-display);
    font-size: 17px;
    font-weight: 500;
  }

  .matches-page {
    max-width: 1344px;
    padding: 0 32px 32px;
    font-family: 'Arial Narrow', 'Avenir Next Condensed', sans-serif;
  }

  .matches-page .page-header {
    background: none;
    padding: 34px 0 26px;
    margin-bottom: 24px;
  }

  .matches-page .page-header h1 {
    font-family: var(--matches-display);
    font-size: clamp(44px, 6vw, 68px);
    text-transform: uppercase;
  }

  .matches-page .page-header p { font-size: 17px; }

  /* Toolbar */
  .matches-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px 160px 150px;
    gap: 12px;
    padding-top: 0px;
    margin-bottom: 18px;
  }

  .match-search-wrap {
    position: relative;
    min-width: 0;
  }

  .match-search-icon {
    position: absolute;
    top: 50%;
    left: 15px;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .matches-search,
  .matches-select {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: inherit;
    font-size: 16px;
  }

  .matches-search { padding-left: 44px; }
  .matches-select { cursor: pointer; }

  .matches-search:focus,
  .matches-select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .matches-page :is(input, select, a, button):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Context */
  .matches-context {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
    color: var(--text-muted);
    font-family: var(--matches-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .matches-context p { margin: 0; }
  #sortContext { color: var(--accent); }

  /* Cards */
  .matches-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .match-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: 0;
    background: #111215;
    color: var(--text-primary);
    text-decoration: none;
  }

  .match-card.status-card-upcoming {
    border-top-color:#777a82;
  }

  .match-card.status-card-live {
    border-top-color:var(--accent);
  }

  .match-card.status-card-completed {
    border-top-color:#a7ad8a;
  }

  .match-card:hover {
    background: #15161a;
    border-color: #47484e;
    border-top-color:var(--accent);
  }

  /* Card header */
  .match-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 20px 15px;
    border-bottom: 1px solid var(--border);
  }

  .match-event { min-width: 0; }

  .match-event > strong {
    display: block;
    overflow: hidden;
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .match-event time {
    display: block;
    margin-top: 5px;
    color: var(--text-muted);
    font-size: 12px;
  }

  .match-meta {
    flex-shrink: 0;
    text-align: right;
  }

  .match-meta > strong {
    display: block;
    color: var(--text-secondary);
    font-family: var(--matches-display);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .match-status {
    display: block;
    margin-top: 4px;
    color: var(--text-muted);
    font-family: var(--matches-display);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .status-live { color: var(--accent); }
  .status-upcoming { color: #a7ad8a; }

  /* Matchup */
  .match-versus {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 110px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    min-height: 178px;
    padding: 24px 22px;
  }

  .match-versus::before,
  .match-versus::after {
    content: '';
    position: absolute;
    top: 24px;
    bottom: 24px;
    width: 3px;
  }

  .match-versus::before {
    left: 0;
    background: var(--team1-color);
  }

  .match-versus::after {
    right: 0;
    background: var(--team2-color);
  }

  .match-team {
    min-width: 0;
    text-align: center;
  }

  .team-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin: 0 auto 10px;
  }

  .team-logo-wrap img {
    display: block;
    width: 58px;
    height: 58px;
    object-fit: contain;
  }

  .match-team > strong {
    display: block;
    color: var(--text-primary);
    font-family: var(--matches-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  /* Score */
  .match-score { text-align: center; }

  .score-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: var(--text-primary);
    font-family: var(--matches-display);
    font-size: 38px;
    line-height: 1;
    white-space: nowrap;
  }

  .score-line strong {
    min-width: 22px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .score-line strong.score-winner {
    color: var(--text-primary);
    font-weight: 700;
  }

  .score-line > span {
    color: #777a80;
    font-weight: 400;
  }

  .versus-label {
    color: var(--text-primary);
    font-family: var(--matches-display);
    font-size: 30px;
    font-weight: 600;
  }

  .match-score small {
    display: block;
    margin-top: 9px;
    color: var(--text-muted);
    font-family: var(--matches-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  /* KDA */
  .match-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
  }

  .team-kda { padding: 14px 20px; }
  .team-kda-left { border-right: 0px solid var(--border); }
  .team-kda-right { text-align: right; }

  .kda-team {
    display: block;
    margin-bottom: 7px;
    font-family: var(--matches-display);
    font-size: 12px;
    font-weight: 600;
  }

  .team-kda-left .kda-team { color: var(--team1-color); }
  .team-kda-right .kda-team { color: var(--team2-color); }

  .kda-values,
  .kda-labels {
    display: grid;
    grid-template-columns: repeat(3, 38px);
    gap: 3px;
  }

  .team-kda-right .kda-values,
  .team-kda-right .kda-labels {
    justify-content: end;
  }

  .kda-values span {
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .kda-labels { margin-top: 2px; }

  .kda-labels span {
    color: var(--text-muted);
    font-family: var(--matches-display);
    font-size: 10px;
    text-align: center;
  }

  /* Footer */
  .match-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding: 13px 20px;
    border-top: 1px solid var(--border);
    color: var(--accent);
    font-family: var(--matches-display);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .match-info span:last-child { transition: transform .15s ease; }
  .match-card:hover .match-info span:last-child { transform: translateX(3px); }

  /* Empty / Pagination */
  .no-results {
    display: none;
    padding: 32px 16px;
    color: var(--text-muted);
    text-align: center;
  }

  .pagination {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .pagination :global(.page-btn) {
    min-width: 44px;
    height: 44px;
    padding: 0 10px;
    border-radius: 0;
    font: inherit;
  }

  .pagination :global(.page-btn.active) {
    background: var(--accent);
    border-color: var(--accent);
    color: #101114;
  }

