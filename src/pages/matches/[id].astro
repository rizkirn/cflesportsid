---
import MatchInsights from '../../components/MatchInsights.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRoundName, getParticipantLabel } from '../../utils/tournament';

import {
  getMatchTeam1Id,
  getMatchTeam2Id,
  getMatchWinnerId,
  getMatchTournamentId,
  getRoundMapId,
} from '../../utils/content';

export async function getStaticPaths() {
  const matches = await getCollection('matches');

  return matches.map(m => ({
    params: { id: m.id },
    props: { match: m },
  }));
}

const { match } = Astro.props;
const m = match;

const allTeams = await getCollection('teams');
const allPlayers = await getCollection('players');
const allTournaments = await getCollection('tournaments');
const allMaps = await getCollection('maps');

const teamsMap = new Map(
  allTeams.map((team) => [team.id, team])
);

const playersMap = new Map(
  allPlayers.map((player) => [player.data.uid, player])
);

const tournamentsMap = new Map(
  allTournaments.map((tournament) => [tournament.id, tournament])
);

const mapsMap = new Map(
  allMaps.map((map) => [map.id, map])
);

const team1Id = getMatchTeam1Id(m);
const team2Id = getMatchTeam2Id(m);
const winnerId = getMatchWinnerId(m);
const tournamentId = getMatchTournamentId(m);

const t1 = team1Id ? teamsMap.get(team1Id) : undefined;
const t2 = team2Id ? teamsMap.get(team2Id) : undefined;

const tournament = tournamentId
  ? tournamentsMap.get(tournamentId)
  : undefined;

const team1Name =
  t1?.data.name ??
  team1Id ??
  getParticipantLabel(m, 1);

const team2Name =
  t2?.data.name ??
  team2Id ??
  getParticipantLabel(m, 2);

const team1Tag = t1?.data.tag ?? team1Id ?? 'TBD';
const team2Tag = t2?.data.tag ?? team2Id ?? 'TBD';

const t1Won = Boolean(winnerId && winnerId === team1Id);
const t2Won = Boolean(winnerId && winnerId === team2Id);

const t1Color =
  m.data.status === 'completed'
    ? (t1Won ? 'var(--win)' : 'var(--text-muted)')
    : 'var(--text-primary)';

const t2Color =
  m.data.status === 'completed'
    ? (t2Won ? 'var(--win)' : 'var(--text-muted)')
    : 'var(--text-primary)';

const roundDetails = m.data.roundDetails || [];

const roundMapNames = roundDetails.map((rd) => {
  const mapId = getRoundMapId(rd);
  return mapsMap.get(mapId)?.data.name ?? 'TBD';
});

const roundMVPuids = roundDetails.map(rd => rd.mvp || null);

const numRounds = Math.max(
  ...((m.data.playerStats || []).map(
    ps => (ps.rounds || []).length
  )),
  roundDetails.length,
  0
);

const playerStats = (m.data.playerStats || [])
  .filter(ps => ps.uid)
  .map(ps => {
    const player = playersMap.get(ps.uid);
    const team = ps.teamId
      ? teamsMap.get(ps.teamId)
      : undefined;

    const rounds = ps.rounds || [];

    return {
      uid: ps.uid,
      avatar:
        player?.data.avatar ||
        (ps.uid
          ? `/players/${ps.uid}.webp`
          : '/players/default.webp'),

      ign:
        player
          ? player.data.ign
          : (ps.ign || ps.uid),

      teamName:
        team
          ? team.data.name
          : '—',

      teamTag:
        team
          ? team.data.tag
          : '—',

      teamId: ps.teamId,
      rounds,

      totalKills: rounds.reduce(
        (s, r) => s + (r.kills || 0),
        0
      ),

      totalDeaths: rounds.reduce(
        (s, r) => s + (r.deaths || 0),
        0
      ),

      totalAssists: rounds.reduce(
        (s, r) => s + (r.assists || 0),
        0
      ),
    };
  });

const team1Players = playerStats.filter(
  p => p.teamId === team1Id
);

const team2Players = playerStats.filter(
  p => p.teamId === team2Id
);

function getRoundMVP(roundIdx) {
  const uid = roundMVPuids[roundIdx];

  if (!uid) return null;

  const player = playersMap.get(uid);

  const ps = playerStats.find(
    p => p.uid === uid
  );

  const r = ps?.rounds.find(
    r =>
      r.round_number ===
      roundDetails[roundIdx]?.round_number
  );

  return {
    uid,

    ign:
      player
        ? player.data.ign
        : (ps ? ps.ign : uid),

    teamTag: ps?.teamTag,

    kills: r?.kills ?? null,
    deaths: r?.deaths ?? null,
    assists: r?.assists ?? null,
  };
}

const roundMVPs =
  numRounds > 0
    ? Array.from(
        { length: numRounds },
        (_, i) => getRoundMVP(i)
      )
    : [];
---

<Layout
  title={`${team1Name} vs ${team2Name} - CFL Esports ID Tournament Hub`}
  current="Matches"
>
  <div class="container match-detail-page">
    <a class="back-to-matches" href="/matches"><span aria-hidden="true">←</span> All matches</a>

    {
      m.data.status === 'upcoming' &&
      tournament?.data.stages.find(
        stage => stage.id === m.data.stageId
      )?.veto &&
      team1Id &&
      team2Id && (
        <p>
          <a href={`/veto?match=${m.id}`}>
            Start map veto
          </a>
        </p>
      )
    }

    <!-- =========================
         MATCH HERO
    ========================== -->

    <section
      class="match-score-card"
      aria-label="Match score and details"
    >
      <header class="score-metadata">

        <h1>
          {tournament?.data.name ?? tournamentId ?? 'TBD'}
        </h1>

        <p>
          <span class="match-status">{m.data.status}</span> · <time datetime={m.data.date}>
            {m.data.date}
          </time>
        </p>

        <span class="match-round-badge">
          {getRoundName(m, tournamentsMap)}
        </span>

      </header>

      <div class="match-detail-scoreboard">

        <!-- TEAM 1 -->

        <div class="match-detail-team">

          <img
            src={
              t1?.data.logo ||
              `/logos/${team1Tag}.webp`
            }
            alt={team1Name}
            class="team-logo-large"
            onerror="this.onerror=null; this.src='/logos/default.webp'"
          />

          <a
            href={
              team1Id
                ? `/teams/${team1Id}`
                : undefined
            }
            style={`color: ${t1Color};`}
          >
            {team1Name}
          </a>

          <span class="tag">
            [{team1Tag}]
          </span>

        </div>

        <!-- SCORE -->

        <div class="match-detail-score">
          {
            m.data.status === 'completed'
              ? `${m.data.score1} - ${m.data.score2}`
              : 'VS'
          }
        </div>

        <!-- TEAM 2 -->

        <div class="match-detail-team">

          <img
            src={
              t2?.data.logo ||
              `/logos/${team2Tag}.webp`
            }
            alt={team2Name}
            class="team-logo-large"
            onerror="this.onerror=null; this.src='/logos/default.webp'"
          />

          <a
            href={
              team2Id
                ? `/teams/${team2Id}`
                : undefined
            }
            style={`color: ${t2Color};`}
          >
            {team2Name}
          </a>

          <span class="tag">
            [{team2Tag}]
          </span>

        </div>

      </div>

    </section>

    {m.data.status === 'completed' && playerStats.length === 0 && roundDetails.length > 0 && (
      <section class="section-spacing" aria-label="Map results">
        <h2 class="section-title">Map results</h2>
        <div class="mvp-grid">
          {roundDetails.map((round, index) => (
            <article class="mvp-card">
              <h3>Map {round.round_number}: {roundMapNames[index]}</h3>
              {round.resultNote && <p class="map-result-note">{round.resultNote}</p>}
              <p>{teamsMap.get(round.winnerId)?.data.name ?? 'TBD'} wins</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- =========================
         COMPLETED MATCH DATA
    ========================== -->

    {
      m.data.status === 'completed' &&
      playerStats.length > 0 && (
        <>

          <!-- OVERVIEW -->

          <MatchInsights
            players={playerStats}
            team1Id={team1Id}
            team2Id={team2Id}
            team1Name={team1Name}
            team2Name={team2Name}
            overviewOnly
          />

          <!-- TABS -->

          <div
            class="match-tabs"
            role="tablist"
            aria-label="Match details"
          >
            {[
              'Match Leaders',
              'Maps & MVP',
              'Player Stats',
              'Player Comparison'
            ].map((label, i) => (
              <button
                id={`match-tab-${i}`}
                role="tab"
                aria-controls={`match-panel-${i}`}
                aria-selected={
                  i === 0 ? 'true' : 'false'
                }
                tabindex={i === 0 ? 0 : -1}
              >
                {label}
              </button>
            ))}
          </div>

          <!-- =====================
               MATCH LEADERS
          ====================== -->

          <section
            id="match-panel-0"
            role="tabpanel"
            aria-labelledby="match-tab-0"
          >
            <MatchInsights
              players={playerStats}
              team1Id={team1Id}
              team2Id={team2Id}
              team1Name={team1Name}
              team2Name={team2Name}
              leadersOnly
            />
          </section>

          <!-- =====================
               MAPS & MVP
          ====================== -->

          <section
            id="match-panel-1"
            role="tabpanel"
            aria-labelledby="match-tab-1"
            hidden
          >

            {
              roundDetails.length > 0 && (
                <section class="section-spacing">

                  <h2 class="section-title">
                    Maps & MVP
                  </h2>

                  <div class="mvp-grid">

                    {
                      Array.from(
                        { length: numRounds },
                        (_, i) => {

                          const mvp =
                            roundMVPs[i];

                          const mapName =
                            roundMapNames[i] ||
                            'TBD';

                          const mapId =
                            getRoundMapId(
                              roundDetails[i]
                            );

                          return (
                            <article class="mvp-card map-mvp-card">

                              <a
                                class="map-mvp-image-link"
                                href={
                                  mapId
                                    ? `/maps/${mapId}`
                                    : undefined
                                }
                                aria-label={`View ${mapName} map details`}
                              >

                                <img
                                  class="map-mvp-thumbnail"
                                  src={mapId ? `/maps/${mapId}.webp` : '/maps/placeholder.svg'}
                                  alt={mapName}
                                  loading="lazy"
                                  onerror="this.onerror=null;this.src='/maps/placeholder.svg'"
                                />

                                <h3 class="map-mvp-overlay">
                                  {mapName}
                                </h3>

                              </a>

                              {
                                mvp ? (

                                  <div class="map-mvp-player">

                                    <img
                                      class="map-mvp-avatar"
                                      src={
                                        playersMap.get(mvp.uid)?.data.avatar ||
                                        (mvp.uid
                                          ? `/players/${mvp.uid}.webp`
                                          : '/players/default.webp')
                                      }
                                      alt={`${mvp.ign} photo`}
                                      width="100"
                                      height="110"
                                      loading="lazy"
                                      onerror="this.onerror=null;this.src='/players/default.webp'"
                                    />

                                    <div>

                                      <a
                                        class="map-mvp-name"
                                        href={
                                          playersMap.get(
                                            mvp.uid
                                          )
                                            ? `/players/${
                                                playersMap.get(
                                                  mvp.uid
                                                ).id
                                              }`
                                            : undefined
                                        }
                                      >
                                        {mvp.ign}

                                        {
                                          mvp.teamTag &&
                                          mvp.teamTag !== '—'
                                            ? ` (${mvp.teamTag})`
                                            : ''
                                        }
                                      </a>

                                      <p class="mvp-label">
                                        Round {
                                          roundDetails[i]
                                            ?.round_number ??
                                          i + 1
                                        } MVP
                                      </p>

                                      <div class="mvp-kda">

                                        <span class="kill">
                                          {mvp.kills ?? '—'}
                                        </span>

                                        {' / '}

                                        <span class="death">
                                          {mvp.deaths ?? '—'}
                                        </span>

                                        {' / '}

                                        <span class="assist">
                                          {mvp.assists ?? '—'}
                                        </span>

                                      </div>

                                    </div>

                                  </div>

                                ) : (

                                  <p class="mvp-none">
                                    No MVP
                                  </p>

                                )
                              }

                              {
                                !mvp &&
                                roundDetails[i]?.resultNote && (
                                  <p class="map-result-note">
                                    {roundDetails[i].resultNote}
                                  </p>
                                )
                              }

                            </article>
                          );
                        }
                      )
                    }

                  </div>

                </section>
              )
            }

          </section>

          <!-- =====================
               PLAYER STATS
          ====================== -->

          <section
            id="match-panel-2"
            role="tabpanel"
            aria-labelledby="match-tab-2"
            hidden
          >

            <h2 class="section-title">
              Player Stats
            </h2>

            {
              playerStats.some(
                p =>
                  p.rounds.some(
                    r =>
                      r.round_number ===
                      undefined
                  )
              ) && (
                <p class="text-muted">
                  Some player map numbers are
                  unknown. Their stats are included
                  in totals, but left unassigned in
                  map columns.
                </p>
              )
            }

            <!-- TEAM 1 -->

            {
              team1Players.length > 0 && (
                <div
                  class="section-spacing"
                  style={`--team-color: ${t1Color};`}
                >

                  <h3 class="team-header">

                    <a
                      href={
                        team1Id
                          ? `/teams/${team1Id}`
                          : undefined
                      }
                    >
                      {team1Name}
                    </a>

                    <span class="tag">
                      {' '}[{team1Tag}]
                    </span>

                  </h3>

                  <p class="mobile-table-hint">
                    Swipe to view all rounds →
                  </p>

                  <div
                    class="table-wrap"
                    tabindex="0"
                    role="region"
                    aria-label={`${team1Name} player statistics`}
                  >

                    <table class="match-stats-table">

                      <thead>
                        <tr>

                          <th>Player</th>

                          {
                            numRounds > 1 &&
                            Array.from(
                              {
                                length:
                                  numRounds
                              },
                              (_, i) => (
                                <th>
                                  Round {i + 1}
                                  {
                                    roundMapNames[i]
                                      ? ` — ${roundMapNames[i]}`
                                      : ''
                                  }
                                </th>
                              )
                            )
                          }

                          <th>Total</th>

                        </tr>
                      </thead>

                      <tbody>

                        {
                          team1Players.map(
                            p => (
                              <tr>

                                <td>
                                  <a
                                    href={`/players/${
                                      playersMap.get(
                                        p.uid
                                      )?.id || ''
                                    }`}
                                  >
                                    <strong>
                                      {p.ign}
                                    </strong>
                                  </a>
                                </td>

                                {
                                  numRounds > 1 &&
                                  Array.from(
                                    {
                                      length:
                                        numRounds
                                    },
                                    (_, i) => {

                                      const r =
                                        p.rounds.find(
                                          r =>
                                            r.round_number ===
                                            roundDetails[
                                              i
                                            ]
                                              ?.round_number
                                        );

                                      return r ? (
                                        <td class="kda">

                                          <span class="kill">
                                            {r.kills}
                                          </span>

                                          /

                                          <span class="death">
                                            {r.deaths}
                                          </span>

                                          /

                                          <span class="assist">
                                            {r.assists}
                                          </span>

                                        </td>
                                      ) : (
                                        <td class="text-muted">
                                          —
                                        </td>
                                      );
                                    }
                                  )
                                }

                                <td class="kda total-kda">

                                  <span class="kill">
                                    {p.totalKills}
                                  </span>

                                  /

                                  <span class="death">
                                    {p.totalDeaths}
                                  </span>

                                  /

                                  <span class="assist">
                                    {p.totalAssists}
                                  </span>

                                </td>

                              </tr>
                            )
                          )
                        }

                      </tbody>

                    </table>

                  </div>

                </div>
              )
            }

            <!-- TEAM 2 -->

            {
              team2Players.length > 0 && (
                <div
                  class="section-spacing"
                  style={`--team-color: ${t2Color};`}
                >

                  <h3 class="team-header">

                    <a
                      href={
                        team2Id
                          ? `/teams/${team2Id}`
                          : undefined
                      }
                    >
                      {team2Name}
                    </a>

                    <span class="tag">
                      {' '}[{team2Tag}]
                    </span>

                  </h3>

                  <p class="mobile-table-hint">
                    Swipe to view all rounds →
                  </p>

                  <div
                    class="table-wrap"
                    tabindex="0"
                    role="region"
                    aria-label={`${team2Name} player statistics`}
                  >

                    <table class="match-stats-table">

                      <thead>
                        <tr>

                          <th>Player</th>

                          {
                            numRounds > 1 &&
                            Array.from(
                              {
                                length:
                                  numRounds
                              },
                              (_, i) => (
                                <th>
                                  Round {i + 1}
                                  {
                                    roundMapNames[i]
                                      ? ` — ${roundMapNames[i]}`
                                      : ''
                                  }
                                </th>
                              )
                            )
                          }

                          <th>Total</th>

                        </tr>
                      </thead>

                      <tbody>

                        {
                          team2Players.map(
                            p => (
                              <tr>

                                <td>
                                  <a
                                    href={`/players/${
                                      playersMap.get(
                                        p.uid
                                      )?.id || ''
                                    }`}
                                  >
                                    <strong>
                                      {p.ign}
                                    </strong>
                                  </a>
                                </td>

                                {
                                  numRounds > 1 &&
                                  Array.from(
                                    {
                                      length:
                                        numRounds
                                    },
                                    (_, i) => {

                                      const r =
                                        p.rounds.find(
                                          r =>
                                            r.round_number ===
                                            roundDetails[
                                              i
                                            ]
                                              ?.round_number
                                        );

                                      return r ? (
                                        <td class="kda">

                                          <span class="kill">
                                            {r.kills}
                                          </span>

                                          /

                                          <span class="death">
                                            {r.deaths}
                                          </span>

                                          /

                                          <span class="assist">
                                            {r.assists}
                                          </span>

                                        </td>
                                      ) : (
                                        <td class="text-muted">
                                          —
                                        </td>
                                      );
                                    }
                                  )
                                }

                                <td class="kda total-kda">

                                  <span class="kill">
                                    {p.totalKills}
                                  </span>

                                  /

                                  <span class="death">
                                    {p.totalDeaths}
                                  </span>

                                  /

                                  <span class="assist">
                                    {p.totalAssists}
                                  </span>

                                </td>

                              </tr>
                            )
                          )
                        }

                      </tbody>

                    </table>

                  </div>

                </div>
              )
            }

            <!-- FALLBACK FOR SINGLE ROUND -->

            {
              numRounds <= 1 && (
                <div class="table-wrap section-spacing">

                  <table class="match-stats-table">

                    <thead>
                      <tr>
                        <th>Player</th>
                        <th>Team</th>
                        <th>Kills</th>
                        <th>Deaths</th>
                        <th>Assists</th>
                      </tr>
                    </thead>

                    <tbody>

                      {
                        playerStats.map(
                          p => (
                            <tr>

                              <td>
                                <a
                                  href={`/players/${
                                    playersMap.get(
                                      p.uid
                                    )?.id || ''
                                  }`}
                                >
                                  <strong>
                                    {p.ign}
                                  </strong>
                                </a>
                              </td>

                              <td class="text-muted">
                                {p.teamTag}
                              </td>

                              <td class="kda">
                                <span class="kill">
                                  {p.totalKills}
                                </span>
                              </td>

                              <td class="kda">
                                <span class="death">
                                  {p.totalDeaths}
                                </span>
                              </td>

                              <td class="kda">
                                <span class="assist">
                                  {p.totalAssists}
                                </span>
                              </td>

                            </tr>
                          )
                        )
                      }

                    </tbody>

                  </table>

                </div>
              )
            }

          </section>

          <!-- =====================
               PLAYER COMPARISON
          ====================== -->

          <section
            id="match-panel-3"
            role="tabpanel"
            aria-labelledby="match-tab-3"
            hidden
          >

            <MatchInsights
              players={playerStats}
              team1Id={team1Id}
              team2Id={team2Id}
              team1Name={team1Name}
              team2Name={team2Name}
              comparison
            />

          </section>

        </>
      )
    }

    {
      m.data.status !== 'completed' && (
        <div class="empty-state">
          Match stats will be available after the
          match is completed.
        </div>
      )
    }

  </div>
</Layout>


<style>

  /* =========================
     GENERAL
  ========================== */

  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .section-spacing {
    margin-bottom: 2.5rem;
  }

  .text-muted {
    color: var(--text-muted);
  }

  .empty-state {
    padding: 3rem 1rem;
    color: var(--text-muted);
    font-size: 1.1rem;
    text-align: center;
  }


  /* =========================
     MATCH HERO
  ========================== */

  .match-score-card {
    margin: 32px 0;
    padding: 26px;

    background:
      linear-gradient(
        115deg,
        #3f2b20,
        #282323 65%,
        #252528
      );

    border: 1px solid #61412d;
    border-radius: 12px;
  }

  .score-metadata {
    margin-bottom: 18px;
    text-align: center;
  }

  .score-metadata h1 {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
  }

  .score-metadata p {
    margin: 8px 0 0;
    color: var(--text-muted);
    font-size: 14px;
  }

  .match-round-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 28px;
    margin-top: 12px;
    padding: 0 10px;

    color: var(--accent);
    background: rgba(255, 116, 46, .10);

    border: 1px solid rgba(255, 116, 46, .35);
    border-radius: 4px;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .match-detail-scoreboard {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 2rem;

    margin: 0;
    padding: 12px;

    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .match-detail-team {
    display: flex;
    flex: 1;
    flex-direction: column;
