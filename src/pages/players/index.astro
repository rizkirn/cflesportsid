---
import { getFrontendMatches } from '../../data-access/frontend-matches';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { calculateStatistics, emptyStats, kdRatio } from '../../utils/statistics';

const allTeams = await getCollection('teams');
const teamsMap = new Map(allTeams.map(t => [t.id, t]));

const allMatches = await getFrontendMatches();
const calculated = calculateStatistics(allMatches);

const players = (await getCollection('players')).map(p => {
  const team = p.data.team ? teamsMap.get(p.data.team) : undefined;
  const stats = calculated.players.get(p.data.uid || p.id) ?? emptyStats();
  const kd = kdRatio(stats);

  return {
    id: p.id,
    uid: p.data.uid,
    ign: p.data.ign,
    avatar: p.data.avatar || (p.data.uid ? `/players/${p.data.uid}.webp` : '/players/default.webp'),
    teamName: team?.data.name || '—',
    teamId: team?.id || '',
    teamLogo: team?.data.logo || (team?.data.tag ? `/logos/${team.data.tag}.webp` : ''),
    teamColor: team?.data.color || '#777B82',
    kills: stats.kills,
    deaths: stats.deaths,
    assists: stats.assists,
    kd: parseFloat(kd.toFixed(2)),
    kdDisplay: kd.toFixed(2),
    matches: stats.matchesPlayed,
  };
});

const killLeader = [...players].sort((a, b) => b.kills - a.kills)[0];
const kdLeader = [...players].filter(p => p.matches > 0).sort((a, b) => b.kd - a.kd)[0];
const assistLeader = [...players].sort((a, b) => b.assists - a.assists)[0];

const teamNames = [
  ...new Set(players.map(p => p.teamName).filter(t => t !== '—'))
].sort();
---

<Layout title="Players - CFL Esports ID Tournament Hub" current="Players">
  <div class="container players-page">

    <div class="page-header">
      <h1>The players</h1>
      <p>{players.length} players · Match statistics across all tournaments</p>
    </div>

    <section class="players-summary" aria-label="Player statistics leaders">
      <div class="summary-stat summary-total">
        <strong>{players.length}</strong>
        <span>Players</span>
        <small>Competing across all tournaments</small>
      </div>

      <div class="summary-stat" style={`--leader-color: ${killLeader?.teamColor || '#777B82'};`}>
        <strong>{killLeader?.kills ?? 0}</strong>
        <span>Most Kills</span>
        <small>
          {killLeader ? (
            <>
              <a href={`/players/${killLeader.id}`}>{killLeader.ign}</a>
              {killLeader.teamName !== '—' && <> · <a href={`/teams/${killLeader.teamId}`}>{killLeader.teamName}</a></>}
            </>
          ) : '—'}
        </small>
      </div>

      <div class="summary-stat" style={`--leader-color: ${kdLeader?.teamColor || '#777B82'};`}>
        <strong>{kdLeader?.kdDisplay ?? '0.00'}</strong>
        <span>Best K/D</span>
        <small>
          {kdLeader ? (
            <>
              <a href={`/players/${kdLeader.id}`}>{kdLeader.ign}</a>
              {kdLeader.teamName !== '—' && <> · <a href={`/teams/${kdLeader.teamId}`}>{kdLeader.teamName}</a></>}
            </>
          ) : '—'}
        </small>
      </div>

      <div class="summary-stat" style={`--leader-color: ${assistLeader?.teamColor || '#777B82'};`}>
        <strong>{assistLeader?.assists ?? 0}</strong>
        <span>Most Assists</span>
        <small>
          {assistLeader ? (
            <>
              <a href={`/players/${assistLeader.id}`}>{assistLeader.ign}</a>
              {assistLeader.teamName !== '—' && <> · <a href={`/teams/${assistLeader.teamId}`}>{assistLeader.teamName}</a></>}
            </>
          ) : '—'}
        </small>
      </div>
    </section>

    <div class="players-toolbar">
      <div class="search-wrap">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input type="text" id="searchInput" aria-label="Search players" placeholder="Search player or team..." class="players-search" />
      </div>

      <select id="teamFilter" aria-label="Filter by team" class="players-filter">
        <option value="">All Teams</option>
        {teamNames.map(name => <option value={name.toLowerCase()}>{name}</option>)}
      </select>
    </div>

    <div class="table-context">
      <p id="playerCount" role="status" aria-live="polite"></p>
      <p id="sortContext" class="sort-context">Sorted by kills ↓</p>
      <p class="table-scroll-hint">Swipe to view full stats →</p>
    </div>

    <div class="table-wrap players-table-wrap" tabindex="0" role="region" aria-label="Player statistics table">
      <table id="playersTable" class="players-table">
        <thead>
          <tr>
            <th class="rank-heading" aria-label="Rank">#</th>

            <th class="sortable" data-key="ign" data-numeric="false">
              <button type="button">Player<span class="arrow" aria-hidden="true"></span></button>
            </th>

            <th class="sortable" data-key="team" data-numeric="false">
              <button type="button">Team<span class="arrow" aria-hidden="true"></span></button>
            </th>

            <th class="sortable" data-key="kills" data-numeric="true">
              <button type="button">Kills<span class="arrow" aria-hidden="true"></span></button>
            </th>

            <th class="sortable" data-key="deaths" data-numeric="true">
              <button type="button">Deaths<span class="arrow" aria-hidden="true"></span></button>
            </th>

            <th class="sortable" data-key="assists" data-numeric="true">
              <button type="button">Assists<span class="arrow" aria-hidden="true"></span></button>
            </th>

            <th class="sortable" data-key="kd" data-numeric="true">
              <button type="button">K/D Ratio<span class="arrow" aria-hidden="true"></span></button>
            </th>

            <th class="sortable" data-key="matches" data-numeric="true">
              <button type="button">Matches<span class="arrow" aria-hidden="true"></span></button>
            </th>
          </tr>
        </thead>

        <tbody id="playersBody">
          {players.map(p => (
            <tr
              data-ign={p.ign.toLowerCase()}
              data-team={p.teamName.toLowerCase()}
              data-kills={p.kills}
              data-deaths={p.deaths}
              data-assists={p.assists}
              data-kd={p.kd}
              data-matches={p.matches}
              style={`--team-color: ${p.teamColor};`}
            >
              <td class="rank-cell"><span class="rank-number"></span></td>

              <td class="player-column">
                <a href={`/players/${p.id}`} class="player-cell">
                  <span class="player-avatar-wrap">
                    <img
                      src={p.avatar}
                      alt=""
                      width="42"
                      height="42"
                      class="player-avatar"
                      loading="lazy"
                      onerror="this.onerror=null; this.src='/players/default.webp'"
                    />
                  </span>
                  <strong>{p.ign}</strong>
                </a>
              </td>

              <td>
                {p.teamId ? (
                  <a href={`/teams/${p.teamId}`} class="team-link">
                    {p.teamLogo && (
                      <img
                        src={p.teamLogo}
                        alt=""
                        width="24"
                        height="24"
                        loading="lazy"
                        onerror="this.style.display='none'"
                      />
                    )}
                    <span>{p.teamName}</span>
                  </a>
                ) : '—'}
              </td>

              <td class="kda"><span>{p.kills}</span></td>
              <td class="kda"><span>{p.deaths}</span></td>
              <td class="kda"><span>{p.assists}</span></td>
              <td class={p.kd >= 1 ? 'kd-positive' : 'kd-negative'}>{p.kdDisplay}</td>
              <td>{p.matches}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p id="noResults" role="status" class="no-results">
      No players match your search and team filter.
    </p>

    <div class="pagination" id="pagination" role="navigation" aria-label="Player pages"></div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInput');
      const teamFilter = document.getElementById('teamFilter');
      const tbody = document.getElementById('playersBody');
      const noResults = document.getElementById('noResults');
      const pagination = document.getElementById('pagination');
      const playerCount = document.getElementById('playerCount');
      const sortContext = document.getElementById('sortContext');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const headers = document.querySelectorAll('.sortable');

      const perPage = 10;
      const sortLabels = {
        ign: 'player',
        team: 'team',
        kills: 'kills',
        deaths: 'deaths',
        assists: 'assists',
        kd: 'K/D',
        matches: 'matches'
      };

      let currentPage = 1;
      let sortKey = 'kills';
      let sortDir = 'desc';
      let isNumeric = true;

      function isMobile() {
        return window.matchMedia('(max-width: 640px)').matches;
      }

      function getVisibleRows() {
        const search = searchInput.value.trim().toLowerCase();
        const team = teamFilter.value;

        return rows.filter(row => {
          const matchesSearch =
            !search ||
            row.dataset.ign.includes(search) ||
            row.dataset.team.includes(search);

          const matchesTeam = !team || row.dataset.team === team;
          return matchesSearch && matchesTeam;
        });
      }

      function sortRows(visible) {
        visible.sort((a, b) => {
          let valA = a.dataset[sortKey] || '';
          let valB = b.dataset[sortKey] || '';

          if (isNumeric) {
            valA = parseFloat(valA) || 0;
            valB = parseFloat(valB) || 0;
            return sortDir === 'asc' ? valA - valB : valB - valA;
          }

          return sortDir === 'asc'
            ? valA.localeCompare(valB)
            : valB.localeCompare(valA);
        });
      }

      function updateSortHeader() {
        headers.forEach(header => {
          header.removeAttribute('aria-sort');
          header.classList.remove('active-sort');

          const arrow = header.querySelector('.arrow');
          if (arrow) arrow.textContent = '';
        });

        const activeHeader = document.querySelector(`[data-key="${sortKey}"]`);
        if (!activeHeader) return;

        activeHeader.setAttribute(
          'aria-sort',
          sortDir === 'asc' ? 'ascending' : 'descending'
        );

        activeHeader.classList.add('active-sort');

        const arrow = activeHeader.querySelector('.arrow');
        if (arrow) arrow.textContent = sortDir === 'asc' ? ' ↑' : ' ↓';
      }

      function updateSortContext() {
        const label = sortLabels[sortKey] || sortKey;
        sortContext.textContent = `Sorted by ${label} ${sortDir === 'asc' ? '↑' : '↓'}`;
      }

      function getDesktopPageItems(totalPages, page) {
        if (totalPages <= 7) {
          return Array.from({ length: totalPages }, (_, i) => i + 1);
        }

        if (page <= 4) return [1, 2, 3, 4, 5, 'ellipsis', totalPages];

        if (page >= totalPages - 3) {
          return [
            1,
            'ellipsis',
            totalPages - 4,
            totalPages - 3,
            totalPages - 2,
            totalPages - 1,
            totalPages
          ];
        }

        return [1, 'ellipsis', page - 1, page, page + 1, 'ellipsis', totalPages];
      }

      function getMobilePageItems(totalPages, page) {
        if (totalPages <= 4) {
          return Array.from({ length: totalPages }, (_, i) => i + 1);
        }

        if (page <= 2) return [1, 2, 'ellipsis', totalPages];
        if (page >= totalPages - 1) return [1, 'ellipsis', totalPages - 1, totalPages];

        return [1, 'ellipsis', page, 'ellipsis', totalPages];
      }

      function getPageItems(totalPages, page) {
        return isMobile()
          ? getMobilePageItems(totalPages, page)
          : getDesktopPageItems(totalPages, page);
      }

      function scrollToPlayers() {
        const toolbar = document.querySelector('.players-toolbar');
        if (!toolbar) return;

        const top = toolbar.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top, behavior: 'smooth' });
      }

      function createPageButton(label, ariaLabel, disabled, onClick) {
        const button = document.createElement('button');
        button.className = 'page-btn';
        button.textContent = label;
        button.disabled = disabled;
        button.setAttribute('aria-label', ariaLabel);
        button.addEventListener('click', onClick);
        return button;
      }

      function renderPagination(totalPages) {
        const focusedLabel = pagination.contains(document.activeElement)
          ? document.activeElement.getAttribute('aria-label')
          : null;

        pagination.innerHTML = '';
        if (totalPages <= 1) return;

        const prev = createPageButton('‹', 'Previous page', currentPage === 1, () => {
          if (currentPage <= 1) return;
          currentPage--;
          render();
          scrollToPlayers();
        });

        pagination.appendChild(prev);

        getPageItems(totalPages, currentPage).forEach(item => {
          if (item === 'ellipsis') {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'page-ellipsis';
            ellipsis.textContent = '…';
            pagination.appendChild(ellipsis);
            return;
          }

          const button = document.createElement('button');
          button.className = `page-btn ${item === currentPage ? 'active' : ''}`;
          button.textContent = String(item);
          button.setAttribute('aria-label', `Page ${item}`);

          if (item === currentPage) button.setAttribute('aria-current', 'page');

          button.addEventListener('click', () => {
            currentPage = item;
            render();
            scrollToPlayers();
          });

          pagination.appendChild(button);
        });

        const next = createPageButton('›', 'Next page', currentPage === totalPages, () => {
          if (currentPage >= totalPages) return;
          currentPage++;
          render();
          scrollToPlayers();
        });

        pagination.appendChild(next);

        if (focusedLabel) {
          const target =
            Array.from(pagination.querySelectorAll('button'))
              .find(button =>
                button.getAttribute('aria-label') === focusedLabel &&
                !button.disabled
              ) ||
            pagination.querySelector('[aria-current="page"]');

          target?.focus({ preventScroll: true });
        }
      }

      function render() {
        const visible = getVisibleRows();
        sortRows(visible);

        rows.forEach(row => {
          row.style.display = 'none';
          tbody.appendChild(row);
        });

        const totalPages = Math.ceil(visible.length / perPage);

        if (totalPages > 0 && currentPage > totalPages) {
          currentPage = 1;
        }

        const start = (currentPage - 1) * perPage;
        const end = start + perPage;

        visible.slice(start, end).forEach((row, index) => {
          row.style.display = '';

          const rank = row.querySelector('.rank-number');
          if (rank) {
            rank.textContent = String(start + index + 1).padStart(2, '0');
          }

          tbody.appendChild(row);
        });

        noResults.style.display = visible.length === 0 ? 'block' : 'none';

        playerCount.textContent = visible.length
          ? `SHOWING ${start + 1}–${Math.min(end, visible.length)} OF ${visible.length} ${visible.length === 1 ? 'PLAYER' : 'PLAYERS'}`
          : '0 PLAYERS';

        updateSortContext();
        renderPagination(totalPages);
      }

      headers.forEach(header => {
        header.querySelector('button').addEventListener('click', () => {
          const key = header.dataset.key;
          isNumeric = header.dataset.numeric === 'true';

          if (sortKey === key) {
            sortDir = sortDir === 'asc' ? 'desc' : 'asc';
          } else {
            sortKey = key;
            sortDir = isNumeric ? 'desc' : 'asc';
          }

          currentPage = 1;
          updateSortHeader();
          render();
        });
      });

      searchInput.addEventListener('input', () => {
        currentPage = 1;
        render();
      });

      teamFilter.addEventListener('change', () => {
        currentPage = 1;
        render();
      });

      window.matchMedia('(max-width: 640px)').addEventListener('change', render);

      updateSortHeader();
      render();
    });
  </script>
</Layout>

<style>
  :global(body:has(.players-page)) {
    --bg-primary: #090a0c;
    --bg-secondary: #101114;
    --bg-card: #16171b;
    --bg-card-hover: #202126;
    --border: #303137;
    --text-primary: #f4f3ef;
    --text-secondary: #c4c3bf;
    --text-muted: #a4a6ac;
    --players-display: 'DIN Condensed', 'Arial Narrow', 'Avenir Next Condensed', sans-serif;
  }

  :global(body:has(.players-page) .site-header) {
    background: #0c0d0f;
    backdrop-filter: none;
  }

  :global(body:has(.players-page) .site-header .nav a) {
    font-family: var(--players-display);
    font-size: 17px;
    font-weight: 500;
  }

  .players-page {
    max-width: 1344px;
    padding: 0 32px 32px;
    font-family: 'Arial Narrow', 'Avenir Next Condensed', sans-serif;
  }

  .players-page .page-header {
    background: none;
    padding: 34px 0 18px;
    margin-bottom: 0px;
  }

  .players-page .page-header h1 {
    font-family: var(--players-display);
    font-size: clamp(44px, 6vw, 68px);
    text-transform: uppercase;
  }

  .players-page .page-header p {
    font-size: 17px;
  }

  /* Summary */

  .players-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-bottom: 24px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .summary-stat {
    position: relative;
    min-width: 0;
    padding: 19px 26px 18px;
    border-right: 1px solid var(--border);
    overflow: hidden;
  }

  .summary-stat:last-child {
    border-right: 0;
  }

  .summary-stat::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--leader-color, var(--accent));
    opacity: .8;
  }

  .summary-total::before {
    background: var(--accent);
  }

  .summary-stat strong {
    display: block;
    margin-bottom: 7px;
    color: var(--text-primary);
    font-family: var(--players-display);
    font-size: 42px;
    font-weight: 700;
    line-height: .95;
    font-variant-numeric: tabular-nums;
  }

  .summary-stat:not(.summary-total) strong {
    color: var(--accent);
  }

  .summary-stat span {
    display: block;
    color: var(--text-secondary);
    font-family: var(--players-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: .035em;
    text-transform: uppercase;
  }

  .summary-stat small {
    display: block;
    margin-top: 4px;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .summary-stat small a {
    color: inherit;
    text-decoration: none;
  }

  .summary-stat small a:hover {
    color: var(--leader-color, var(--accent));
  }

  /* Toolbar */

  .players-toolbar {
    display: flex;
    gap: 12px;
  }

  .search-wrap {
    position: relative;
    display: flex;
    flex: 1;
    min-width: 0;
  }

  .search-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 20px;
    pointer-events: none;
  }

  .players-page :is(.players-search, .players-filter) {
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font: inherit;
    font-size: 16px;
  }

  .players-search {
    width: 100%;
    padding-left: 44px !important;
  }

  .players-filter {
    width: 250px;
    cursor: pointer;
  }

  .players-page :is(input, select, a, button):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Context */

  .table-context {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 20px 0 12px;
    color: var(--text-muted);
    font-family: var(--players-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .table-context p {
    margin: 0;
  }

  .sort-context {
    margin-left: auto !important;
    color: var(--accent);
  }

  .table-scroll-hint {
    display: none;
  }

  /* Table */

  .players-page .players-table-wrap {
    border: 1px solid var(--border);
    border-radius: 0;
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .players-table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
    font-size: 17px;
    font-variant-numeric: tabular-nums;
  }

  .players-page .players-table th {
    padding: 4px 16px;
    background: #1b1c20;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 13px;
  }

  .players-page .players-table td {
    padding: 11px 16px;
    background: var(--bg-secondary);
    border-bottom: 1px solid #25262b;
    vertical-align: middle;
  }

  .players-page .players-table tr:nth-child(even) td {
    background: #141518;
  }

  .players-page .players-table tr:hover td {
    background: var(--bg-card-hover);
  }

  .players-page .players-table tr:last-child td {
    border-bottom: 0;
  }

  .players-table :is(th, td):nth-child(n+4) {
    text-align: right;
  }

  .players-table td:nth-child(4) {
    font-weight: 700;
  }

  /* Rank */

  .rank-heading {
    width: 60px;
    text-align: center !important;
  }

  .rank-cell {
    position: relative;
    width: 60px;
    padding-inline: 12px !important;
    text-align: center !important;
  }

  .rank-cell::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    background: var(--team-color);
  }

  .rank-number {
    color: var(--text-primary);
    font-family: var(--players-display);
    font-size: 20px;
    font-weight: 600;
  }

  /* Player */

  .player-column {
    min-width: 210px;
  }

  .player-cell {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 42px;
    color: var(--text-primary);
    text-decoration: none;
  }

  .player-avatar-wrap {
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    overflow: hidden;
    background: #202126;
  }

  .player-avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .player-cell strong {
    font-weight: 700;
  }

  .player-cell:hover {
    color: var(--accent);
  }

  /* Team + stats */

  .team-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .team-link img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .team-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .players-page .players-table .kda span {
    color: var(--text-primary);
  }

  .players-page .players-table .kd-positive {
    color: #83b596;
