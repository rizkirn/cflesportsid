---
import { getFrontendMatches } from '../../data-access/frontend-matches';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getAssetCollection as getCollection } from '../../data-access/frontend-assets';
import { resolveAsset, assetErrorHandler } from '../../utils/assets.mjs';
import { statisticalProfiles, statisticalPlayerKey, playerContinuitySplits, historicalPlayerKey } from '../../utils/player-continuity.mjs';
import {
  calculateStatistics,
  emptyStats,
  kdRatio
} from '../../utils/statistics';

import {
  getRoundName,
  getParticipantLabel
} from '../../utils/tournament';

import {
  getTournamentMap,
  getMapMap,
  getMatchTournamentId,
  getMatchTeam1Id,
  getMatchTeam2Id,
  getRoundMapId,
} from '../../utils/content';

const allPlayers = await getCollection('players');
const profiles = statisticalProfiles(allPlayers);
const player = profiles.find(entry => entry.id === Astro.params.id);
if (!player) return new Response(null, { status: 404 });
const split = playerContinuitySplits.find(s => s.uid === player.data.uid);
const otherSegment = split ? profiles.find(p => p.id === (player.id === split.uid ? historicalPlayerKey(split) : split.uid)) : undefined;
const isHistoricalSegment = Boolean(split && player.id !== split.uid);

const allTeams = await getCollection('teams');
const allMatches = await getFrontendMatches();

const teamsMap = new Map(
  allTeams.map(t => [t.id, t])
);

const team = player.data.team
  ? teamsMap.get(player.data.team)
  : undefined;

const teammates = team && !isHistoricalSegment
  ? allPlayers.filter(
      p =>
        p.id !== player.id &&
        team.data.players.includes(p.id)
    )
  : [];

const tournamentsMap = await getTournamentMap();
const mapsMap = await getMapMap();

const playerMatches = allMatches
  .filter(
    m =>
      m.data.status === 'completed' &&
      m.data.playerStats &&
      m.data.playerStats.some(
        ps => ps.uid && statisticalPlayerKey(ps.uid, m.data.tournamentId) === player.id
      )
  )
  .sort(
    (a, b) =>
      b.data.date.localeCompare(a.data.date) ||
      b.id.localeCompare(a.id)
  );

const careerStats =
  calculateStatistics(allMatches).players.get(
    player.id
  ) ?? emptyStats();

const matchesPlayed = careerStats.matchesPlayed;
const kd = kdRatio(careerStats).toFixed(2);
const mvpCount = careerStats.mvpCount;

const hasSocials =
  player.data.socials &&
  Object.values(player.data.socials).some(v => v);

const playerStatus =
  player.data.status === 'inactive'
    ? 'inactive'
    : 'active';

const mvpMatches = [];

playerMatches.forEach(m => {
  const roundDetails =
    m.data.roundDetails || [];

  const mvpsThisMatch =
    roundDetails.filter(
      rd => rd.mvp === player.data.uid
    );

  if (mvpsThisMatch.length > 0) {
    mvpMatches.push({
      match: m,

      mvpRounds: mvpsThisMatch.map(
        rd => rd.round_number
      ),

      maps: mvpsThisMatch.map(
        rd =>
          mapsMap.get(
            getRoundMapId(rd)
          )?.data.name ?? 'TBD'
      ),
    });
  }
});
---

<Layout
  title={`${player.data.ign} - CFL Tournament Hub`}
  current="Players"
>
  <div class="container player-detail" style={`--team-color: ${team?.data.color ?? '#777B82'};`}>
    <a class="back-to-players" href="/players"><span aria-hidden="true">←</span> All players</a>

    <!-- PLAYER HERO -->

    <section
      class="profile-banner"
      aria-label="Player overview"
    >
      <div class="profile-identity">

        <img
          class="profile-image"
          src={
            resolveAsset('players', player).src
          }
          alt={`${player.data.ign} photo`}
          width="160"
          height="160"
          onerror={assetErrorHandler('players',player)}
        />

        <div class="profile-info">
          {otherSegment && <p><a href={`/players/${otherSegment.id}/`}>View {otherSegment.data.ign} account history</a></p>}

          <p class="profile-kicker">
            {team ? (
              <a href={`/teams/${team.id}`}>
                {team.data.name} ({team.data.tag})
              </a>
            ) : (
              'No current team'
            )}
          </p>

          <h1>{player.data.ign}</h1>

          <p class="profile-subtitle">
            <span
              class:list={[
                'player-status',
                playerStatus === 'inactive'
                  ? 'player-status-inactive'
                  : 'player-status-active'
              ]}
            >
              {isHistoricalSegment ? 'Historical' : playerStatus === 'inactive'
                ? 'Inactive'
                : 'Active'}
            </span>
          </p>

        </div>
      </div>

      <dl class="profile-metrics">

        <div>
          <dt>Matches played</dt>
          <dd>{matchesPlayed}</dd>
        </div>

        <div>
          <dt>Total kills</dt>
          <dd>{careerStats.kills}</dd>
        </div>

        <div>
          <dt>K/D ratio</dt>
          <dd>{kd}</dd>
        </div>

        <div>
          <dt>MVP awards</dt>
          <dd>{mvpCount}</dd>
        </div>

      </dl>
    </section>


    <!-- BIO -->

    {player.data.bio && (
      <p class="player-description">
        {player.data.bio}
      </p>
    )}


    <!-- SOCIALS -->

    {hasSocials && (
      <section class="section-spacing">

        <h2 class="section-title">
          Socials
        </h2>

        <div class="socials-list">

          {player.data.socials?.discord && (
            <span class="badge badge-discord">
              Discord: {player.data.socials.discord}
            </span>
          )}

          {player.data.socials?.youtube && (
            <a
              href={`https://youtube.com/${player.data.socials.youtube}`}
              target="_blank"
              rel="noopener noreferrer"
              class="badge badge-youtube"
            >
              YouTube
            </a>
          )}

          {player.data.socials?.twitch && (
            <a
              href={`https://twitch.tv/${player.data.socials.twitch}`}
              target="_blank"
              rel="noopener noreferrer"
              class="badge badge-twitch"
            >
              Twitch
            </a>
          )}

        </div>
      </section>
    )}


    <!-- MVP AWARDS -->

    {mvpMatches.length > 0 && (
      <section class="section-spacing">

        <h2 class="section-title">
          MVP Awards
        </h2>

        <p class="table-scroll-hint">
          Swipe to view full MVP history →
        </p>

        <div
          class="table-wrap player-table-wrap"
          tabindex="0"
          role="region"
          aria-label="Player MVP awards"
        >
          <table class="match-history-table player-mvp-table">

            <thead>
              <tr>
                <th>Date</th>
                <th>Tournament</th>
                <th>Round</th>
                <th>Match</th>
                <th>MVP Rounds</th>
              </tr>
            </thead>

            <tbody>

              {mvpMatches.map(
                ({ match: m, mvpRounds, maps }) => {

                  const team1Id =
                    getMatchTeam1Id(m);

                  const team2Id =
                    getMatchTeam2Id(m);

                  const t1 = team1Id
                    ? teamsMap.get(team1Id)
                    : undefined;

                  const t2 = team2Id
                    ? teamsMap.get(team2Id)
                    : undefined;

                  const matchName =
                    `${
                      t1?.data.name ??
                      team1Id ??
                      getParticipantLabel(m, 1)
                    } vs ${
                      t2?.data.name ??
                      team2Id ??
                      getParticipantLabel(m, 2)
                    }`;

                  const tournamentId =
                    getMatchTournamentId(m);

                  const tournament =
                    tournamentId
                      ? tournamentsMap.get(
                          tournamentId
                        )
                      : undefined;

                  const tournamentName =
                    tournament?.data.name ??
                    tournamentId ??
                    'TBD';

                  return (
                    <tr>

                      <td>
                        {m.data.date}
                      </td>

                      <td>
                        {tournament ? (
                          <a
                            href={`/tournament/${tournament.id}`}
                            class="match-link"
                          >
                            {tournamentName}
                          </a>
                        ) : (
                          tournamentName
                        )}
                      </td>

                      <td>
                        {getRoundName(
                          m,
                          tournamentsMap
                        )}
                      </td>

                      <td>
                        <a
                          href={`/matches/${m.id}`}
                          class="match-link"
                        >
                          {matchName}
                        </a>
                      </td>

                      <td>
                        <div class="mvp-rounds">

                          {mvpRounds.map(
                            (rn, i) => (
                              <span class="badge badge-completed">
                                R{rn} — {maps[i] || ''}
                              </span>
                            )
                          )}

                        </div>
                      </td>

                    </tr>
                  );
                }
              )}

            </tbody>
          </table>
        </div>
      </section>
    )}


    {playerMatches.length === 0 && (
      <section class="section-spacing">
        <h2 class="section-title">Recent matches</h2>
        <p class="player-empty">No recorded matches yet.</p>
      </section>
    )}

    <!-- RECENT MATCHES -->

    {playerMatches.length > 0 && (
      <section class="section-spacing">

        <h2 class="section-title">
          Recent Matches
        </h2>

        <p class="table-scroll-hint">
          Swipe to view full match history →
        </p>

        <div
          class="table-wrap player-table-wrap"
          tabindex="0"
          role="region"
          aria-label="Player recent matches"
        >
          <table class="match-history-table player-match-table">

            <thead>
              <tr>
                <th>Date</th>
                <th>Tournament</th>
                <th>Round</th>
                <th>Match</th>
                <th>K/D/A</th>
              </tr>
            </thead>

            <tbody>

              {playerMatches
                .slice(0, 10)
                .map(m => {

                  const team1Id =
                    getMatchTeam1Id(m);

                  const team2Id =
                    getMatchTeam2Id(m);

                  const t1 = team1Id
                    ? teamsMap.get(team1Id)
                    : undefined;

                  const t2 = team2Id
                    ? teamsMap.get(team2Id)
                    : undefined;

                  const matchName =
                    `${
                      t1?.data.name ??
                      team1Id ??
                      getParticipantLabel(m, 1)
                    } vs ${
                      t2?.data.name ??
                      team2Id ??
                      getParticipantLabel(m, 2)
                    }`;

                  const ps =
                    m.data.playerStats.find(
                      ps =>
                        ps.uid ===
                        player.data.uid
                    );

                  const tournamentId =
                    getMatchTournamentId(m);

                  const tournament =
                    tournamentId
                      ? tournamentsMap.get(
                          tournamentId
                        )
                      : undefined;

                  const tournamentName =
                    tournament?.data.name ??
                    tournamentId ??
                    'TBD';

                  let pKills = 0;
                  let pDeaths = 0;
                  let pAssists = 0;

                  if (ps && ps.rounds) {
                    ps.rounds.forEach(r => {
                      pKills += r.kills || 0;
                      pDeaths += r.deaths || 0;
                      pAssists += r.assists || 0;
                    });
                  }

                  const wonMVP =
                    (
                      m.data.roundDetails || []
                    ).some(
                      rd =>
                        rd.mvp ===
                        player.data.uid
                    );

                  return (
                    <tr>

                      <td>
                        {m.data.date}
                      </td>

                      <td>
                        {tournament ? (
                          <a
                            href={`/tournament/${tournament.id}`}
                            class="match-link"
                          >
                            {tournamentName}
                          </a>
                        ) : (
                          tournamentName
                        )}
                      </td>

                      <td>
                        {getRoundName(
                          m,
                          tournamentsMap
                        )}
                      </td>

                      <td>
                        <a
                          href={`/matches/${m.id}`}
                          class="match-link"
                        >
                          {matchName}
                        </a>
                      </td>

                      <td>
                        <div class="match-kda">

                          <span class="kda">
                            <span class="kill">
                              {pKills}
                            </span>
                            {' / '}
                            <span class="death">
                              {pDeaths}
                            </span>
                            {' / '}
                            <span class="assist">
                              {pAssists}
                            </span>
                          </span>

                          {wonMVP && (
                            <span class="badge badge-completed">
                              MVP
                            </span>
                          )}

                        </div>
                      </td>

                    </tr>
                  );
                })}

            </tbody>
          </table>
        </div>
      </section>
    )}


    <!-- TEAMMATES -->
    <!-- Reuses roster styles from interior.css -->

    {teammates.length > 0 && (
      <section class="section-spacing">

        <h2 class="section-title">
          Teammates
        </h2>

        <div class="roster-detail-grid">

          {teammates.map(p => (
            <a
              href={`/players/${p.id}`}
              class="roster-card"
            >

              <img
                class="avatar"
                src={
                  resolveAsset('players', p).src
                }
                alt={`${p.data.ign} photo`}
                width="40"
                height="40"
                loading="lazy"
                onerror={assetErrorHandler('players',p)}
              />

              <div class="roster-card-info">

                <strong>
                  {p.data.ign}
                </strong>

                <span>
                  {p.data.role || 'Player'}
                </span>

              </div>

              <span
                class={`badge ${
                  p.data.status === 'inactive'
                    ? 'badge-upcoming'
                    : 'badge-completed'
                }`}
              >
                {p.data.status === 'inactive'
                  ? 'Inactive'
                  : 'Active'}
              </span>

            </a>
          ))}

        </div>
      </section>
    )}

  </div>
</Layout>


<style>
  /* =========================
     PLAYER DESCRIPTION
     ========================= */

  .player-description {
    max-width: 700px;
    margin-bottom: 2rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }


  /* =========================
     PROFILE
     ========================= */

  .profile-kicker a {
    color: inherit;
    text-decoration: none;
    transition: color .18s;
  }

  .profile-kicker a:hover {
    color: var(--accent);
  }

  .player-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 26px;
    padding: 0 11px;
    border: 1px solid;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .player-status-active {
    color: #22c55e;
    background: rgba(34, 197, 94, .08);
    border-color: rgba(34, 197, 94, .32);
  }

  .player-status-inactive {
    color: var(--text-muted);
    background: rgba(255, 255, 255, .035);
    border-color: var(--border);
  }


  /* =========================
     PLAYER-SPECIFIC SECTIONS
     ========================= */

  .player-description {
    color: var(--text-secondary);
  }


  /* =========================
     SOCIALS
     ========================= */

  .socials-list {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
  }

  .badge-discord {
    color: white;
    background: #5865f2;
  }

  .badge-youtube {
    color: white;
    background: #ff0000;
    text-decoration: none;
  }

  .badge-twitch {
    color: white;
    background: #9146ff;
    text-decoration: none;
  }

  .badge-youtube:hover,
  .badge-twitch:hover {
    opacity: .9;
  }


  /* =========================
     TABLE CONTENT
     ========================= */

  .match-link {
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
    transition: color .18s;
  }

  .match-link:hover {
    color: var(--accent);
  }

  .mvp-rounds {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
  }

  .match-kda {
    display: flex;
    align-items: center;
    gap: .5rem;
    white-space: nowrap;
  }


  /* =========================
     SWIPE HINT
     ========================= */

  .table-scroll-hint {
    display: none !important;
  }


  /* =========================
     MOBILE TABLES
     ========================= */

  @media (max-width: 640px) {

    .table-scroll-hint {
      display: block !important;
      margin: -4px 0 10px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
      text-align: right;
    }

    .player-table-wrap {
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .player-table-wrap table {
      table-layout: auto;
    }

    .player-table-wrap th,
    .player-table-wrap td {
      padding: 14px 12px;
      white-space: nowrap;
    }


    /* MVP AWARDS */

    .player-mvp-table {
      width: 900px;
      min-width: 900px;
    }

    .player-mvp-table th:nth-child(1),
    .player-mvp-table td:nth-child(1) {
      width: 110px;
      min-width: 110px;
    }

    .player-mvp-table th:nth-child(2),
    .player-mvp-table td:nth-child(2) {
      width: 240px;
      min-width: 240px;
    }

    .player-mvp-table th:nth-child(3),
    .player-mvp-table td:nth-child(3) {
      width: 120px;
      min-width: 120px;
    }

    .player-mvp-table th:nth-child(4),
    .player-mvp-table td:nth-child(4) {
      width: 230px;
      min-width: 230px;
    }

    .player-mvp-table th:nth-child(5),
    .player-mvp-table td:nth-child(5) {
      width: 200px;
      min-width: 200px;
    }


    /* RECENT MATCHES */

    .player-match-table {
      width: 850px;
      min-width: 850px;
    }

    .player-match-table th:nth-child(1),
    .player-match-table td:nth-child(1) {
      width: 110px;
      min-width: 110px;
    }

    .player-match-table th:nth-child(2),
    .player-match-table td:nth-child(2) {
      width: 240px;
      min-width: 240px;
    }

    .player-match-table th:nth-child(3),
    .player-match-table td:nth-child(3) {
      width: 120px;
      min-width: 120px;
    }

    .player-match-table th:nth-child(4),
    .player-match-table td:nth-child(4) {
      width: 230px;
      min-width: 230px;
    }

    .player-match-table th:nth-child(5),
    .player-match-table td:nth-child(5) {
      width: 150px;
      min-width: 150px;
    }
  }

  :global(body:has(.player-detail)) {
    --bg-primary: #090a0c;
    --bg-secondary: #101114;
    --bg-card: #16171b;
    --bg-card-hover: #202126;
    --border: #303137;
    --text-primary: #f4f3ef;
    --text-secondary: #c4c3bf;
    --text-muted: #a4a6ac;
    --player-display: 'DIN Condensed', 'Arial Narrow', 'Avenir Next Condensed', sans-serif;
  }
  :global(body:has(.player-detail) .site-header) { background: #0c0d0f; backdrop-filter: none; }
  :global(body:has(.player-detail) .site-header .nav a) { font-family: var(--player-display); font-size: 17px; font-weight: 500; }
  .player-detail { max-width: 1344px; padding: 20px 32px 32px; font-family: 'Arial Narrow', 'Avenir Next Condensed', sans-serif; }
  .back-to-players { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--text-secondary); text-transform: uppercase; font-size: 14px; }
  .player-detail .profile-banner { position: relative; isolation: isolate; margin: 10px 0 28px; padding: 32px; background: #141518; border: 1px solid var(--border); border-radius: 0; gap: 28px; }
  .player-detail .profile-banner::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--team-color); mask: url('/patterns/team-card.svg') center / 100% 100% no-repeat; -webkit-mask: url('/patterns/team-card.svg') center / 100% 100% no-repeat; opacity: .23; pointer-events: none; }
  .player-detail .profile-identity { gap: 24px; }
  .player-detail .profile-image { width: 120px; height: 140px; object-fit: contain; border-radius: 0; background: transparent; }
  .player-detail .profile-identity h1 { font-family: var(--player-display); font-size: clamp(36px,4.5vw,60px); letter-spacing: .01em; margin-bottom: 12px; }
  .player-detail .profile-kicker { font-size: 14px; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 10px; }
  .player-detail .profile-metrics { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px 24px; width: 310px; padding: 20px 24px; border-radius: 0; background: #101114e8; }
  .player-detail .profile-metrics div { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 0; border: 0; }
  .player-detail .profile-metrics dt { font-size: 12px; font-weight: 400; text-transform: uppercase; color: var(--text-secondary); }
  .player-detail .profile-metrics dd { font-family: var(--player-display); font-size: 34px; line-height: 1; color: var(--text-primary); }
  .player-detail .profile-metrics div:last-child dd { color: var(--accent); }
  .player-detail .player-status { border-radius: 0; font-weight: 600; }
  .player-detail .section-spacing { margin-bottom: 28px; }
  .player-detail .section-title { font-family: var(--player-display); font-size: 30px; line-height: 1.1; text-transform: uppercase; padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 14px; }
  .player-detail .player-table-wrap { border-radius: 0; overflow-x: auto; margin-bottom: 0; }
  .player-detail table { min-width: 800px; font-size: 16px; font-variant-numeric: tabular-nums; }
  .player-detail table th { background: #1b1c20; color: var(--text-secondary); font-size: 12px; border-bottom: 1px solid var(--border); }
  .player-detail table td { padding: 16px; background: #101114; }
  .player-detail table tr:nth-child(even) td { background: #141518; }
  .player-detail table td:first-child { white-space: nowrap; }
  .player-detail .match-link { font-weight: 400; }
  .player-detail .badge { border-radius: 0; }
  .player-detail .roster-detail-grid { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
  .player-detail .roster-card { border-radius: 0; background: #141518; padding: 14px; gap: 12px; }
  .player-detail .roster-card .avatar { width: 42px; height: 50px; border-radius: 0; background: transparent; object-fit: contain; }
  .player-detail .roster-card-info strong { font-size: 18px; }
  .player-detail .roster-card-info span { font-size: 13px; }
  .player-detail .roster-card .badge { font-size: 10px; padding: 3px 6px; }
  .player-detail .socials-list .badge { background: #16171b; border: 1px solid var(--border); color: var(--text-primary); min-height: 44px; display: inline-flex; align-items: center; padding: 8px 14px; overflow-wrap: anywhere; }
  .player-empty { color: var(--text-secondary); padding: 16px 0; }
  .player-detail a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media(max-width:1000px) {
    .player-detail .profile-banner { padding: 24px; gap: 20px; }
