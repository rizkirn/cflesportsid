---
import { getFrontendMatches } from '../../data-access/frontend-matches';
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import {
  calculateStatistics,
  emptyMapStats,
  kdRatio
} from '../../utils/statistics';
import { getRoundName } from '../../utils/tournament';

const map = (await getCollection('maps')).find(entry => entry.id === Astro.params.id);
if (!map) return new Response(null, { status: 404 });

const matches = await getFrontendMatches();
const calculated = calculateStatistics(matches);
const stats =
  calculated.maps.get(map.id) ?? emptyMapStats();

const players = new Map(
  (await getCollection('players')).map(p => [
    p.data.uid || p.id,
    p
  ])
);

const teams = new Map(
  (await getCollection('teams')).map(t => [
    t.id,
    t
  ])
);

const tournaments = new Map(
  (await getCollection('tournaments')).map(t => [
    t.id,
    t
  ])
);

const topPlayers = [...stats.players].sort(
  (a, b) =>
    b[1].kills - a[1].kills ||
    a[0].localeCompare(b[0])
);

const teamStats = [...stats.teams].sort(
  (a, b) =>
    b[1].kills - a[1].kills ||
    a[0].localeCompare(b[0])
);

const frequentTeams = [...teamStats].sort(
  (a, b) =>
    b[1].mapsPlayed - a[1].mapsPlayed
);

const mostPlayed =
  frequentTeams[0]?.[1].mapsPlayed;

const favoriteTeams = frequentTeams.filter(
  ([, s]) => s.mapsPlayed === mostPlayed
);

const mostKills =
  topPlayers[0]?.[1].kills;

const leadingPlayers = topPlayers.filter(
  ([, s]) => s.kills === mostKills
);

const bestAssists = Math.max(
  0,
  ...topPlayers.map(([, s]) => s.assists)
);

const assistLeaders = topPlayers.filter(
  ([, s]) => s.assists === bestAssists
);

const mapKda = s =>
  (s.kills + s.assists) /
  Math.max(s.deaths, 1);

const bestKda = Math.max(
  0,
  ...topPlayers.map(([, s]) => mapKda(s))
);

const kdaLeaders = topPlayers.filter(
  ([, s]) => mapKda(s) === bestKda
);

const mapMatches = matches
  .filter(
    m =>
      m.data.status === 'completed' &&
      m.data.roundDetails.some(
        rd => rd.mapId === map.id
      )
  )
  .sort(
    (a, b) =>
      b.data.date.localeCompare(a.data.date) ||
      b.id.localeCompare(a.id)
  );
---

<Layout
  title={`${map.data.name} Statistics - CFL Esports ID`}
  current="Maps"
>
  <div class="container map-detail-page">
    <a class="back-to-maps" href="/maps"><span aria-hidden="true">←</span> All maps</a>

    <!-- MAP HERO -->

    <section class="map-detail-hero">
      <img
        class="map-hero-image"
        src={`/maps/${map.id}.webp`}
        alt={`${map.data.name} map`}
        width="1600"
        height="720"
        onerror="this.onerror=null;this.src='/maps/placeholder.svg'"
      />

      <div class="map-hero-overlay"></div>

      <div class="map-hero-content">
        <div class="map-hero-heading">
          <span class="map-hero-eyebrow">
            CROSSFIRE: LEGENDS · INDONESIA
          </span>

          <h1>{map.data.name}</h1>

          <p>
            Map statistics from completed matches
          </p>
        </div>

        <div class="map-hero-stats">
          <div class="map-hero-stat">
            <strong>{stats.matchesPlayed}</strong>
            <span>Matches</span>
          </div>

          <div class="map-hero-stat">
            <strong>{stats.kills}</strong>
            <span>Total Kills</span>
          </div>

          <div class="map-hero-stat">
            <strong>{stats.deaths}</strong>
            <span>Total Deaths</span>
          </div>

          <div class="map-hero-stat">
            <strong>{stats.assists}</strong>
            <span>Total Assists</span>
          </div>
        </div>
      </div>
    </section>

    <!-- MAP LEADERS -->

    {stats.mapsPlayed > 0 && <div class="stat-grid map-leaders section">
      <article class="stat-box">
        <h2>Most played by</h2>

        {favoriteTeams.map(([id, s]) => (
          <p>
            <a href={`/teams/${id}`}>
              {teams.get(id)?.data.name ?? id}
            </a>
            {' · '}
            {s.mapsPlayed} matches
          </p>
        ))}

        {!favoriteTeams.length && (
          <p>No matches yet</p>
        )}
      </article>

      <article class="stat-box">
        <h2>Top Fragger</h2>

        {leadingPlayers.map(([uid, s]) => {
          const player = players.get(uid);

          return (
            <div class="map-player-leader">
              <img
                src={
                  player?.data.avatar ||
                  (uid ? `/players/${uid}.webp` : '/players/default.webp')
                }
                alt=""
                width="54"
                height="62"
                loading="lazy"
                onerror="this.onerror=null;this.src='/players/default.webp'"
              />
              <p>
                <a href={`/players/${player?.id ?? uid}`}>
                  {player?.data.ign ?? uid}
                </a>
                <span>{s.kills} kills</span>
              </p>
            </div>
          );
        })}

        {!leadingPlayers.length && (
          <p>No recorded stats</p>
        )}
      </article>

      <article class="stat-box">
        <h2>Top Assists</h2>

        {assistLeaders.map(([uid, s]) => {
          const player = players.get(uid);

          return (
            <div class="map-player-leader">
              <img
                src={
                  player?.data.avatar ||
                  (uid ? `/players/${uid}.webp` : '/players/default.webp')
                }
                alt=""
                width="54"
                height="62"
                loading="lazy"
                onerror="this.onerror=null;this.src='/players/default.webp'"
              />
              <p>
                <a href={`/players/${player?.id ?? uid}`}>
                  {player?.data.ign ?? uid}
                </a>
                <span>{s.assists} assists</span>
              </p>
            </div>
          );
        })}

        {!assistLeaders.length && (
          <p>No recorded stats</p>
        )}
      </article>

      <article class="stat-box">
        <h2>Best KDA</h2>

        {kdaLeaders.map(([uid, s]) => {
          const player = players.get(uid);

          return (
            <div class="map-player-leader">
              <img
                src={
                  player?.data.avatar ||
                  (uid ? `/players/${uid}.webp` : '/players/default.webp')
                }
                alt=""
                width="54"
                height="62"
                loading="lazy"
                onerror="this.onerror=null;this.src='/players/default.webp'"
              />
              <p>
                <a href={`/players/${player?.id ?? uid}`}>
                  {player?.data.ign ?? uid}
                </a>
                <span>{mapKda(s).toFixed(2)} KDA</span>
              </p>
            </div>
          );
        })}

        {!kdaLeaders.length && (
          <p>No recorded stats</p>
        )}
      </article>
    </div>}

    {stats.mapsPlayed === 0 ? (
      <p class="section">
        No completed matches recorded on this map yet.
      </p>
    ) : (
      <>
        <p class="coverage">
          {`Winners are known for ${stats.knownResults} of ${stats.mapsPlayed} recorded map results. Win rates use only those known results.`}
        </p>
        <details class="map-methodology">
          <summary>How map statistics are calculated</summary>
          <div>
            <p>KDA is kills plus assists, divided by deaths. When deaths are zero, we divide by 1.</p>
            <p>Kills, deaths, and assists include only entries assigned to this map. A dash means the map number is unknown or the player did not play that map.</p>
            <p>A map winner is counted when explicitly recorded or determined by a 3–0 sweep. Split match scores alone do not identify individual map winners.</p>
          </div>
        </details>

        <!-- TABS -->

        <div
          class="map-tabs"
          role="tablist"
          aria-label="Map statistics"
        >
          <button
            id="tab-players"
            role="tab"
            aria-selected="true"
            aria-controls="panel-players"
            tabindex="0"
          >
            Player Statistics
          </button>

          <button
            id="tab-teams"
            role="tab"
            aria-selected="false"
            aria-controls="panel-teams"
            tabindex="-1"
          >
            Team Statistics
          </button>

          <button
            id="tab-matches"
            role="tab"
            aria-selected="false"
            aria-controls="panel-matches"
            tabindex="-1"
          >
            Match History
          </button>
        </div>

        <!-- PLAYER STATISTICS -->

        <section
          id="panel-players"
          role="tabpanel"
          aria-labelledby="tab-players"
          class="section paginated-panel"
          data-page-size="15"
        >
          <h2>Player Statistics</h2>

          <p class="mobile-table-hint">
            Swipe to view all stats →
          </p>

          <div
            class="table-wrap map-table-wrap"
            tabindex="0"
            role="region"
            aria-label="Player statistics table"
          >
            <table
              class="sortable-map-table"
              data-paginated-table
            >
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Recorded Maps</th>
                  <th>Kills</th>
                  <th>Deaths</th>
                  <th>Assists</th>
                  <th>K/D</th>
                  <th>MVP Awards</th>
                </tr>
              </thead>

              <tbody>
                {topPlayers.map(([uid, s]) => {
                  const player = players.get(uid);

                  return (
                    <tr>
                      <td>
                        {player ? (
                          <a href={`/players/${player.id}`}>
                            {player.data.ign}
                          </a>
                        ) : (
                          uid
                        )}
                      </td>

                      <td>{s.mapsPlayed}</td>

                      <td>
                        {s.mapsPlayed ? s.kills : '—'}
                      </td>

                      <td>
                        {s.mapsPlayed ? s.deaths : '—'}
                      </td>

                      <td>
                        {s.mapsPlayed ? s.assists : '—'}
                      </td>

                      <td>
                        {s.mapsPlayed
                          ? kdRatio(s).toFixed(2)
                          : '—'}
                      </td>

                      <td>{s.mvpCount}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <nav
            class="table-pagination"
            data-pagination
            aria-label="Player statistics pages"
          ></nav>
        </section>

        <!-- TEAM STATISTICS -->

        <section
          id="panel-teams"
          role="tabpanel"
          aria-labelledby="tab-teams"
          class="section"
          hidden
        >
          <h2>Team Statistics</h2>

          <p class="mobile-table-hint">
            Swipe to view all stats →
          </p>

          <div
            class="table-wrap map-table-wrap"
            tabindex="0"
            role="region"
            aria-label="Team statistics table"
          >
            <table class="sortable-map-table">
              <thead>
                <tr>
                  <th>Team</th>
                  <th>Matches</th>
                  <th>Recorded Kills</th>
                  <th>Recorded Deaths</th>
                  <th>Recorded Assists</th>
                  <th>Known Wins</th>
                  <th>Known Losses</th>
                  <th>Win Rate (Known Results)</th>
                </tr>
              </thead>

              <tbody>
                {teamStats.map(([id, s]) => (
                  <tr>
                    <td>
                      <a href={`/teams/${id}`}>
                        {teams.get(id)?.data.name ?? id}
                      </a>
                    </td>

                    <td>{s.mapsPlayed}</td>
                    <td>{s.kills}</td>
                    <td>{s.deaths}</td>
                    <td>{s.assists}</td>
                    <td>{s.wins}</td>
                    <td>{s.losses}</td>

                    <td>
                      {s.wins + s.losses > 0
                        ? `${(
                            100 *
                            s.wins /
                            (s.wins + s.losses)
                          ).toFixed(1)}%`
                        : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- MATCH HISTORY -->

        <section
          id="panel-matches"
          role="tabpanel"
          aria-labelledby="tab-matches"
          class="section paginated-panel"
          data-page-size="10"
          hidden
        >
          <h2>Match History</h2>

          <p class="mobile-table-hint">
            Swipe to view full match history →
          </p>

          <div
            class="table-wrap map-table-wrap"
            tabindex="0"
            role="region"
            aria-label="Match history table"
          >
            <table
              class="sortable-map-table"
              data-paginated-table
            >
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Tournament</th>
                  <th>Round</th>
                  <th>Match</th>
                  <th>Map Number</th>
                </tr>
              </thead>

              <tbody>
                {mapMatches.map(m => (
                  <tr>
                    <td>{m.data.date}</td>

                    <td>
                      <a
                        href={`/tournament/${m.data.tournamentId}`}
                      >
                        {tournaments.get(
                          m.data.tournamentId
                        )?.data.name ??
                          m.data.tournamentId}
                      </a>
                    </td>

                    <td>
                      {getRoundName(m, tournaments)}
                    </td>

                    <td>
                      <a href={`/matches/${m.id}`}>
                        {teams.get(
                          m.data.team1Id ?? ''
                        )?.data.name ?? 'TBD'}
                        {' vs '}
                        {teams.get(
                          m.data.team2Id ?? ''
                        )?.data.name ?? 'TBD'}
                      </a>
                    </td>

                    <td>
                      {m.data.roundDetails
                        .filter(
                          rd => rd.mapId === map.id
                        )
                        .map(rd => rd.round_number)
                        .join(', ')}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <nav
            class="table-pagination"
            data-pagination
            aria-label="Match history pages"
          ></nav>
        </section>
      </>
    )}
  </div>
</Layout>

<script>
  document
    .querySelectorAll<HTMLTableElement>(
      '.sortable-map-table'
    )
    .forEach(table => {
      const headings = Array.from(
        table.querySelectorAll<HTMLTableCellElement>(
          'thead th'
        )
      );

      const body = table.tBodies[0];

      const panel =
        table.closest<HTMLElement>(
          '.paginated-panel'
        );

      const pagination =
        panel?.querySelector<HTMLElement>(
          '[data-pagination]'
        );

      const pageSize =
        Number(panel?.dataset.pageSize) || 0;

      let currentPage = 1;

      let rows = Array.from(body.rows);

      const value = (
        row: HTMLTableRowElement,
        index: number
      ) =>
        row.cells[index]?.textContent?.trim() || '';

      function getTotalPages() {
        if (!pageSize) return 1;

        return Math.max(
          1,
          Math.ceil(rows.length / pageSize)
        );
      }

      function getPageNumbers(
        current: number,
        total: number
      ): Array<number | 'ellipsis'> {
        if (total <= 7) {
          return Array.from(
            { length: total },
            (_, i) => i + 1
          );
        }

        if (current <= 4) {
          return [
            1,
            2,
            3,
            4,
            5,
            'ellipsis',
            total
          ];
        }

        if (current >= total - 3) {
          return [
            1,
            'ellipsis',
            total - 4,
            total - 3,
            total - 2,
            total - 1,
            total
          ];
        }

        return [
          1,
          'ellipsis',
          current - 1,
          current,
          current + 1,
          'ellipsis',
          total
        ];
      }

      function renderPagination() {
        if (!pagination || !pageSize) {
          return;
        }

        const totalPages = getTotalPages();

        const focusedLabel = pagination.contains(document.activeElement)
          ? document.activeElement?.getAttribute('aria-label') : null;
        pagination.innerHTML = '';

        if (totalPages <= 1) {
          pagination.hidden = true;
          return;
        }

        pagination.hidden = false;

        const previous =
          document.createElement('button');

        previous.type = 'button';
        previous.className = 'pagination-nav';
        previous.textContent = '← Previous';
        previous.setAttribute('aria-label', 'Previous page');
        previous.disabled = currentPage === 1;

        previous.addEventListener(
          'click',
          () => {
            if (currentPage <= 1) return;

            currentPage--;
            render();
          }
        );

        pagination.append(previous);

        const pages =
          document.createElement('div');

        pages.className = 'pagination-pages';

        getPageNumbers(
          currentPage,
          totalPages
        ).forEach(item => {
          if (item === 'ellipsis') {
            const ellipsis =
              document.createElement('span');

            ellipsis.className =
              'pagination-ellipsis';

            ellipsis.textContent = '…';

            pages.append(ellipsis);
            return;
          }

          const button =
            document.createElement('button');

          button.type = 'button';
          button.className = 'pagination-page';
          button.textContent = String(item);

          if (item === currentPage) {
            button.classList.add('is-active');

            button.setAttribute(
              'aria-current',
              'page'
            );
          }

          button.setAttribute(
            'aria-label',
            `Page ${item}`
          );

          button.addEventListener(
            'click',
            () => {
              currentPage = item;
              render();
            }
          );

          pages.append(button);
        });

        pagination.append(pages);

        const next =
          document.createElement('button');

        next.type = 'button';
        next.className = 'pagination-nav';
        next.textContent = 'Next →';
        next.setAttribute('aria-label', 'Next page');

        next.disabled =
          currentPage === totalPages;

        next.addEventListener(
          'click',
          () => {
            if (currentPage >= totalPages) {
              return;
            }

            currentPage++;
            render();
          }
        );

        pagination.append(next);
        if (focusedLabel) {
          const target = Array.from(pagination.querySelectorAll('button'))
            .find(button => button.getAttribute('aria-label') === focusedLabel && !button.disabled)
            || pagination.querySelector<HTMLButtonElement>('[aria-current="page"]');
          target?.focus({ preventScroll: true });
        }
      }

      function render() {
        rows.forEach(row => {
          body.append(row);
        });

        if (pageSize) {
          const start =
            (currentPage - 1) * pageSize;

          const end =
            start + pageSize;

          rows.forEach((row, index) => {
            row.hidden =
              index < start ||
              index >= end;
          });
        } else {
          rows.forEach(row => {
            row.hidden = false;
          });
        }

        renderPagination();
      }

      headings.forEach(
        (heading, index) => {
          const label =
            heading.textContent || '';

          const button =
            document.createElement('button');

          button.type = 'button';
          button.textContent = label + ' ↕';

          heading.textContent = '';
          heading.append(button);

          heading.setAttribute(
            'aria-sort',
            'none'
          );

          button.addEventListener(
            'click',
            () => {
              const ascending =
                heading.getAttribute(
                  'aria-sort'
                ) !== 'ascending';

              headings.forEach(h => {
                h.setAttribute(
                  'aria-sort',
                  'none'
                );
              });

              heading.setAttribute(
                'aria-sort',
                ascending
                  ? 'ascending'
                  : 'descending'
              );

              const numeric =
                rows.every(row => {
                  const text =
                    value(row, index);

                  return (
                    text === '—' ||
                    /^[-+]?\d+(?:\.\d+)?%?$/.test(
                      text
                    )
                  );
                });

              rows.sort((a, b) => {
                const x = value(a, index);
                const y = value(b, index);

                if (x === '—') {
                  return y === '—' ? 0 : 1;
                }

                if (y === '—') {
                  return -1;
                }

                const difference =
                  numeric
                    ? parseFloat(x) -
                      parseFloat(y)
                    : x.localeCompare(
                        y,
                        undefined,
                        { numeric: true }
                      );

                return ascending
                  ? difference
                  : -difference;
              });

              currentPage = 1;

              render();
            }
          );
        }
      );

      if (panel) {
        panel.addEventListener(
          'pagination-reset',
          () => {
            currentPage = 1;
            render();
          }
        );
      }

      render();
    });
</script>

<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>(
      '.map-tabs [role="tab"]'
    )
  );

  function activateTab(
    tab: HTMLButtonElement,
    focus = false
  ) {
    tabs.forEach(item => {
      const active = item === tab;

      item.setAttribute(
        'aria-selected',
        String(active)
      );

      item.tabIndex = active ? 0 : -1;

      const panel =
        document.getElementById(
          item.getAttribute(
            'aria-controls'
          )!
        )!;

      panel.hidden = !active;

      if (active) {
        panel.dispatchEvent(
          new Event('pagination-reset')
        );
      }
    });

    if (focus) {
      tab.focus();
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener(
      'click',
      () => activateTab(tab)
    );

    tab.addEventListener(
      'keydown',
      event => {
        let next = index;

        if (event.key === 'ArrowRight') {
          next =
            (index + 1) % tabs.length;
        } else if (
          event.key === 'ArrowLeft'
        ) {
          next =
            (index + tabs.length - 1) %
            tabs.length;
        } else if (
          event.key === 'Home'
        ) {
          next = 0;
        } else if (
          event.key === 'End'
        ) {
          next = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();

        activateTab(
          tabs[next],
          true
        );
      }
    );
  });
</script>

<style>
  .map-methodology {
    color: var(--text-secondary);
    font-size: 14px;
    margin-top: 8px;
  }

  .map-methodology summary {
    cursor: pointer;
    min-height: 44px;
    padding: 12px 0;
    color: var(--text-primary);
  }

  .map-methodology summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .map-methodology div {
    max-width: 75ch;
    padding-bottom: 12px;
  }

  .map-methodology p + p {
    margin-top: 12px;
  }

  .section {
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }

  h2 {
    margin-bottom: 1rem;
  }

  .coverage {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* HERO */

  .map-detail-hero {
    position: relative;
    min-height: 390px;
    margin: 32px 0 24px;
    overflow: hidden;
    border: 1px solid #65503e;
    border-radius: 12px;
    background: #211e1c;
  }

  .map-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .map-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(18, 18, 20, .94) 0%,
        rgba(18, 18, 20, .78) 45%,
        rgba(18, 18, 20, .38) 100%
      ),
      linear-gradient(
        0deg,
        rgba(18, 18, 20, .96) 0%,
        transparent 65%
      );
  }

  .map-hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 390px;
    flex-direction: column;
    justify-content: space-between;
    padding: 38px;
  }

  .map-hero-heading {
    max-width: 620px;
  }

  .map-hero-eyebrow {
    display: block;
    margin-bottom: 10px;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .map-hero-heading h1 {
    margin: 0;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1;
  }

  .map-hero-heading p {
    margin: 12px 0 0;
    color: var(--text-secondary);
    font-size: 15px;
  }

  .map-hero-stats {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
    max-width: 760px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 9px;
    overflow: hidden;
    background: rgba(23, 23, 25, .78);
    backdrop-filter: blur(8px);
  }

  .map-hero-stat {
    padding: 17px 20px;
    border-right:
      1px solid rgba(255,255,255,.10);
  }

  .map-hero-stat:last-child {
    border-right: 0;
  }

  .map-hero-stat strong {
    display: block;
    color: var(--accent);
    font-size: 24px;
    line-height: 1.1;
  }

  .map-hero-stat span {
    display: block;
    margin-top: 5px;
    color: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  /* LEADERS */

  .stat-box h2 {
    font-size: 17px;
  }

  .stat-box p {
    margin: 8px 0;
    font-size: 14px;
  }

  .map-player-leader {
    display:flex;
    align-items:flex-end;
    gap:12px;
    min-width:0;
  }

  .map-player-leader img {
    width:54px;
    height:62px;
    flex:0 0 auto;
    object-fit:contain;
    object-position:bottom;
  }

  .map-player-leader p {
    min-width:0;
    margin:0 0 6px;
  }

  .map-player-leader p a,
  .map-player-leader p span {
    display:block;
  }

  .map-player-leader p a {
    font-weight:700;
  }

  .map-player-leader p span {
    margin-top:3px;
    color:var(--text-muted);
    font-size:13px;
  }

  /* TABS */

  .map-tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    border-bottom:
      1px solid var(--border);
    padding-bottom: 12px;
    margin-top: 28px;
  }

  .map-tabs button {
    background: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px 16px;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .map-tabs button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .map-tabs button[aria-selected="true"] {
    background: var(--accent);
    color: #171719;
    border-color: var(--accent);
    font-weight: 600;
  }

  [role="tabpanel"][hidden] {
    display: none;
  }

  /* TABLES */

  .mobile-table-hint {
    display: none;
  }

  .map-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* PAGINATION */

  .table-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .table-pagination[hidden] {
    display: none;
  }

  .table-pagination :global(.pagination-pages) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }

  .table-pagination :global(.pagination-ellipsis) {
    padding: 0 2px;
    color: var(--text-muted);
  }

  /*
   * Explicit reset prevents global/native
   * button styles from producing white boxes.
   */

  .table-pagination :global(button) {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;

    width: auto;
    min-width: 44px;
    min-height: 44px;
    margin: 0;
    padding: 8px 11px;

    background: var(--bg-secondary) !important;
    color: var(--text-secondary) !important;
    border: 1px solid var(--border) !important;
    border-radius: 6px;

    box-shadow: none !important;
    font: inherit;
    font-size: 12px;
    line-height: 1;
    text-decoration: none;

    cursor: pointer;
  }

  .table-pagination
    :global(button:hover:not(:disabled)) {
    background: var(--bg-secondary) !important;
    border-color: var(--accent) !important;
    color: var(--accent) !important;
  }

  .table-pagination
    :global(.pagination-page.is-active) {
    background: var(--accent) !important;
    border-color: var(--accent) !important;
    color: #171719 !important;
    font-weight: 700;
  }

  .table-pagination :global(button:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .table-pagination :global(button:disabled) {
    background: var(--bg-secondary) !important;
    color: var(--text-muted) !important;
    border-color: var(--border) !important;
    opacity: .4;
    cursor: default;
  }

  /* RESPONSIVE */

  @media (max-width: 900px) {
    .map-hero-stats {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .map-detail-hero {
      min-height: 440px;
