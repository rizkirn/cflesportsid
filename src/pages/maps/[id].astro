    .map-hero-heading h1 {
      font-size: 34px;
    }

    .map-hero-heading p {
      font-size: 13px;
    }

    .map-hero-stats {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .map-hero-stat {
      padding: 14px 16px;
      border-right:
        1px solid rgba(255,255,255,.10);
      border-bottom:
        1px solid rgba(255,255,255,.10);
    }

    .map-hero-stat:nth-child(2) {
      border-right: 0;
    }

    .map-hero-stat:nth-child(3),
    .map-hero-stat:nth-child(4) {
      border-bottom: 0;
    }

    .map-hero-stat:nth-child(4) {
      border-right: 0;
    }

    .map-hero-stat strong {
      font-size: 20px;
    }

    .mobile-table-hint {
      display: block;
      margin: 0 0 8px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
      text-align: right;
    }

    .map-table-wrap .sortable-map-table {
      min-width: max-content;
    }

    .map-table-wrap .sortable-map-table th,
    .map-table-wrap .sortable-map-table td {
      white-space: nowrap;
    }

    .map-tabs {
      gap: 6px;
    }

    .map-tabs button {
      flex: 1 1 0;
      min-width: 0;
      padding: 10px 7px;
      font-size: 11px;
      white-space: nowrap;
    }

    .table-pagination {
      gap: 6px;
    }

    .table-pagination :global(.pagination-pages) {
      flex-basis: 100%;
      order: 1;
      gap: 4px;
    }

    .table-pagination :global(button) {
      padding: 7px 8px;
      font-size: 11px;
    }

    .table-pagination :global(.pagination-nav) {
      white-space: nowrap;
    }
  }
</style>

