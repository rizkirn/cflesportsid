          0deg,
          rgba(18, 18, 20, .98) 0%,
          rgba(18, 18, 20, .82) 55%,
          rgba(18, 18, 20, .42) 100%
        );
    }

    .map-hero-content {
      min-height: 440px;
      padding: 24px 20px 20px;
    }

    .map-hero-heading {
      margin-top: auto;
      margin-bottom: 24px;
