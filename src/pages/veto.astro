    }
  }
</style>

<script is:inline>
  (function() {
    const matchData = JSON.parse(
      document.getElementById('match-data').textContent
    );

    let MAPS = [];
    let mapNames = new Map();

    const mapName = id =>
      mapNames.get(id) ?? id ?? '—';

    let PICK_TIME = 20;
    let RESERVE_TIME = 90;
    let VETO_STEPS = [];
    let spinTimeout = null;

    const WHEEL_COLORS = [
      '#ff742e',
      '#3b82f6',
      '#22c55e',
      '#eab308',
      '#a855f7',
      '#ec4899',
      '#06b6d4',
      '#f97316'
    ];

    let state = {
      matchId: null,
      match: null,
      currentStep: 0,
      mapStates: {},
      vetoHistory: [],
      picks: {
        A: null,
        B: null,
        decider: null
      },
      voidedPicks: {
        A: false,
        B: false
      },
      phase: 'select',
      pickTimer: PICK_TIME,
      reserveTimer: {
        A: RESERVE_TIME,
        B: RESERVE_TIME
      },
      timerPhase: null,
      timerInterval: null
    };

    const escapeHTML = value =>
      String(value).replace(
        /[&<>"']/g,
        char => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;'
        })[char]
      );

    const $ = id => document.getElementById(id);

    function init() {
      $('match-select').addEventListener(
        'change',
        onMatchSelect
      );

      $('veto-mode').addEventListener(
        'change',
        () => {
          resetVeto();

          const scrim =
            $('veto-mode').value === 'scrim';

          $('match-controls').style.display =
            scrim ? 'none' : '';

          $('scrim-form').style.display =
            scrim ? '' : 'none';
        }
      );

      $('start-scrim-btn')?.addEventListener(
        'click',
        () => {
          resetVeto();

          $('veto-mode').value = 'scrim';
          $('match-controls').style.display = 'none';
          $('scrim-form').style.display = '';

          requestAnimationFrame(() => {
            $('scrim-a').focus();
          });
        }
      );

      $('scrim-form').addEventListener(
        'submit',
        event => {
          event.preventDefault();

          const a = $('scrim-a').value.trim();
          const b = $('scrim-b').value.trim();

          if (!a || !b) {
            showToast('Enter both team names.');
            return;
          }

          startSession({
            id: 'scrim',
            tournament: 'Scrim',
            round: 'Fixed 3 maps',
            veto: JSON.parse(
              $('scrim-data').textContent
            ),
            team1: {
              id: 'A',
              name: a,
              tag: 'A'
            },
            team2: {
              id: 'B',
              name: b,
              tag: 'B'
            }
          });
        }
      );

      $('spin-btn').addEventListener(
        'click',
        spinWheel
      );

      $('copy-btn').addEventListener(
        'click',
        copyResult
      );

      $('reset-btn').addEventListener(
        'click',
        resetVeto
      );

      const matchId =
        new URLSearchParams(location.search)
          .get('match');

      if (matchId) {
        onMatchSelect({
          target: {
            value: matchId
          }
        });
      }
    }

    function startTimer() {
      stopTimer();

      if (state.phase !== 'veto') return;

      state.pickTimer = PICK_TIME;
      state.timerPhase = 'pick';

      renderTimer();

      state.timerInterval =
        setInterval(tick, 1000);
    }

    function stopTimer() {
      if (state.timerInterval) {
        clearInterval(state.timerInterval);
        state.timerInterval = null;
      }
    }

    function tick() {
      const team =
        VETO_STEPS[state.currentStep]?.team;

      if (!team) return;

      if (state.timerPhase === 'pick') {
        state.pickTimer--;

        if (state.pickTimer <= 0) {
          state.pickTimer = 0;

          if (state.reserveTimer[team] > 0) {
            state.timerPhase = 'reserve';
          } else {
            voidCurrentStep();
            return;
          }
        }
      } else if (
        state.timerPhase === 'reserve'
      ) {
        state.reserveTimer[team]--;

        if (state.reserveTimer[team] <= 0) {
          state.reserveTimer[team] = 0;
          voidCurrentStep();
          return;
        }
      }

      renderTimer();
    }

    function voidCurrentStep() {
      stopTimer();

      const step =
        VETO_STEPS[state.currentStep];

      if (!step) return;

      const teamName =
        step.team === 'A'
          ? state.match.team1.name
          : state.match.team2.name;

      if (step.action === 'pick') {
        const available =
          getRemainingMaps();

        const map =
          available[
            Math.floor(
              Math.random() *
              available.length
            )
          ];

        onMapClick(map, true);

        showToast(
          `⏱️ Time up — ${teamName} randomly picks ${mapName(map)}`
        );

        return;
      }

      state.vetoHistory.push({
        map: null,
        team: step.team,
        action: step.action,
        voided: true
      });

      if (step.action === 'pick') {
        state.voidedPicks[step.team] = true;
      }

      state.currentStep++;

      showToast(
        `⏱️ Time up — ${teamName}'s ${step.action} voided`
      );

      renderPicks();
      renderSteps();
      renderMaps();

      if (
        state.currentStep >=
        VETO_STEPS.length
      ) {
        state.phase = 'wheel';
        state.timerPhase = null;

        renderSteps();
        renderPrompt();
        renderTimer();
        showWheel();
      } else {
        renderPrompt();
        startTimer();
      }
    }

    function renderTimer() {
      const timerEl = $('veto-timer');

      if (state.phase !== 'veto') {
        timerEl.style.display = 'none';
        return;
      }

      timerEl.style.display = '';

      const pickPct =
        (state.pickTimer / PICK_TIME) *
        100;

      const pickBar =
        $('pick-timer-bar');

      pickBar.style.width =
        pickPct + '%';

      pickBar.className =
        'timer-bar ' +
        getTimerColorClass(
          pickPct,
          state.timerPhase === 'pick'
        );

      $('pick-timer-value').textContent =
        state.pickTimer + 's';

      const team =
        VETO_STEPS[state.currentStep].team;

      $('reserve-label').textContent =
        `Reserve ${team}`;

      const reservePct =
        (
          state.reserveTimer[team] /
          RESERVE_TIME
        ) * 100;

      const reserveBar =
        $('reserve-timer-bar');

      reserveBar.style.width =
        reservePct + '%';

      reserveBar.className =
        'timer-bar reserve ' +
        getTimerColorClass(
          reservePct,
          state.timerPhase === 'reserve'
        );

      $('reserve-timer-value').textContent =
        state.reserveTimer[team] + 's';

      const status = $('timer-status');

      if (state.timerPhase === 'pick') {
        status.textContent =
          'Pick phase — choose now!';

        status.className =
          'timer-status pick';
      } else if (
        state.timerPhase === 'reserve'
      ) {
        status.textContent =
          '⚠ Reserve phase — hurry!';

        status.className =
          'timer-status reserve';
      } else {
        status.textContent = '';
        status.className =
          'timer-status';
      }
    }

    function getTimerColorClass(
      pct,
      active
    ) {
      if (!active) return 'inactive';
      if (pct > 50) return 'green';
      if (pct > 25) return 'amber';

      return 'red';
    }

    function showToast(msg) {
      const toast = $('veto-toast');

      toast.textContent = msg;
      toast.style.display = '';

      requestAnimationFrame(() =>
        toast.classList.add('show')
      );

      clearTimeout(toast._timeout);

      toast._timeout =
        setTimeout(() => {
          toast.classList.remove('show');

          setTimeout(() => {
            toast.style.display = 'none';
          }, 300);
        }, 2500);
    }

    function onMatchSelect(e) {
      const id = e.target.value;

      startSession(
        matchData.find(
          m => m.id === id
        )
      );
    }

    function startSession(selected) {
      resetVeto();

      const id = selected?.id;

      if (
        !selected?.veto ||
        !selected.team1.id ||
        !selected.team2.id
      ) {
        return;
      }

      $('match-select').value = id;

      MAPS =
        selected.veto.maps.map(
          map => map.id
        );

      mapNames =
        new Map(
          selected.veto.maps.map(
            map => [
              map.id,
              map.name
            ]
          )
        );

      VETO_STEPS =
        selected.veto.steps;

      PICK_TIME =
        selected.veto.actionSeconds;

      RESERVE_TIME =
        selected.veto.reserveSeconds;

      state = {
        matchId: id,
        match: selected,
        currentStep: 0,
        mapStates: {},
        vetoHistory: [],
        picks: {
          A: null,
          B: null,
          decider: null
        },
        voidedPicks: {
          A: false,
          B: false
        },
        phase: 'veto',
        pickTimer: PICK_TIME,
        reserveTimer: {
          A: RESERVE_TIME,
          B: RESERVE_TIME
        },
        timerPhase: null,
        timerInterval: null
      };

      MAPS.forEach(
        m =>
          state.mapStates[m] =
            'available'
      );

      showVetoInterface();
      renderPicks();
      renderSteps();
      renderPrompt();
      renderMaps();
      renderTimer();

      $('veto-wheel-section')
        .style.display = 'none';

      $('veto-results')
        .style.display = 'none';

      startTimer();
    }

    function showVetoInterface() {
      $('veto-interface')
        .style.display = '';

      $('team-a-tag').textContent =
        state.match.team1.tag;

      $('team-a-name').textContent =
        state.match.team1.name;

      $('team-b-tag').textContent =
        state.match.team2.tag;

      $('team-b-name').textContent =
        state.match.team2.name;

      $('pick-tag-a').textContent =
        state.match.team1.tag;

      $('pick-tag-b').textContent =
        state.match.team2.tag;
    }

    function renderPicks() {
      const cardA =
        $('pick-card-a');

      const mapA =
        $('pick-map-a');

      const statusA =
        $('pick-status-a');

      cardA.classList.remove(
        'filled',
        'voided'
      );

      if (state.voidedPicks.A) {
        cardA.classList.add('voided');

        mapA.textContent = 'VOID';

        statusA.textContent =
          '⏱ No pick (time expired)';
      } else if (state.picks.A) {
        cardA.classList.add('filled');

        mapA.textContent =
          mapName(state.picks.A);

        statusA.textContent =
          '✓ Picked';
      } else {
        mapA.textContent = '—';
        statusA.textContent =
          'Waiting…';
      }

      const cardB =
        $('pick-card-b');

      const mapB =
        $('pick-map-b');

      const statusB =
        $('pick-status-b');

      cardB.classList.remove(
        'filled',
        'voided'
      );

      if (state.voidedPicks.B) {
        cardB.classList.add('voided');

        mapB.textContent = 'VOID';

        statusB.textContent =
          '⏱ No pick (time expired)';
      } else if (state.picks.B) {
        cardB.classList.add('filled');

        mapB.textContent =
          mapName(state.picks.B);

        statusB.textContent =
          '✓ Picked';
      } else {
        mapB.textContent = '—';

        statusB.textContent =
          'Waiting…';
      }
    }

    function renderSteps() {
      const tagA =
        state.match
          ? state.match.team1.tag
          : 'A';

      const tagB =
        state.match
          ? state.match.team2.tag
          : 'B';

      const html =
        VETO_STEPS.map(
          (step, i) => {
            const done =
              i < state.currentStep;

            const active =
              i === state.currentStep;

            const history =
              state.vetoHistory[i];

            const cls =
              `veto-step team-${step.team.toLowerCase()} ` +
              `${active && state.phase === 'veto' ? 'active' : ''} ` +
              `${done ? 'done' : ''}`;

            const tag =
              step.team === 'A'
                ? tagA
                : tagB;

            const mapHtml =
              history
                ? history.voided
                  ? `<span class="step-void">VOID</span>`
                  : `<span class="step-map">${mapName(history.map)}</span>`
                : '';

            return `
              <div class="${cls}" role="listitem">
                <span class="step-team">${escapeHTML(tag)}</span>
                <span class="step-action ${step.action}">
                  ${step.action === 'ban' ? 'Ban' : 'Pick'}
                </span>
                ${mapHtml}
              </div>
            `;
          }
        ).join('') +
        `
          <div
            class="veto-step ${
              state.phase === 'wheel'
                ? 'active'
                : ''
            } ${
              state.phase === 'result'
                ? 'done'
                : ''
            }"
            role="listitem"
          >
            <span
              class="step-team"
              style="color:#facc15"
            >
              ★
            </span>

            <span class="step-action">
              Wheel
            </span>

            ${
              state.picks.decider
                ? `<span class="step-map">${mapName(state.picks.decider)}</span>`
                : ''
            }
          </div>
        `;

      $('veto-steps').innerHTML = html;
    }

    function renderPrompt() {
      if (state.phase !== 'veto') {
        $('veto-prompt').innerHTML = '';
        return;
      }

      const step =
        VETO_STEPS[state.currentStep];

      if (!step) {
        $('veto-prompt').innerHTML = '';
        return;
      }

      const teamName =
        step.team === 'A'
          ? state.match.team1.name
          : state.match.team2.name;

      $('veto-prompt').innerHTML =
        `<span class="prompt-team ${step.team.toLowerCase()}">` +
        `${escapeHTML(teamName)}</span> — ` +
        `<span class="prompt-action">` +
        `${step.action === 'ban' ? 'Ban a map' : 'Pick a map'}` +
        `</span>`;
    }

    function renderMaps() {
      const interactive =
        state.phase === 'veto';

      const mapsEl =
        $('veto-maps');

      if (interactive) {
        const step =
          VETO_STEPS[
            state.currentStep
          ];

        mapsEl.className =
          `veto-maps turn-${
            step
              ? step.team.toLowerCase()
              : ''
          }`;
      } else {
        mapsEl.className =
          'veto-maps';
      }

      const html =
        MAPS.map(map => {
          const st =
            state.mapStates[map] ||
            'available';

          const isAvail =
            st === 'available';

          const clickable =
            interactive &&
            isAvail;

          let statusLabel = '';
          let statusClass = '';

          if (st === 'banned') {
            statusLabel = 'BANNED';
            statusClass = 'banned';
          } else if (
            st === 'picked'
          ) {
            statusLabel = 'PICKED';
            statusClass = 'picked';
          } else if (
            st === 'decider'
          ) {
            statusLabel = 'MAP 3';
            statusClass = 'decider';
          }

          const cls =
            `veto-map-card ${statusClass} ` +
            `${
              clickable
                ? ''
                : isAvail
                  ? 'disabled'
                  : ''
            }`;

          return `
            <button
              class="${cls}"
              data-map="${escapeHTML(map)}"
              ${
                clickable
                  ? ''
                  : 'disabled'
              }
              aria-label="${escapeHTML(mapName(map))} ${statusLabel || 'available'}"
            >
              <img class="veto-map-image" src="/maps/${encodeURIComponent(map)}.webp" alt="" loading="lazy" onerror="this.onerror=null;this.src='/maps/placeholder.svg'" />
              <div class="veto-map-name">
                ${escapeHTML(mapName(map))}
              </div>

              ${
                statusLabel
                  ? `<div class="veto-map-status">${statusLabel}</div>`
                  : ''
              }
            </button>
          `;
        }).join('');

      mapsEl.innerHTML = html;

      if (interactive) {
        document
          .querySelectorAll(
            '.veto-map-card[data-map]'
          )
          .forEach(card => {
            card.addEventListener(
              'click',
              () =>
                onMapClick(
                  card.dataset.map
                )
            );
          });
      }
    }

    function onMapClick(
      map,
      automatic = false
    ) {
      if (
        state.phase !== 'veto' ||
        state.mapStates[map] !==
          'available'
      ) {
        return;
      }

      const step =
        VETO_STEPS[
          state.currentStep
        ];

      if (!step) return;

      stopTimer();

      state.mapStates[map] =
        step.action === 'ban'
          ? 'banned'
          : 'picked';

      state.vetoHistory.push({
        map,
        team: step.team,
        action: step.action,
        voided: false,
        automatic
      });

      if (step.action === 'pick') {
        state.picks[step.team] =
          map;
      }

      state.currentStep++;

      renderPicks();
      renderSteps();
      renderMaps();

      if (
        state.currentStep >=
        VETO_STEPS.length
      ) {
        state.phase = 'wheel';
        state.timerPhase = null;

        renderSteps();
        renderPrompt();
        renderTimer();
        showWheel();
      } else {
        renderPrompt();
        startTimer();
      }
    }

    function getRemainingMaps() {
      return MAPS.filter(
        m =>
          state.mapStates[m] ===
          'available'
      );
    }

    function showWheel() {
      $('veto-wheel-section')
        .style.display = '';

      drawWheel(
        getRemainingMaps()
      );
    }

    function drawWheel(maps) {
      const canvas =
        $('wheel-canvas');

      const ctx =
        canvas.getContext('2d');

      const cx =
        canvas.width / 2;

      const cy =
        canvas.height / 2;

      const radius =
        Math.min(cx, cy) - 8;

      const segAngle =
        (2 * Math.PI) /
        maps.length;

      const startOffset =
        -Math.PI / 2;

      ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
      );

      maps.forEach(
        (map, i) => {
          const a1 =
            startOffset +
            i * segAngle;

          const a2 =
            a1 + segAngle;

          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.arc(
            cx,
            cy,
            radius,
            a1,
            a2
          );
          ctx.closePath();

          ctx.fillStyle =
            WHEEL_COLORS[
              i %
              WHEEL_COLORS.length
            ];

          ctx.fill();

          ctx.strokeStyle =
            'rgba(0,0,0,0.2)';

          ctx.lineWidth = 2;
          ctx.stroke();

          ctx.save();

          ctx.translate(cx, cy);

          ctx.rotate(
            a1 +
            segAngle / 2
          );

          ctx.textAlign = 'right';
          ctx.fillStyle = '#fff';

          ctx.font =
            'bold 13px "Segoe UI", sans-serif';

          ctx.shadowColor =
            'rgba(0,0,0,0.5)';

          ctx.shadowBlur = 3;

          ctx.fillText(
            mapName(map),
            radius - 15,
            5
          );

          ctx.restore();
        }
      );

      ctx.beginPath();

      ctx.arc(
        cx,
        cy,
        20,
        0,
        2 * Math.PI
      );

      ctx.fillStyle = '#1d1d20';
      ctx.fill();

      ctx.strokeStyle = '#36363a';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    function spinWheel() {
      if (
        state.phase !== 'wheel' ||
        spinTimeout !== null
      ) {
        return;
      }

      const remaining =
        getRemainingMaps();

      if (
        remaining.length === 0
      ) {
        return;
      }

      const canvas =
        $('wheel-canvas');

      const spinBtn =
        $('spin-btn');

      spinBtn.disabled = true;

      spinBtn.textContent =
        'Spinning...';

      const winnerIdx =
        Math.floor(
          Math.random() *
          remaining.length
        );

      const segAngle =
        360 / remaining.length;

      const segCenter =
        winnerIdx *
          segAngle +
        segAngle / 2;

      const targetRotation =
        360 * 5 +
        (360 - segCenter);

      canvas.style.transform =
        `rotate(${targetRotation}deg)`;

      spinTimeout =
        setTimeout(() => {
          const winner =
            remaining[winnerIdx];

          state.mapStates[winner] =
            'decider';

          state.picks.decider =
            winner;

          state.phase =
            'result';

          renderPicks();
          renderSteps();
          renderMaps();
          showResults();
        }, 4200);
    }

    function showResults() {
      $('veto-wheel-section')
        .style.display = 'none';

      $('veto-results')
        .style.display = '';

      const pickResults = [
        {
          num: 1,
          map: state.picks.A,
          voided:
            state.voidedPicks.A,
          labelHtml:
            `<span class="pick-team a">` +
            `${escapeHTML(state.match.team1.name)}` +
            `</span>'s Pick`,
          cls: 'team-a-pick'
        },
        {
          num: 2,
          map: state.picks.B,
          voided:
            state.voidedPicks.B,
          labelHtml:
            `<span class="pick-team b">` +
            `${escapeHTML(state.match.team2.name)}` +
            `</span>'s Pick`,
          cls: 'team-b-pick'
        },
        {
          num: 3,
          map:
            state.picks.decider,
          voided: false,
          labelHtml:
            'Map 3 (Wheel)',
          cls: 'decider'
        }
      ];

      const mapsHtml =
        pickResults
          .map(r => {
            const cls =
              r.voided
                ? 'voided-pick'
                : r.cls;

            const name =
              r.voided
                ? 'Void'
                : mapName(r.map);

            const label =
              r.voided
                ? `${r.labelHtml} — <span class="void-tag">No pick (time expired)</span>`
                : r.labelHtml;

            return `
              <div class="result-map-card ${cls}">
                <div class="result-map-num">
                  ${r.num}
                </div>

                <div class="result-map-info">
                  <div class="result-map-name">
                    ${escapeHTML(name)}
                  </div>

                  <div class="result-map-label">
                    ${label}
                  </div>
                </div>
              </div>
            `;
          })
          .join('');

      $('results-maps')
        .innerHTML =
          mapsHtml;

      const bannedHtml =
        state.vetoHistory
          .filter(
            h =>
              h.action === 'ban' &&
              !h.voided
          )
          .map(h => {
            const tag =
              h.team === 'A'
                ? state.match.team1.tag
                : state.match.team2.tag;

            return `
              <div class="banned-map-item team-${h.team.toLowerCase()}-ban">
                <span class="b-team ${h.team.toLowerCase()}">
                  ${escapeHTML(tag)}
                </span>

                <span class="b-map">
                  ${escapeHTML(mapName(h.map))}
                </span>
              </div>
            `;
          })
          .join('');

      $('results-banned-list')
        .innerHTML =
          bannedHtml;
    }

    function copyResult() {
      const voidedSteps =
        state.vetoHistory.filter(
          h => h.voided
        );

      const lines = [
        'Map Veto Result',
        `${state.match.tournament} — ${state.match.round}`,
        `${state.match.team1.name} vs ${state.match.team2.name}`,
        '',
        'Maps to Play:',
        `1. ${
          state.voidedPicks.A
            ? 'VOID (no pick)'
            : mapName(state.picks.A)
        } — ${state.match.team1.name}'s Pick${
          state.voidedPicks.A
            ? ' (time expired)'
            : ''
        }`,
        `2. ${
          state.voidedPicks.B
            ? 'VOID (no pick)'
            : mapName(state.picks.B)
        } — ${state.match.team2.name}'s Pick${
          state.voidedPicks.B
            ? ' (time expired)'
            : ''
        }`,
        `3. ${mapName(state.picks.decider)} — Map 3 (Wheel)`,
        '',
        'Banned Maps:',
        ...state.vetoHistory
          .filter(
            h =>
              h.action === 'ban' &&
              !h.voided
          )
          .map(
            h =>
              `- ${mapName(h.map)} (${
                h.team === 'A'
                  ? state.match.team1.name
                  : state.match.team2.name
              })`
          )
      ];

      if (voidedSteps.length > 0) {
        lines.push(
          '',
          'Voided Steps:'
        );

        lines.push(
          ...voidedSteps.map(
            h =>
              `- ${
                h.team === 'A'
                  ? state.match.team1.name
                  : state.match.team2.name
              } ${h.action} (time expired)`
          )
        );
      }

      const automaticPicks =
        state.vetoHistory.filter(
          h => h.automatic
        );

      if (automaticPicks.length) {
        lines.push(
          '',
          'Automatic picks after timeout:',
          ...automaticPicks.map(
            h =>
              `- ${mapName(h.map)} (${
                h.team === 'A'
                  ? state.match.team1.name
                  : state.match.team2.name
              })`
          )
        );
      }

      navigator.clipboard
        .writeText(
          lines.join('\n')
        )
        .then(() => {
          const btn =
            $('copy-btn');

          btn.textContent =
            '✓ Copied!';

          setTimeout(() => {
            btn.textContent =
              '📋 Copy Result';
          }, 2000);
        });
    }

    function resetVeto() {
      stopTimer();

      clearTimeout(spinTimeout);
      spinTimeout = null;

      state = {
        matchId: null,
        match: null,
        currentStep: 0,
        mapStates: {},
        vetoHistory: [],
        picks: {
          A: null,
          B: null,
          decider: null
        },
        voidedPicks: {
          A: false,
          B: false
        },
        phase: 'select',
        pickTimer: PICK_TIME,
        reserveTimer: {
          A: RESERVE_TIME,
          B: RESERVE_TIME
        },
        timerPhase: null,
        timerInterval: null
      };

      $('match-select').value = '';

      $('veto-interface')
        .style.display = 'none';

      $('veto-timer')
        .style.display = 'none';

      $('veto-wheel-section')
        .style.display = 'none';

      $('veto-results')
        .style.display = 'none';

      const canvas =
        $('wheel-canvas');

      canvas.style.transition =
        'none';

      canvas.style.transform =
        'rotate(0deg)';

      void canvas.offsetWidth;

      canvas.style.transition =
        'transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99)';

      const spinBtn =
        $('spin-btn');

      spinBtn.disabled = false;

      spinBtn.textContent =
        '🎡 Spin the Wheel';
    }

    init();
  })();
</script>

