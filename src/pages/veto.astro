---
import scrimSettings from '../data/veto/scrim.json';
import { resolveVeto } from '../utils/veto';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getRoundName, getParticipantLabel } from '../utils/tournament';
import {
  getTeamMap,
  getTournamentMap,
  getMapMap,
  getMatchTeam1Id,
  getMatchTeam2Id,
  getMatchTournamentId
} from '../utils/content';

const matches = await getCollection('matches');
const teamsMap = await getTeamMap();
const tournamentsMap = await getTournamentMap();
const mapsMap = await getMapMap();

const vetoConfigs = new Map();

for (const tournament of tournamentsMap.values()) {
  for (const stage of tournament.data.stages) {
    vetoConfigs.set(
      `${tournament.id}:${stage.id}`,
      resolveVeto(stage, mapsMap)
    );
  }
}

const scrimVeto = resolveVeto(
  scrimSettings as Parameters<typeof resolveVeto>[0],
  mapsMap
);

const matchData = matches
  .filter(m => m.data.status === 'upcoming')
  .map(m => {
    const team1Id = getMatchTeam1Id(m);
    const team2Id = getMatchTeam2Id(m);
    const tournamentId = getMatchTournamentId(m);

    const t1 = team1Id ? teamsMap.get(team1Id) : undefined;
    const t2 = team2Id ? teamsMap.get(team2Id) : undefined;
    const tournament = tournamentId
      ? tournamentsMap.get(tournamentId)
      : undefined;

    return {
      id: m.id,
      stageId: m.data.stageId,
      veto: vetoConfigs.get(`${tournamentId}:${m.data.stageId}`),
      tournamentId,
      tournament: tournament?.data.name ?? tournamentId ?? 'TBD',
      round: getRoundName(m, tournamentsMap),

      team1: {
        id: team1Id,
        name:
          t1?.data.name ??
          team1Id ??
          getParticipantLabel(m, 1),
        tag: t1?.data.tag ?? team1Id ?? '?'
      },

      team2: {
        id: team2Id,
        name:
          t2?.data.name ??
          team2Id ??
          getParticipantLabel(m, 2),
        tag: t2?.data.tag ?? team2Id ?? '?'
      },

      status: m.data.status
    };
  });
---

<Layout title="CFL Esports ID - Map Veto Tool" current="Veto">
  <div class="container veto-page">
    <div class="page-header">
      <h1>Map Veto Tool</h1>
      <p>Choose an upcoming match or enter teams for a scrim</p>
    </div>

    <div class="veto-select-wrap">
      {
        matchData.length > 0 ? (
          <>
            <div id="mode-controls">
              <label for="veto-mode">Veto mode</label>

              <select id="veto-mode" class="veto-select">
                <option value="match">Upcoming match</option>
                <option value="scrim">Scrim</option>
              </select>
            </div>

            <div id="match-controls">
              <label for="match-select">Upcoming match</label>

              <select id="match-select" class="veto-select">
                <option value="">
                  — Select an upcoming match —
                </option>

                {matchData.map(m => (
                  <option
                    value={m.id}
                    disabled={!m.veto || !m.team1.id || !m.team2.id}
                  >
                    {m.tournament} · {m.round} · {m.team1.name} vs {m.team2.name}
                  </option>
                ))}
              </select>
            </div>
          </>
        ) : (
          <>
            {/* Keep these for existing JS, but don't show them */}
            <select
              id="veto-mode"
              aria-hidden="true"
              tabindex="-1"
              style="display:none;"
            >
              <option value="match">Upcoming match</option>
              <option value="scrim">Scrim</option>
            </select>

            <select
              id="match-select"
              aria-hidden="true"
              tabindex="-1"
              style="display:none;"
            >
              <option value=""></option>
            </select>

            <div id="match-controls">
              <div class="veto-empty-state">
                <div class="veto-empty-copy">
                  <strong>No upcoming matches</strong>

                  <p>
                    No scheduled matches are currently available.
                    Start a custom scrim instead.
                  </p>
                </div>

                <button
                  type="button"
                  class="veto-btn"
                  id="start-scrim-btn"
                >
                  Start a Scrim Veto →
                </button>
              </div>
            </div>
          </>
        )
      }
    </div>

    <form
      id="scrim-form"
      style="display:none;"
      class="veto-select-wrap"
    >
      <label for="scrim-a">Team A name</label>

      <input
        id="scrim-a"
        class="veto-select"
        required
        maxlength="60"
        placeholder="Team A"
      />

      <label for="scrim-b">Team B name</label>

      <input
        id="scrim-b"
        class="veto-select"
        required
        maxlength="60"
        placeholder="Team B"
      />

      <button class="veto-btn" type="submit">
        Start scrim veto
      </button>
    </form>

    <div
      class="veto-toast"
      id="veto-toast"
      role="alert"
      aria-live="polite"
    ></div>

    <div id="veto-interface" style="display:none;">
      <div class="veto-teams">
        <div class="veto-team team-a">
          <span
            class="veto-team-tag"
            id="team-a-tag"
          ></span>

          <span
            class="veto-team-name"
            id="team-a-name"
          ></span>
        </div>

        <div class="veto-vs">VS</div>

        <div class="veto-team team-b">
          <span
            class="veto-team-tag"
            id="team-b-tag"
          ></span>

          <span
            class="veto-team-name"
            id="team-b-name"
          ></span>
        </div>
      </div>

      <div class="veto-picks" id="veto-picks">
        <div
          class="pick-card team-a"
          id="pick-card-a"
        >
          <div class="pick-card-top">
            <span
              class="pick-team-tag"
              id="pick-tag-a"
            ></span>

            <span class="pick-card-label">
              Map Pick
            </span>
          </div>

          <div
            class="pick-map-name"
            id="pick-map-a"
          >
            —
          </div>

          <div
            class="pick-card-status"
            id="pick-status-a"
          >
            Waiting…
          </div>
        </div>

        <div
          class="pick-card team-b"
          id="pick-card-b"
        >
          <div class="pick-card-top">
            <span
              class="pick-team-tag"
              id="pick-tag-b"
            ></span>

            <span class="pick-card-label">
              Map Pick
            </span>
          </div>

          <div
            class="pick-map-name"
            id="pick-map-b"
          >
            —
          </div>

          <div
            class="pick-card-status"
            id="pick-status-b"
          >
            Waiting…
          </div>
        </div>
      </div>

      <div
        class="veto-steps"
        id="veto-steps"
        role="list"
      ></div>

      <div
        class="veto-action-prompt"
        id="veto-prompt"
        aria-live="polite"
      ></div>

      <div
        class="veto-timer"
        id="veto-timer"
        style="display:none;"
      >
        <div class="timer-row">
          <div class="timer-block">
            <span class="timer-label">Pick</span>

            <div class="timer-bar-wrap">
              <div
                class="timer-bar"
                id="pick-timer-bar"
              ></div>
            </div>

            <span
              class="timer-value"
              id="pick-timer-value"
            >
              20s
            </span>
          </div>

          <div class="timer-block">
            <span
              class="timer-label"
              id="reserve-label"
            >
              Reserve
            </span>

            <div class="timer-bar-wrap">
              <div
                class="timer-bar reserve"
                id="reserve-timer-bar"
              ></div>
            </div>

            <span
              class="timer-value"
              id="reserve-timer-value"
            >
              90s
            </span>
          </div>
        </div>

        <div
          class="timer-status"
          id="timer-status"
        ></div>
      </div>

      <div
        class="veto-maps"
        id="veto-maps"
        role="group"
        aria-label="Available maps"
      ></div>
    </div>

    <div
      id="veto-wheel-section"
      style="display:none;"
    >
      <h2 class="wheel-title">
        Map 3 — Spin the Wheel!
      </h2>

      <p class="wheel-subtitle">
        Remaining maps go into the wheel. The one it
        lands on will be map 3. All three maps are played.
      </p>

      <div class="wheel-container">
        <div
          class="wheel-pointer"
          aria-hidden="true"
        ></div>

        <canvas
          id="wheel-canvas"
          width="320"
          height="320"
          aria-label="Spinning wheel for map 3"
        ></canvas>
      </div>

      <button
        id="spin-btn"
        class="veto-btn wheel-btn"
      >
        🎡 Spin the Wheel
      </button>
    </div>

    <div
      id="veto-results"
      style="display:none;"
    >
      <h2 class="results-title">
        Veto Results
      </h2>

      <div
        class="results-maps"
        id="results-maps"
      ></div>

      <div class="results-banned">
        <h3>Banned Maps</h3>

        <div
          id="results-banned-list"
          class="results-banned-list"
        ></div>
      </div>

      <div class="results-actions">
        <button
          id="copy-btn"
          class="veto-btn"
        >
          📋 Copy Result
        </button>

        <button
          id="reset-btn"
          class="veto-btn veto-btn-secondary"
        >
          ↻ New Veto
        </button>
      </div>
    </div>
  </div>
</Layout>

<script
  type="application/json"
  id="match-data"
  set:html={JSON.stringify(matchData).replace(/</g, '\\u003c')}
/>

<script
  type="application/json"
  id="scrim-data"
  set:html={JSON.stringify(scrimVeto).replace(/</g, '\\u003c')}
/>

<style is:global>
  /* ===== Core Layout & Select ===== */

  .veto-select-wrap {
    margin-bottom: 2rem;
  }

  .veto-select-wrap label {
    display: block;
    margin: 0.75rem 0 0.4rem;
  }

  #scrim-form button {
    display: block;
    margin-top: 1rem;
  }

  .veto-select {
    width: 100%;
    max-width: 500px;
    background: var(--bg-card, #252528);
    border: 1px solid var(--border, #36363a);
    color: var(--text-primary, #e4e7eb);
    padding: 0.75rem 1rem;
    border-radius: var(--radius, 8px);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .veto-select:focus {
    outline: none;
    border-color: var(--accent, #ff742e);
  }

  /* ===== Empty Upcoming Match ===== */

  .veto-empty-state {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;

    margin-top: 1.25rem;
    padding: 0;
  }

  .veto-empty-copy {
    min-width: 0;
  }

  .veto-empty-copy strong {
    display: block;
    margin: 0 0 0.35rem;

    color: var(--text-primary, #e4e7eb);
    font-size: 1rem;
    font-weight: 700;
  }

  .veto-empty-copy p {
    max-width: 620px;
    margin: 0;

    color: var(--text-muted, #9ca3af);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .veto-empty-state .veto-btn {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* ===== Team Banners ===== */

  .veto-teams {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .veto-team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem 1.5rem;
    border-radius: var(--radius, 8px);
    min-width: 160px;
    transition: transform 0.2s;
  }

  .veto-team.team-a {
    background: rgba(59,130,246,0.12);
    border: 1px solid rgba(59,130,246,0.3);
  }

  .veto-team.team-b {
    background: rgba(249,115,22,0.12);
    border: 1px solid rgba(249,115,22,0.3);
  }

  .veto-team-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .team-a .veto-team-tag {
    color: #60a5fa;
  }

  .team-b .veto-team-tag {
    color: #fb923c;
  }

  .veto-team-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary, #e4e7eb);
  }

  .veto-vs {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-muted, #6b7280);
  }

  /* ===== Team Pick Cards ===== */

  .veto-picks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .pick-card {
    border-radius: var(--radius, 8px);
    padding: 1.25rem;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    text-align: center;
  }

  .pick-card.team-a {
    border-color: rgba(59,130,246,0.25);
    background: rgba(59,130,246,0.06);
  }

  .pick-card.team-b {
    border-color: rgba(249,115,22,0.25);
    background: rgba(249,115,22,0.06);
  }

  .pick-card.team-a.filled {
    border-color: #3b82f6;
    background: rgba(59,130,246,0.12);
    box-shadow: 0 4px 20px rgba(59,130,246,0.15);
  }

  .pick-card.team-b.filled {
    border-color: #f97316;
    background: rgba(249,115,22,0.12);
    box-shadow: 0 4px 20px rgba(249,115,22,0.15);
  }

  .pick-card.voided {
    border-color: rgba(239,68,68,0.4) !important;
    background: rgba(239,68,68,0.06) !important;
    box-shadow: none !important;
  }

  .pick-card-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .pick-team-tag {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(255,255,255,0.06);
  }

  .pick-card.team-a .pick-team-tag {
    color: #60a5fa;
  }

  .pick-card.team-b .pick-team-tag {
    color: #fb923c;
  }

  .pick-card-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #6b7280);
  }

  .pick-map-name {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
    color: var(--text-primary, #e4e7eb);
  }

  .pick-card.team-a.filled .pick-map-name {
    color: #60a5fa;
  }

  .pick-card.team-b.filled .pick-map-name {
    color: #fb923c;
  }

  .pick-card.voided .pick-map-name {
    color: #ef4444;
  }

  .pick-card-status {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted, #6b7280);
  }

  .pick-card.filled .pick-card-status {
    color: #22c55e;
  }

  .pick-card.voided .pick-card-status {
    color: #ef4444;
  }

  /* ===== Veto Step Pills ===== */

  .veto-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .veto-step {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid var(--border, #36363a);
    background: var(--bg-card, #252528);
    color: var(--text-primary, #e4e7eb);
    transition: all 0.2s;
  }

  .veto-step.team-a {
    border-color: rgba(59,130,246,0.3);
    background: rgba(59,130,246,0.06);
  }

  .veto-step.team-b {
    border-color: rgba(249,115,22,0.3);
    background: rgba(249,115,22,0.06);
  }

  .veto-step.active {
    transform: scale(1.05);
    box-shadow: 0 0 0 2px var(--accent, #ff742e);
    border-color: var(--accent, #ff742e);
    z-index: 2;
  }

  .veto-step.done {
    opacity: 0.5;
    filter: grayscale(0.5);
  }

  .veto-step .step-team {
    font-weight: 800;
    font-size: 0.75rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: rgba(255,255,255,0.06);
  }

  .veto-step.team-a .step-team {
    color: #60a5fa;
  }

  .veto-step.team-b .step-team {
    color: #fb923c;
  }

  .veto-step .step-action {
    color: #9ca3af;
    font-size: 0.75rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: rgba(255,255,255,0.04);
  }

  .veto-step .step-action.ban {
    color: #ef4444;
  }

  .veto-step .step-action.pick {
    color: #22c55e;
  }

  .veto-step .step-map {
    color: var(--accent, #ff742e);
    font-weight: 700;
  }

  .veto-step .step-void {
    color: #ef4444;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .veto-action-prompt {
    text-align: center;
    margin-bottom: 1.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary, #e4e7eb);
    min-height: 1.5em;
  }

  .veto-action-prompt .prompt-team {
    font-size: 1.25rem;
  }

  .veto-action-prompt .prompt-team.a {
    color: #60a5fa;
  }

  .veto-action-prompt .prompt-team.b {
    color: #fb923c;
  }

  .veto-action-prompt .prompt-action {
    color: var(--accent, #ff742e);
  }

  /* ===== Timer ===== */

  .veto-timer {
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--bg-card, #252528);
    border-radius: var(--radius, 8px);
    border: 1px solid var(--border, #36363a);
  }

  .timer-row {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .timer-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    max-width: 280px;
    min-width: 180px;
  }

  .timer-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted, #6b7280);
    white-space: nowrap;
    width: 60px;
  }

  .timer-bar-wrap {
    flex: 1;
    height: 12px;
    background: rgba(255,255,255,0.06);
    border-radius: 6px;
    overflow: hidden;
  }

  .timer-bar {
    height: 100%;
    border-radius: 6px;
    width: 100%;
    transition: width 1s linear, background 0.3s;
  }

  .timer-bar.green {
    background: #22c55e;
  }

  .timer-bar.amber {
    background: #f59e0b;
  }

  .timer-bar.red {
    background: #ef4444;
  }

  .timer-bar.inactive {
    background: rgba(255,255,255,0.12);
  }

  .timer-bar.red.active {
    animation: timer-pulse 0.5s infinite alternate;
  }

  @keyframes timer-pulse {
    from { opacity: 0.6; }
    to { opacity: 1; }
  }

  .timer-value {
    font-size: 0.9rem;
    font-weight: 700;
    min-width: 42px;
    text-align: right;
    color: var(--text-primary, #e4e7eb);
    font-variant-numeric: tabular-nums;
  }

  .timer-status {
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: 0.75rem;
    min-height: 1.2rem;
  }

  .timer-status.pick {
    color: #9ca3af;
  }

  .timer-status.reserve {
    color: #f59e0b;
  }

  .timer-status.void {
    color: #ef4444;
  }

  /* ===== Map Cards ===== */

  .veto-maps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .veto-map-card {
    background: var(--bg-card, #252528);
    border: 2px solid var(--border, #36363a);
    border-radius: var(--radius, 8px);
    padding: 1.25rem 1rem;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    position: relative;
    overflow: hidden;
    min-height: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--text-primary, #e4e7eb);
    font-family: inherit;
  }

  .veto-map-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .veto-map-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 55%);
    pointer-events: none;
  }

  .veto-map-card :is(.veto-map-name, .veto-map-status) {
    position: relative;
    z-index: 1;
    text-shadow: 0 2px 5px #000, 0 0 10px #000;
  }

  .veto-map-card:focus-visible {
    outline: 2px solid var(--accent, #ff742e);
    outline-offset: 2px;
  }

  .veto-maps.turn-a
  .veto-map-card:hover:not(.banned):not(.picked):not(.disabled) {
    border-color: #3b82f6 !important;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(59,130,246,0.25);
    background: rgba(59,130,246,0.08);
  }

  .veto-maps.turn-b
  .veto-map-card:hover:not(.banned):not(.picked):not(.disabled) {
    border-color: #f97316 !important;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(249,115,22,0.25);
    background: rgba(249,115,22,0.08);
  }

  .veto-map-card.disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .veto-map-card.banned {
    cursor: default;
    border-color: rgba(239,68,68,0.4);
