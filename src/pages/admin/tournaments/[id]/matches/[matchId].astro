---
export const prerender=false;
import {env} from 'cloudflare:workers';
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import MatchDetailsRead from '../../../../../components/admin/MatchDetailsRead.astro';
import Status from '../../../../../components/admin/StatusBadge.astro';
import {AdminError,requireLocalAdmin} from '../../../../../admin/tournaments.mjs';
import {readParticipantState} from '../../../../../admin/participants.mjs';
import {readMatchDetails,readDetailsForm,saveMatchDetails} from '../../../../../admin/match-details.mjs';
import {readCorrectionHistory} from '../../../../../admin/corrections.mjs';
const db=requireLocalAdmin(Astro.request,import.meta.env.DEV,env);const id=Astro.params.id!;const matchId=Astro.params.matchId!;
const editing=Astro.url.searchParams.get('edit')==='details';
let state;let workspace;let submitted;let history=[];let message='';let unavailable=false;
try{
 state=await readMatchDetails(db,id,matchId,{correction:editing});
 if(!state)Astro.response.status=404;
 else{
 workspace=await readParticipantState(db,id);
 try{history=(await readCorrectionHistory(db,id,matchId)).filter(entry=>entry.correction_type==='details');}catch(error){if(!/no such table.*match_correction_audit/.test(String(error?.message)))throw error;unavailable=true;}
 if(editing&&unavailable)state.reason='Detail corrections unavailable.';
 if(Astro.request.method==='POST'){
 submitted=await readDetailsForm(Astro.request);await saveMatchDetails(db,id,matchId,submitted);
 if(Astro.request.headers.get('accept')==='application/json'){const saved=await readMatchDetails(db,id,matchId);return new Response(JSON.stringify({revision:saved.revision,status:saved.status}),{headers:{'content-type':'application/json'}});}
 return Astro.redirect(`${Astro.url.pathname}?saved=complete`,303);
 }
 }
}catch(error){message=error instanceof AdminError?error.message:'Could not load or save match details.';Astro.response.status=error instanceof AdminError?error.status:503;if(Astro.request.headers.get('accept')==='application/json')return new Response(JSON.stringify({error:message}),{status:Astro.response.status,headers:{'content-type':'application/json'}});}
const payload=submitted?.payload??state?.payload;
const guided=!!state&&!state.reason&&!editing&&!state.payload.correction_required&&['empty','draft'].includes(state.status);
const writable=!!state&&!state.reason;
const correction=editing&&state?.correctable||state?.payload.correction_required===true;
const readMode=!!state&&!writable;
const Surface=guided?'dialog':'section';
---
<AdminLayout title="Match Details" workspace={workspace}>
 {!state?<><h1>Match Details unavailable</h1><p role="alert">{message}</p></>:<>
 {!guided&&<header class="admin-heading detail-heading"><div><h1>Match Details</h1><p class="detail-series">{state.match.team1_name} <strong>{state.match.result_type==='walkover'?'W/O':`${state.match.score1}-${state.match.score2}`}</strong> {state.match.team2_name}</p><Status label={state.status==='complete'?'Completed':state.status==='draft'?'Draft':readMode?'Read-only':'New details'} tone={state.status==='complete'?'ready':state.status==='draft'?'pending':'neutral'}/></div><div class="admin-actions">{workspace?.tournament.status!=='completed'&&<a class="admin-outline" href={`/admin/tournaments/${id}/bracket?match=${matchId}&edit=result`}>Edit Result</a>}<a href={`/admin/tournaments/${id}/matches`}>Back to Matches</a></div></header>}
 {message&&<p class="admin-error" role="alert">{message}</p>}
 {state.match.result_type==='walkover'?<p>Full-match W/O. No Match Details required.</p>:readMode?<>
 {state.reason&&JSON.parse(state.snapshot).children.every(n=>n===0)&&<p class="admin-help">{state.reason}</p>}
 <MatchDetailsRead db={db} state={state}/>
 {state.correctable&&!unavailable&&<a class="admin-outline" href={`${Astro.url.pathname}?edit=details`}>Edit Details</a>}
 </>:<>
 <Surface class={guided?'admin-dialog guided-details':'detail-workspace'} data-guided-dialog data-guided={String(guided)} aria-labelledby="detail-title">
 <header class="admin-heading"><div><h2 id="detail-title">{guided?'Match Details':'Edit Details'}</h2><p>{state.match.team1_name} <strong>{state.match.score1}-{state.match.score2}</strong> {state.match.team2_name}</p></div>{guided&&<button type="button" class="admin-outline" data-guided-close>Close</button>}</header>
 <form method="post" class="admin-form detail-editor" data-details-form data-guided={String(guided)}>
 <input type="hidden" name="revision" value={submitted?.revision??state.revision}/>
 <script type="application/json" data-validation-state set:html={JSON.stringify({match:state.match,rows:state.rows,pool:state.pool,assignments:state.assignments}).replaceAll('<','\\u003c')}/>
 <div class="detail-tabs" role="tablist" aria-label="Map steps">{payload.maps.map((map,i)=><button type="button" role="tab" data-map-tab={i} aria-selected={String(i===0)} aria-controls={`map-panel-${i}`} id={`map-step-${i}`} tabindex={i===0?0:-1}>Map {i+1}<small data-step-status>Not started</small></button>)}</div>
 {payload.maps.map((map,i)=><section data-map-panel id={`map-panel-${i}`} role="tabpanel" aria-labelledby={`map-step-${i}`} hidden={i!==0}>
 <div class="setup-grid"><label>Mode<select name={`maps.${i}.mode`} data-mode><option value="played" selected={map.mode!=='walkover'}>Played</option><option value="walkover" selected={map.mode==='walkover'}>W/O</option></select></label><div><span>Map {i+1}</span><strong class="official-map-name">{state.pool.find(item=>item.id===map.map_id)?.name??'Maps not assigned yet'}</strong><input type="hidden" name={`maps.${i}.map_id`} value={map.map_id} data-map/></div>
 {[1,2].map(side=><label data-played>{state.match[`team${side}_name`]} rounds<input name={`maps.${i}.score${side}`} value={map[`score${side}`]} inputmode="numeric" pattern="[0-9]*"/></label>)}
 <label data-walkover>W/O winner<select name={`maps.${i}.winner_side`}><option value="">Select winner</option>{[1,2].map(side=><option value={String(side)} selected={map.winner_side===String(side)}>{state.match[`team${side}_name`]}</option>)}</select></label></div>
 <div class="detail-team-tables" data-played>{[1,2].map(side=><table class="admin-table detail-kda"><caption>{state.match[`team${side}_name`]} · <span data-player-count></span></caption><thead><tr><th>IGN</th><th>K</th><th>D</th><th>A</th><th>MVP</th></tr></thead><tbody>{map.players.map((player,j)=>{const row=state.rows.find(row=>row.player_id===player.player_id);if(!row||row.team_id!==state.match[`team${side}_id`])return null;return <tr data-stat-row><th scope="row">{row.ign_snapshot}<input type="hidden" name={`maps.${i}.players.${j}.player_id`} value={player.player_id}/></th>{['kills','deaths','assists'].map(key=><td><input name={`maps.${i}.players.${j}.${key}`} value={player[key]} inputmode="numeric" pattern="[0-9]*" aria-label={`Map ${i+1} ${row.ign_snapshot} ${key}`} data-kda/></td>)}<td><label class="detail-mvp-target"><input type="radio" name={`mvp-choice-${i}`} value={player.player_id} checked={map.mvp===player.player_id} aria-label={`Gold ACE ${row.ign_snapshot}`} data-mvp-choice/></label></td></tr>;})}</tbody></table>)}</div>
 <input type="hidden" name={`maps.${i}.mvp`} value={map.mvp} data-mvp/>
 <p data-walkover>W/O map. No player statistics or MVP.</p>
 </section>)}
 <p data-derived-score role="status"></p><p data-detail-status role="status">{state.status==='draft'?'Draft saved':''}</p><p class="admin-error" data-detail-error role="alert"></p>
 {correction&&<label>Correction reason<input name="reason" value={submitted?.reason??''} maxlength="1000" required/></label>}
 <div class="admin-actions detail-action-bar">{guided?<><button type="button" class="admin-outline" data-previous>Previous</button><button type="button" class="admin-button" data-next>Next</button><button type="submit" name="intent" value="complete-details" class="admin-button" data-complete>Complete Details</button></>:<><button type="submit" name="intent" value={editing&&state.correctable?'correct-details':'complete-details'} class="admin-button">{correction?'Save Correction':'Complete Details'}</button><a href={Astro.url.pathname}>Cancel</a></>}</div>
 </form>
 </Surface>
 </>}
 {!guided&&history.length>0&&<section class="detail-section"><h2>Correction History ({history.length})</h2><ol>{history.map(entry=><li><time datetime={entry.created_at}>{new Date(entry.created_at).toLocaleString('en-GB',{timeZone:'Asia/Jakarta'})}</time><p>{entry.reason}</p></li>)}</ol></section>}
 </>}
</AdminLayout>
<script>
 import {setupGuidedDetails} from '../../../../../admin/guided-details';
 setupGuidedDetails();
</script>
