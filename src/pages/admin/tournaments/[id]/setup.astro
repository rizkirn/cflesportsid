---
export const prerender=false;
import {env} from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import {AdminError} from '../../../../admin/tournaments.mjs';
import {authorizeAdmin} from '../../../../admin/auth.mjs';
import {readSetupForm,saveSetup} from '../../../../admin/setup.mjs';
const db=(await authorizeAdmin(Astro.request,import.meta.env.DEV,env)).db;
const workspace=`/admin/tournaments/${Astro.params.id}`;
if(Astro.request.method!=='POST')return Astro.redirect(workspace,303);
let message='';
try{await saveSetup(db,Astro.params.id,await readSetupForm(Astro.request));return Astro.redirect(`${workspace}?saved=setup`,303);}catch(error){message=error instanceof AdminError?error.message:'Could not save setup. Review and try again.';Astro.response.status=error instanceof AdminError?error.status:503;}
---
<AdminLayout title="Setup"><h1>Could not save setup</h1><p class="admin-error" role="alert">{message}</p><a class="admin-button" href={workspace}>Back to Overview</a></AdminLayout>
