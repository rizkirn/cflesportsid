---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { AdminError, requireLocalAdmin } from '../../../../admin/tournaments.mjs';
import { readSetup, setupForm, readSetupForm, saveSetup, eliminationRounds } from '../../../../admin/setup.mjs';
import { readParticipantState } from '../../../../admin/participants.mjs';
const db = requireLocalAdmin(Astro.request, import.meta.env.DEV, env);
let setup; let values; let errorMessage = '';
try {
  setup = await readSetup(db, Astro.params.id);
  if (!setup) Astro.response.status = 404;
  else {
    values = setupForm(setup, !setup.locked && Astro.url.searchParams.get('template') === 'clash-for-glory');
    if (Astro.request.method === 'POST') {
      values = await readSetupForm(Astro.request);
      if (values.intent !== 'save' || values.remove_round !== undefined) throw new AdminError('Rounds are generated from bracket size.');
      await saveSetup(db, setup.tournament.id, values);
      return Astro.redirect(`/admin/tournaments/${setup.tournament.id}/setup?saved=1`, 303);
    }
  }
} catch (error) {
  if (setup?.locked) values = setupForm(setup);
  if (error instanceof AdminError) { errorMessage = error.message; Astro.response.status = error.status; }
  else { console.error('[admin] Setup failed', error); errorMessage = 'Could not load or save setup. Reload to review the saved state.'; Astro.response.status = 503; }
}
const fields = [ ['stage_name', 'Stage name', 'text', 1, 120], ['map_count', 'Maps per match', 'number', 1, 15], ['action_seconds', 'Action time (seconds)', 'number', 1, 300], ['reserve_seconds', 'Reserve time (seconds)', 'number', 1, 3600] ];
const workspace = setup ? await readParticipantState(db,setup.tournament.id) : null;
---
<AdminLayout title="Tournament Setup" workspace={workspace}>
  {errorMessage && <p role="alert" class="admin-error">{errorMessage}</p>}
  {!setup || !values ? <><h1>Tournament setup unavailable</h1><a href="/admin">Return to tournaments</a></> : <>
    <header class="admin-heading"><div><h1>{setup.tournament.name}</h1><p>Tournament Setup</p></div><span>{setup.tournament.status}</span></header>
    {setup.locked && <p class="admin-next">Setup is read-only. The tournament has started, its official bracket is saved, or it has multiple stages.</p>}
    {Astro.url.searchParams.has('saved') && <p role="status">Setup saved.</p>}
    {!setup.locked && <details class="setup-template"><summary>Clash for Glory template</summary><p>16 slots, Bronze Match, three maps per match, 20-second actions and 90-second reserves.</p><a href="?template=clash-for-glory">Fill from template</a><p class="admin-help">Review the fields and save to apply.</p></details>}
    <form method="post" class="admin-form setup-form" data-pending-form>
      <input type="hidden" name="revision" value={values.revision} /><input type="hidden" name="stage_id" value={values.stage_id} />
      {['format', 'series_type', 'final_map_rule'].map(key => <input type="hidden" name={key} value={values[key as keyof typeof values] as string} />)}
      <fieldset disabled={setup.locked} class="setup-stage"><legend>Stage settings</legend><p class="admin-help">Single elimination · Fixed maps · Random final map</p>
        <div class="setup-grid">
          <div><label for="bracket_size">Bracket size</label><select id="bracket_size" name="bracket_size">{[4,8,16,32].map(size => <option value={size} selected={values.bracket_size === String(size)}>{size} teams</option>)}</select></div>
          {fields.map(([key, label, type, min, max]) => <div><label for={String(key)}>{label}</label><input id={String(key)} name={String(key)} type={String(type)} value={values[key as keyof typeof values] as string} min={type === 'number' ? min : undefined} max={type === 'number' ? max : undefined} maxlength={type === 'text' ? 120 : undefined} required /></div>)}
        </div>
        <label class="admin-checkbox"><input id="bronze_match" type="checkbox" name="bronze_match" value="1" checked={values.bronze_match === '1'} />Include Bronze Match</label>
      </fieldset>
      <section class="setup-rounds"><h2>Generated rounds</h2><p class="admin-help">Elimination rounds follow the bracket size. Bronze Match uses the Semi Final losers.</p><ol data-generated-rounds>{(setup.locked ? values.rounds : eliminationRounds([4,8,16,32].includes(Number(values.bracket_size)) ? values.bracket_size : 16, values.bronze_match === '1')).map(round => <li>{round.name}</li>)}</ol></section>
      <div class="admin-actions">{!setup.locked && <button type="submit" class="admin-button">Save Setup</button>}<a href={`/admin/tournaments/${setup.tournament.id}/participants`}>Manage Participants</a></div>
      <p class="admin-submit-status admin-help" role="status" aria-live="polite"></p>
    </form>
  </>}
</AdminLayout>
<script>
  import { eliminationRounds } from '../../../../admin/setup.mjs';
  const size = document.querySelector<HTMLSelectElement>('#bracket_size'); const bronze = document.querySelector<HTMLInputElement>('#bronze_match'); const list = document.querySelector('[data-generated-rounds]');
  if (size && bronze && list && !size.closest('fieldset')?.disabled) {
    const update = () => list.replaceChildren(...eliminationRounds(size.value, bronze.checked).map(round => { const li = document.createElement('li'); li.textContent = round.name; return li; }));
    size.addEventListener('change', update); bronze.addEventListener('change', update);
  }
</script>
