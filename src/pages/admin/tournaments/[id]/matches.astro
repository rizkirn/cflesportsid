---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireLocalAdmin, getTournament } from '../../../../admin/tournaments.mjs';
import { readParticipantState } from '../../../../admin/participants.mjs';
const db = requireLocalAdmin(Astro.request, import.meta.env.DEV, env);
let tournament; let matches = []; let failed = false; let workspace;
try {
  tournament = await getTournament(db, Astro.params.id);
  if (!tournament) Astro.response.status = 404;
  else {
    workspace = await readParticipantState(db,tournament.id);
    const result = await db.batch([db.prepare(`SELECT m.*,r.name AS round_name,t1.name AS team1_name,t2.name AS team2_name,
      s1.source_type AS source1_type,s1.source_match_id AS source1_match,s1.source_bye_id AS source1_bye,
      s2.source_type AS source2_type,s2.source_match_id AS source2_match,s2.source_bye_id AS source2_bye,
      sr1.name AS source1_round,p1.bracket_slot AS source1_slot,sr2.name AS source2_round,p2.bracket_slot AS source2_slot
      FROM matches m JOIN tournament_rounds r ON r.tournament_id=m.tournament_id AND r.stage_id=m.stage_id AND r.id=m.round_id
      LEFT JOIN teams t1 ON t1.id=m.team1_id LEFT JOIN teams t2 ON t2.id=m.team2_id
      LEFT JOIN match_sources s1 ON s1.match_id=m.id AND s1.side=1 LEFT JOIN match_sources s2 ON s2.match_id=m.id AND s2.side=2
      LEFT JOIN matches p1 ON p1.id=s1.source_match_id LEFT JOIN matches p2 ON p2.id=s2.source_match_id
      LEFT JOIN tournament_rounds sr1 ON sr1.tournament_id=p1.tournament_id AND sr1.stage_id=p1.stage_id AND sr1.id=p1.round_id
      LEFT JOIN tournament_rounds sr2 ON sr2.tournament_id=p2.tournament_id AND sr2.stage_id=p2.stage_id AND sr2.id=p2.round_id
      WHERE m.tournament_id=? ORDER BY r.sort_order,m.bracket_slot`).bind(tournament.id)]);
    if (!result[0].success) throw new Error('Match read failed');
    matches = result[0].results;
  }
} catch(error) { console.error('[admin] Match read failed',error); failed=true; Astro.response.status=503; }
const label = (match,side) => match[`team${side}_name`] ?? (match[`source${side}_type`] ? `${match[`source${side}_type`]==='loser'?'Loser':'Winner'} of ${match[`source${side}_round`] ?? 'opening BYE'}${match[`source${side}_slot`] ? ` · Slot ${match[`source${side}_slot`]}` : ''}` : 'TBD');
---
<AdminLayout title="Matches" workspace={workspace}>
  {failed ? <p class="admin-error" role="alert">Could not load matches. Check staging and reload.</p> : !tournament ? <><h1>Tournament not found</h1><a href="/admin">Back to tournaments</a></> : <>
    <header class="admin-heading"><div><h1>{tournament.name}</h1><p>Matches</p></div><a href={`/admin/tournaments/${tournament.id}/bracket`}>Open Bracket</a></header>
    {matches.length ? <><p class="admin-help">Official bracket saved. Setup, Participants and Roster are locked. Update live scores and confirm results in Bracket. Scheduling and detailed stats entry are later work.</p><ul class="admin-list">{matches.map(match=><li><div><h2>{match.round_name} · Slot {match.bracket_slot}</h2><p>{label(match,1)} vs {label(match,2)}</p></div><div class="admin-row-end"><span>{match.score1}–{match.score2} · {match.status}</span><span>{match.date}</span></div></li>)}</ul></> : <section class="admin-empty"><h2>No matches yet</h2><p>Confirm the final draw in Bracket Setup to create matches.</p></section>}
  </>}
</AdminLayout>
