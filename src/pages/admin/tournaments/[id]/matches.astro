---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import MatchesBrowser from '../../../../components/admin/MatchesBrowser.astro';
import {authorizeAdmin} from '../../../../admin/auth.mjs';
import { readParticipantState } from '../../../../admin/participants.mjs';
const db=(await authorizeAdmin(Astro.request,import.meta.env.DEV,env)).db;
let workspace;let failed=false;
try {workspace=await readParticipantState(db,Astro.params.id);if(!workspace)Astro.response.status=404;}catch{failed=true;Astro.response.status=503;}
---
<AdminLayout title="Matches" workspace={workspace}>{failed?<p class="admin-error" role="alert">Could not load tournament. Reload to try again.</p>:!workspace?<p class="admin-empty">Tournament not found.</p>:<><header class="admin-heading"><h1>Matches</h1><a href={`/admin/tournaments/${workspace.tournament.id}/bracket`}>Open Bracket</a></header><MatchesBrowser db={db} tournamentId={workspace.tournament.id}/></>}</AdminLayout>
