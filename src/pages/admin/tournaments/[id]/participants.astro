---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { AdminError, requireLocalAdmin } from '../../../../admin/tournaments.mjs';
import { readParticipantState, participantForm, readParticipantForm, editParticipantForm, saveParticipants } from '../../../../admin/participants.mjs';
const db = requireLocalAdmin(Astro.request, import.meta.env.DEV, env);
let state; let values; let errorMessage = '';
try {
  state = await readParticipantState(db, Astro.params.id);
  if (!state) Astro.response.status = 404;
  else {
    values = participantForm(state);
    if (Astro.request.method === 'POST') {
      values = await readParticipantForm(Astro.request);
      if (!['add-selected', 'remove-selected', 'add-new'].includes(values.intent)) throw new AdminError('Choose Add Selected, Remove Selected or Create Team.');
      await editParticipantForm(values, state);
      await saveParticipants(db, state.tournament.id, values);
      return Astro.redirect(`/admin/tournaments/${state.tournament.id}/participants?saved=1`, 303);
    }
  }
} catch (error) {
  if (error instanceof AdminError) { errorMessage = error.message; Astro.response.status = error.status; }
  else { console.error('[admin] Participants failed', error); errorMessage = 'Could not save participants. Reload to review the saved state.'; Astro.response.status = 503; }
  if (state && values) values.participants = participantForm(state).participants;
}
const editable = state?.ready && !state.locked;
const rows = state?.participants ?? [];
const allTeams = state?.teams ?? [];
---
<AdminLayout title="Participants" workspace={state}>
  {errorMessage && <p role="alert" class="admin-error">{errorMessage}</p>}
  {!state || !values ? <><h1>Participants unavailable</h1><a href="/admin">Back to tournaments</a></> : <>
    <header class="admin-heading"><div><h1>{state.tournament.name}</h1><p>Participants</p></div><span class="participant-counter">{rows.length} / {state.stage?.[3] ?? 0} teams</span></header>
    {!editable && <p class="admin-next">Participants are read-only. {state.locked ? 'The tournament has started or its official bracket is saved.' : 'Save Tournament Setup before adding teams.'}</p>}
    {Astro.url.searchParams.has('saved') && <p role="status">Participants saved. Review copied rosters before the draw.</p>}
    <p class="admin-help">Select teams in the table, then add or remove them in one action. Adding a team copies its most recent earlier tournament roster when available. A player already registered here stays with their current team; review incomplete copied rosters in Roster.</p>
    <form method="post" class="admin-form participant-form" data-pending-form>
      <input type="hidden" name="revision" value={values.revision} />
      {rows.map((team,index) => ['id','name','tag','region'].map(key => <input type="hidden" name={`participants.${index}.${key}`} value={team[key as keyof typeof team]} />))}
      <div class="table-toolbar"><div><label for="team-search">Search teams</label><input id="team-search" type="search" autocomplete="off" /></div><div><label for="team-filter">Show</label><select id="team-filter"><option value="all">All teams</option><option value="registered">Participants</option><option value="available">Available teams</option></select></div></div>
      {editable && <div class="admin-actions table-actions"><button class="admin-button" type="submit" name="intent" value="add-selected" formnovalidate>Add Selected</button><button class="admin-outline" type="submit" name="intent" value="remove-selected" formnovalidate>Remove Selected</button><button class="admin-outline" type="button" data-select-visible>Select visible</button><button class="admin-outline" type="button" data-clear-selection>Clear selection</button></div>}
      <p class="admin-help" data-team-status role="status" aria-live="polite">{allTeams.length} teams · 0 selected</p>
      <table class="admin-table" data-team-table><caption>Team directory and participant registration</caption><thead><tr>{editable && <th scope="col">Select</th>}<th scope="col">Team</th><th scope="col">Tag / Region</th><th scope="col">Registration</th></tr></thead><tbody>
        {allTeams.map(team => { const registered = rows.some(row => row.id === team.id); return <tr data-team-row data-search={`${team.name} ${team.tag} ${team.region} ${team.id}`.normalize('NFKC').toLowerCase()} data-registration={registered ? 'registered' : 'available'}>
          {editable && <td data-label="Select"><input type="checkbox" name={`selected.${team.id}`} value="1" aria-label={`Select ${team.name}`} /></td>}
          <td data-label="Team"><strong>{team.name}</strong></td><td data-label="Tag / Region">{team.tag} · {team.region}</td><td data-label="Registration">{registered ? 'Participant' : 'Available'}</td>
        </tr>; })}
      </tbody></table>
      <p class="admin-empty" data-no-teams hidden>No teams match this search. Change the search or filter.</p>
      {!allTeams.length && <p class="admin-empty">No teams exist yet. Create Team to register the first participant.</p>}
      {editable && <details class="participant-create" open={!!values.new_name || values.intent === 'add-new'}><summary>Create Team</summary><div class="setup-grid"><div><label for="new_name">Team name</label><input id="new_name" name="new_name" value={values.new_name} maxlength="120" /></div><div><label for="new_tag">Team tag</label><input id="new_tag" name="new_tag" value={values.new_tag} maxlength="20" /></div><div><label for="new_region">Region</label><input id="new_region" name="new_region" value={values.new_region} maxlength="32" /></div></div><p class="admin-help">Creates the team and registers it in this tournament.</p><button class="admin-outline" type="submit" name="intent" value="add-new" formnovalidate>Create and Add Team</button></details>}
      <p class="admin-submit-status admin-help" role="status" aria-live="polite"></p>
    </form>
    <div class="admin-actions roster-continue"><a class="admin-button" href={`/admin/tournaments/${state.tournament.id}/roster`}>Manage Roster</a></div>
  </>}
</AdminLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('#team-search'); const filter = document.querySelector<HTMLSelectElement>('#team-filter');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-team-row]')); const status = document.querySelector('[data-team-status]'); const empty = document.querySelector<HTMLElement>('[data-no-teams]');
  const update = () => { const query = search?.value.normalize('NFKC').trim().toLowerCase() ?? ''; rows.forEach(row => { row.hidden = !row.dataset.search?.includes(query) || (filter?.value !== 'all' && row.dataset.registration !== filter?.value); }); const visible = rows.filter(row => !row.hidden).length; const selected = rows.filter(row => row.querySelector<HTMLInputElement>('input')?.checked).length; if (status) status.textContent = `${visible} teams shown · ${selected} selected`; if (empty) empty.hidden = visible > 0; };
  search?.addEventListener('input', update); filter?.addEventListener('change', update); rows.forEach(row => row.addEventListener('change', update));
  document.querySelector('[data-select-visible]')?.addEventListener('click', () => { rows.filter(row => !row.hidden).forEach(row => { const box = row.querySelector<HTMLInputElement>('input'); if (box) box.checked = true; }); update(); });
  document.querySelector('[data-clear-selection]')?.addEventListener('click', () => { rows.forEach(row => { const box = row.querySelector<HTMLInputElement>('input'); if (box) box.checked = false; }); update(); });
  search?.addEventListener('keydown', event => { if (event.key === 'Enter') event.preventDefault(); });
</script>
