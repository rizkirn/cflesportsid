---
export const prerender=false;
import {env} from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import UnsavedChanges from '../../../../components/admin/UnsavedChanges.astro';
import {saveMaster} from '../../../../admin/master-data.mjs';
import {AdminError,requireLocalAdmin} from '../../../../admin/tournaments.mjs';
import {readParticipantState,participantForm,readParticipantForm,saveParticipants} from '../../../../admin/participants.mjs';
const db=requireLocalAdmin(Astro.request,import.meta.env.DEV,env);
let state;let values;let message='';
try{
 state=await readParticipantState(db,Astro.params.id);
 if(!state)Astro.response.status=404;
 else{values=participantForm(state);if(Astro.request.method==='POST'){
 values=await readParticipantForm(Astro.request);
 if(state.locked||!state.ready)throw new AdminError('Participants are read-only.',409);
 if(values.intent==='create-team'){
 if(values.revision!==state.revision)throw new AdminError('Participants changed. Reload before creating a team.',409);
 if(values.participants.length>=state.stage[3])throw new AdminError('Bracket capacity reached.');
 const id=await saveMaster(db,'teams',null,{intent:'create',name:values.new_name,tag:values.new_tag,region:values.new_region});
 const team=(await readParticipantState(db,state.tournament.id)).teams.find(team=>team.id===id);
 return new Response(JSON.stringify(team),{headers:{'content-type':'application/json'}});
 }
 if(values.intent!=='save')throw new AdminError('Choose Save Teams.');
 await saveParticipants(db,state.tournament.id,values);
 return Astro.redirect(`/admin/tournaments/${state.tournament.id}/roster`,303);
 }}
}catch(error){message=error instanceof AdminError?error.message:'Could not save teams. Review your selection and try again.';Astro.response.status=error instanceof AdminError?error.status:503;if(Astro.request.headers.get('accept')==='application/json')return new Response(JSON.stringify({error:message}),{status:Astro.response.status,headers:{'content-type':'application/json'}});}
const editable=state?.ready&&!state.locked;
const teamRows=[...(state?.teams??[]).map(team=>({...team,key:team.id})),...(values?.participants??[]).flatMap((team,index)=>team.id?[]:[{...team,key:`draft-${index}`}])];
---
<AdminLayout title="Participants" workspace={state}>
 {message&&<p class="admin-error" role="alert">{message}</p>}
 {!state||!values?<h1>Participants unavailable</h1>:<>
 <header class="admin-heading"><h1>Participants</h1><span data-capacity>{values.participants.length}/{state.stage?.[3]??0}</span></header>
 {!editable&&<p class="admin-next">Participants are read-only.</p>}
 <form method="post" class="admin-form" data-pending-form data-participant-form data-draft-form data-dirty={String(Astro.request.method==='POST')}>
 <input type="hidden" name="revision" value={values.revision}/><input type="hidden" name="intent" value="save"/>
 <div data-pending-teams>{values.participants.map((team,index)=>['id','name','tag','region'].map(key=><input type="hidden" name={`participants.${index}.${key}`} value={team[key]}/>))}</div>
 <div class="table-toolbar"><label>Search teams<input type="search" data-team-search/></label><label>Show<select data-team-filter><option value="all">All teams</option><option value="registered">Participants</option><option value="available">Available</option></select></label></div>
 <table class="admin-table operational-table"><thead><tr><th>Team</th><th>Tag / Region</th><th>Action</th></tr></thead><tbody>{teamRows.map(team=>{const added=values.participants.some(row=>row.id===team.id);return <tr class:list={{'is-selected':added}} data-team-row data-key={team.key} data-id={team.id} data-name={team.name} data-tag={team.tag} data-region={team.region} data-added={added?'1':'0'}><td data-label="Team">{team.name}</td><td data-label="Tag / Region">{team.tag} · {team.region}</td><td data-label="Action">{editable?<button type="button" class="admin-outline" data-toggle-team>{added?'Remove':'Add'}</button>:added?'Participant':'Available'}</td></tr>;})}</tbody></table>
 <p class="admin-empty" data-no-teams hidden>No matching teams.</p>
 {editable&&<button type="button" class="admin-outline" data-create-team hidden>+ Create New Team</button>}
 <span data-team-dirty role="status"></span>
 {editable&&<div class="draft-action-bar admin-actions" data-draft-bar hidden><span>Unsaved team changes</span><button type="submit" class="admin-button">Save Teams</button><p class="admin-submit-status" role="status"></p></div>}
 <dialog class="admin-dialog" data-team-dialog aria-labelledby="team-title"><header class="admin-heading"><h2 id="team-title">Create Team</h2><button type="button" class="admin-outline" data-close-team>Close</button></header><label>Name<input data-new-name maxlength="120"/></label><label>Tag<input data-new-tag maxlength="20"/></label><label>Region<input data-new-region value="ID" maxlength="32"/></label><p data-new-error role="alert"></p><button type="button" class="admin-button" data-add-new-team>Create &amp; Add</button></dialog>
 </form>
 <UnsavedChanges message="Unsaved team changes"/>
 </>}
</AdminLayout>
<script>
 const form=document.querySelector<HTMLFormElement>('[data-participant-form]');
 const container=document.querySelector<HTMLElement>('[data-pending-teams]');
 const rows=Array.from(document.querySelectorAll<HTMLElement>('[data-team-row]'));
 const search=document.querySelector<HTMLInputElement>('[data-team-search]');const filter=document.querySelector<HTMLSelectElement>('[data-team-filter]');
 const pending:Array<Record<string,string>>=[];
 container?.querySelectorAll<HTMLInputElement>('input').forEach(input=>{const [,index,key]=input.name.split('.');pending[Number(index)]??={};pending[Number(index)][key]=input.value;});
 pending.forEach((team,index)=>team.key=team.id||`draft-${index}`);
 const capacity=Number(document.querySelector('[data-capacity]')?.textContent?.split('/')[1]);
 const update=()=>{
 container?.replaceChildren(...pending.flatMap((team,index)=>['id','name','tag','region'].map(key=>{const input=document.createElement('input');input.type='hidden';input.name=`participants.${index}.${key}`;input.value=team[key];return input;})));
 const query=search?.value.trim().toLowerCase()??'';
 rows.forEach(row=>{const added=pending.some(team=>team.key===row.dataset.key);row.dataset.added=added?'1':'0';row.classList.toggle('is-selected',added);const button=row.querySelector('[data-toggle-team]');if(button)button.textContent=added?'Remove':'Add';row.hidden=!`${row.dataset.name} ${row.dataset.tag} ${row.dataset.region}`.toLowerCase().includes(query)||(filter?.value==='registered'&&!added)||(filter?.value==='available'&&added);});
 const count=document.querySelector('[data-capacity]');if(count)count.textContent=`${pending.length}/${capacity}`;
 const empty=document.querySelector<HTMLElement>('[data-no-teams]');if(empty)empty.hidden=rows.some(row=>!row.hidden);
 const createButton=document.querySelector<HTMLElement>('[data-create-team]');if(createButton)createButton.hidden=!query||rows.some(row=>!row.hidden);
 };
 const dirty=()=>form?.dispatchEvent(new Event('draftchange'));
 rows.forEach(row=>row.querySelector('[data-toggle-team]')?.addEventListener('click',()=>{const index=pending.findIndex(team=>team.key===row.dataset.key);if(index>=0)pending.splice(index,1);else{if(pending.length>=capacity){const status=document.querySelector('[data-team-dirty]');if(status)status.textContent='Bracket capacity reached.';return;}pending.push({id:row.dataset.id!,key:row.dataset.key!,name:row.dataset.name!,tag:row.dataset.tag!,region:row.dataset.region!});}update();dirty();}));
 search?.addEventListener('input',update);filter?.addEventListener('change',update);search?.addEventListener('keydown',event=>{if(event.key==='Enter')event.preventDefault();});
 const dialog=document.querySelector<HTMLDialogElement>('[data-team-dialog]');document.querySelector('[data-create-team]')?.addEventListener('click',()=>{document.querySelector<HTMLInputElement>('[data-new-name]')!.value=search?.value.trim()??'';dialog?.showModal();});document.querySelector('[data-close-team]')?.addEventListener('click',()=>dialog?.close());
 document.querySelector('[data-add-new-team]')?.addEventListener('click',async()=>{
 const name=document.querySelector<HTMLInputElement>('[data-new-name]')!.value.trim();const tag=document.querySelector<HTMLInputElement>('[data-new-tag]')!.value.trim();const region=document.querySelector<HTMLInputElement>('[data-new-region]')!.value.trim();const error=document.querySelector('[data-new-error]');
 if(name.length<3||!tag||region.length<2||pending.length>=capacity){if(error)error.textContent='Enter name, tag and region. Check bracket capacity.';return;}
 const button=document.querySelector<HTMLButtonElement>('[data-add-new-team]')!;button.disabled=true;
 let master;try{const data=new FormData(form!);data.set('intent','create-team');data.set('new_name',name);data.set('new_tag',tag);data.set('new_region',region);const response=await fetch(location.href,{method:'POST',headers:{accept:'application/json'},body:new URLSearchParams(Array.from(data.entries()).map(([key,value])=>[key,String(value)]))});master=await response.json();if(!response.ok)throw Error(master.error);}catch(reason){if(error)error.textContent=(reason as Error).message;button.disabled=false;return;}button.disabled=false;
 const key=master.id;pending.push({id:key,key,name:master.name,tag:master.tag,region:master.region});const row=document.createElement('tr');Object.assign(row.dataset,{teamRow:'',id:key,key,name,tag,region});
 for(const [label,value]of [['Team',name],['Tag / Region',`${tag} · ${region}`]]){const cell=document.createElement('td');cell.dataset.label=label;cell.textContent=value;row.append(cell);}
 const cell=document.createElement('td');cell.dataset.label='Action';const remove=document.createElement('button');remove.type='button';remove.className='admin-outline';remove.textContent='Remove';const team=pending.at(-1)!;
 remove.dataset.toggleTeam='';remove.addEventListener('click',()=>{const index=pending.indexOf(team);if(index>=0)pending.splice(index,1);else if(pending.length<capacity)pending.push(team);update();dirty();});cell.append(remove);row.append(cell);rows.push(row);form?.querySelector('tbody')?.append(row);
 document.querySelector<HTMLInputElement>('[data-new-name]')!.value='';document.querySelector<HTMLInputElement>('[data-new-tag]')!.value='';if(error)error.textContent='';update();dirty();dialog?.close();
 });
</script>
