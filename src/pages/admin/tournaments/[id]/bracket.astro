---
export const prerender=false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import ResultInspector from '../../../../components/admin/ResultInspector.astro';
import OperationalBracket from '../../../../components/admin/OperationalBracket.astro';
import { AdminError, requireLocalAdmin } from '../../../../admin/tournaments.mjs';
import { readBracketState, readBracketForm, officialDraw, confirmOfficialBracket } from '../../../../admin/bracket.mjs';
import { readLiveResults } from '../../../../admin/live-results.mjs';
import { readResultEditorForm, saveEditedResult } from '../../../../admin/result-editor.mjs';
const db=requireLocalAdmin(Astro.request,import.meta.env.DEV,env);
let state;let live;let preview;let submitted;let message='';let drawCount='1';
const secret=(env as unknown as { ADMIN_DRAW_KEY?: string }).ADMIN_DRAW_KEY;
try {
  state=await readBracketState(db,Astro.params.id);
  if(!state)Astro.response.status=404;
  else {
    live=await readLiveResults(db,state.tournament.id);
    if(Astro.request.method==='POST') {
      const form=Astro.url.searchParams.has('match')?await readResultEditorForm(Astro.request):await readBracketForm(Astro.request);
      submitted=form;drawCount=form.draw_count??'1';
      if(form.intent==='edit-result') {
        if(form.match_id!==Astro.url.searchParams.get('match'))throw new AdminError('Selected match changed. Reload the inspector.',409);
        await saveEditedResult(db,state.tournament.id,form);
        return Astro.redirect(`${Astro.url.pathname}?match=${encodeURIComponent(form.match_id)}&saved=result`,303);
      }
      if(form.intent==='draw')preview=await officialDraw(state,form,secret);
      else if(form.intent==='confirm') {
        await confirmOfficialBracket(db,state.tournament.id,form,secret);
        return Astro.redirect(Astro.url.pathname,303);
      }else throw new AdminError('Unknown bracket action.');
    }
  }
}catch(error) {
  message=error instanceof AdminError?error.message:'Could not load or save the bracket. Reload to review the saved state.';
  Astro.response.status=error instanceof AdminError?error.status:503;
  if(!(error instanceof AdminError))console.error('[admin] Bracket operation failed',error);
}
const name=(id)=>state?.participants.find(team=>team.id===id)?.name??id;
const selected=live?.matches.find(match=>match.id===Astro.url.searchParams.get('match'));
const enough=state?.stage&&state.participants.length>=Math.max(2,state.stage[3]/2)&&state.participants.length<=state.stage[3];
---
<AdminLayout title="Bracket" workspace={state}>
  {message&&!selected&&<p class="admin-error" role="alert">{message}</p>}
  {!state?<><h1>Tournament unavailable</h1><a href="/admin/tournaments">Back to tournaments</a></>:<>
    <header class="admin-heading"><div><h1>Bracket</h1><p>Fixed {state.stage?.[5] ?? 3} Maps</p></div><a href={`/admin/tournaments/${state.tournament.id}/matches`}>Open Matches</a></header>
    {Astro.url.searchParams.get('saved')==='result'&&<p role="status">Result saved. Progression and correction history are up to date.</p>}
    {live?.matches.length?<div>
      <section class="admin-master">
        <OperationalBracket db={db} state={state} live={live} selected={selected}/>
      </section>
      {selected&&<ResultInspector db={db} state={state} live={live} match={selected} submitted={submitted} message={message}/>}
    </div>:state.locked?<section class="admin-empty"><h2>Bracket is read-only</h2><a href={`/admin/tournaments/${state.tournament.id}/matches`}>View Matches</a></section>:!state.ready?<section class="admin-empty"><h2>Competition setup required</h2><a href={`/admin/tournaments/${state.tournament.id}/setup`}>Configure competition</a></section>:!state.roster.ready?<section class="admin-empty"><h2>Roster incomplete</h2><p>Each participant needs 5 to 7 players with a saved tournament IGN.</p><a href={`/admin/tournaments/${state.tournament.id}/roster`}>Open Roster</a></section>:!enough?<section class="admin-empty"><h2>Review participant count</h2><p>This {state.stage[3]}-slot bracket needs {Math.max(2,state.stage[3]/2)} to {state.stage[3]} teams.</p><a href={`/admin/tournaments/${state.tournament.id}/participants`}>Open Participants</a></section>:<>
      <form method="post" class="admin-form" data-pending-form><input type="hidden" name="intent" value="draw"/><input type="hidden" name="revision" value={state.revision}/><label>Draw count<input type="number" name="draw_count" min="1" max="20" step="1" value={drawCount} required/></label><p class="admin-help">Review 1 to 20 draws. Only the final candidate can be confirmed.</p><button type="submit" class="admin-button">{preview?'Start New Draw':'Start Official Draw'}</button><p class="admin-submit-status" role="status"></p></form>
      {preview&&<><div class="draw-sequence">{preview.draws.map((bracket,index)=><details name="official-draw-history" class="official-draw" data-final={index===preview.draws.length-1?'true':'false'} open={index===preview.draws.length-1}><summary>Draw {index+1}{index===preview.draws.length-1?' · Final candidate':''}</summary><h2>Draw {index+1} of {preview.draws.length}{index===preview.draws.length-1?': Final candidate':''}</h2><div class="official-rounds" style={`--official-round-count:${bracket.tournament.data.stages[0].rounds.length}`}>{bracket.tournament.data.stages[0].rounds.map(round=><section><h3>{round.name}</h3><ol class="official-slots">{bracket.draw.filter(entry=>entry.roundId===round.id).map(entry=><li><strong>Match {entry.number}{entry.kind==='bye'?' · BYE':''}</strong><span>{name(entry.team1)??`${round.placement===3?'Loser':'Winner'} of Match ${entry.source1}`}</span><span>{entry.kind==='bye'?'Advances automatically':name(entry.team2)??`${round.placement===3?'Loser':'Winner'} of Match ${entry.source2}`}</span></li>)}</ol></section>)}</div></details>)}</div>
        <div class="admin-next" data-confirm-form><button type="button" class="admin-button" data-open-draw-confirm>Confirm Official Bracket</button><dialog class="admin-dialog" data-draw-confirm aria-labelledby="draw-confirm-title"><h2 id="draw-confirm-title">Confirm Draw {preview.draws.length}</h2><p>Creates matches and progression. Setup, participants and rosters become read-only.</p><form method="post" class="admin-form" data-pending-form><input type="hidden" name="intent" value="confirm"/><input type="hidden" name="revision" value={state.revision}/><input type="hidden" name="token" value={preview.token}/><div class="admin-actions"><button type="button" class="admin-outline" data-close-draw-confirm>Cancel</button><button type="submit" class="admin-button">Confirm Draw</button></div><p class="admin-submit-status" role="status"></p></form></dialog></div>
      </>}
    </>}
  </>}
</AdminLayout>
<script>
  const draws=Array.from(document.querySelectorAll<HTMLDetailsElement>('[name="official-draw-history"]'));
  const confirmation=document.querySelector<HTMLElement>('[data-confirm-form]');
  const drawDialog=document.querySelector<HTMLDialogElement>('[data-draw-confirm]');
  document.querySelector('[data-open-draw-confirm]')?.addEventListener('click',()=>drawDialog?.showModal());
  document.querySelector('[data-close-draw-confirm]')?.addEventListener('click',()=>drawDialog?.close());
  if(draws.length){
    const nav=document.createElement('nav');nav.className='draw-pagination';nav.setAttribute('aria-label','Draw navigation');draws[0].parentElement?.before(nav);
    let current=draws.length-1;
    const render=()=>{nav.replaceChildren();const edges=nav.clientWidth<380&&current>1&&current<draws.length-2?[0,draws.length-1]:[0,1,draws.length-2,draws.length-1];const visible=new Set([...edges,current-1,current,current+1].filter(index=>index>=0&&index<draws.length));let previous=-1;
      [...visible].sort((a,b)=>a-b).forEach(index=>{if(previous>=0&&index>previous+1){const gap=document.createElement('span');gap.textContent='…';nav.append(gap);}const button=document.createElement('button');button.type='button';button.className='admin-outline';button.textContent=String(index+1);button.setAttribute('aria-current',index===current?'page':'false');button.addEventListener('click',()=>{current=index;draws.forEach((draw,i)=>{draw.hidden=i!==current;draw.open=i===current;});if(confirmation)confirmation.hidden=current!==draws.length-1;render();});nav.append(button);previous=index;});};
    draws.forEach((draw,index)=>{draw.hidden=index!==current;draw.open=index===current;});render();window.addEventListener('resize',render);
  }
  draws.forEach(draw=>draw.addEventListener('toggle',()=>{
    if(draw.open)draws.filter(other=>other!==draw).forEach(other=>other.open=false);
    if(confirmation)confirmation.hidden=!draws.some(row=>row.open&&row.dataset.final==='true');
  }));
</script>
