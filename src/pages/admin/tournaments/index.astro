---
export const prerender=false;
import {env} from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Status from '../../../components/admin/StatusBadge.astro';
import {AdminError,listTournaments,readAdminForm,deleteTestTournament,metadataRevision,saveTournamentMetadata} from '../../../admin/tournaments.mjs';
import {authorizeAdmin} from '../../../admin/auth.mjs';
const db=(await authorizeAdmin(Astro.request,import.meta.env.DEV,env)).db;
let tournaments=[];let message='';let failed=false;let submitted;
try{if(Astro.request.method==='POST'){submitted=await readAdminForm(Astro.request,{allowedField:key=>['intent','confirm_name','confirmed','name','start_date','end_date','revision'].includes(key)});const id=Astro.url.searchParams.get('selected');if(submitted.intent==='delete-test'){await deleteTestTournament(db,id,submitted);return Astro.redirect('/admin/tournaments?deleted=test',303);}if(submitted.intent==='metadata'){await saveTournamentMetadata(db,id,submitted);return Astro.redirect(`/admin/tournaments?selected=${encodeURIComponent(id)}&saved=1`,303);}throw new AdminError('Unknown tournament action.');}}catch(error){message=error instanceof AdminError?error.message:'Could not save tournament.';Astro.response.status=error instanceof AdminError?error.status:503;}
try{tournaments=await listTournaments(db);}catch{failed=true;Astro.response.status=503;}
const q=Astro.url.searchParams.get('q')??'';const rows=tournaments.filter(row=>row.name.toLowerCase().includes(q.toLowerCase()));const selected=tournaments.find(row=>row.id===Astro.url.searchParams.get('selected'));
let editable=false;if(selected?.status==='upcoming')editable=!(await db.prepare('SELECT id FROM matches WHERE tournament_id=? LIMIT 1').bind(selected.id).first())&&!(await db.prepare('SELECT id FROM tournament_byes WHERE tournament_id=? LIMIT 1').bind(selected.id).first());
const date=value=>new Date(`${value}T00:00:00Z`).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'});
---
<AdminLayout title="Tournaments">
 <header class="admin-heading"><h1>Tournaments</h1><a class="admin-button" href="/admin/tournaments/new">Create Tournament</a></header>
 {message&&<p class="admin-error" role="alert">{message}</p>}{Astro.url.searchParams.has('deleted')&&<p role="status">Test tournament deleted.</p>}{Astro.url.searchParams.has('saved')&&<p role="status">Tournament saved.</p>}
 {failed?<p class="admin-error" role="alert">Could not load tournaments. Reload to try again.</p>:<div class:list={['admin-master-detail',{'has-inspector':!!selected}]}><section class="admin-master"><form method="get" class="admin-toolbar"><label>Search tournaments<input type="search" name="q" value={q}/></label><button type="submit" class="admin-outline">Search</button></form>{rows.length?<table class="admin-table operational-table"><thead><tr><th>Tournament</th><th>Dates</th><th>Status</th></tr></thead><tbody>{rows.map(row=><tr class:list={{'is-selected':selected?.id===row.id}}><td data-label="Tournament"><a href={`?selected=${encodeURIComponent(row.id)}&q=${encodeURIComponent(q)}`}>{row.name}</a>{row.is_test===1&&<span class="test-badge">TEST</span>}</td><td data-label="Dates">{date(row.start_date)} / {date(row.end_date)}</td><td data-label="Status"><Status label={row.status==='upcoming'?'Upcoming':row.status==='ongoing'?'Ongoing':'Completed'} tone={row.status==='completed'?'ready':'info'}/></td></tr>)}</tbody></table>:<p class="admin-empty">No matching tournaments.</p>}</section>
 {selected&&<aside class="admin-inspector"><header class="admin-heading"><h2>{selected.name}</h2><a href="/admin/tournaments">Close</a></header>{selected.is_test===1?<span class="test-badge">TEST</span>:<p>Official</p>}<a class="admin-button" href={`/admin/tournaments/${selected.id}`}>Open Tournament Workspace</a>
 {editable&&<form method="post" class="admin-form" data-pending-form><input type="hidden" name="intent" value="metadata"/><input type="hidden" name="revision" value={submitted?.revision??metadataRevision(selected)}/><label>Name<input name="name" value={submitted?.name??selected.name} minlength="3" maxlength="120" required/></label><label>Start Date<input type="date" name="start_date" value={submitted?.start_date??selected.start_date} required/></label><label>End Date<input type="date" name="end_date" value={submitted?.end_date??selected.end_date} required/></label><button class="admin-button" type="submit">Save Changes</button><p class="admin-submit-status" role="status"></p></form>}
 {selected.is_test===1&&<><button type="button" class="admin-outline" data-delete-test>Delete Test Tournament</button><dialog class="admin-dialog" data-delete-dialog aria-labelledby="delete-title"><h2 id="delete-title">Delete Test Tournament</h2><p>Permanently removes {selected.name} and its tournament data. Teams, Players and Maps are preserved.</p><form method="post" class="admin-form" data-pending-form><input type="hidden" name="intent" value="delete-test"/><input type="hidden" name="confirmed" value="yes"/><label>Type {selected.name}<input name="confirm_name" autocomplete="off" required/></label><div class="admin-actions"><button type="button" class="admin-outline" data-close-delete>Cancel</button><button type="submit" class="admin-button">Delete Permanently</button></div><p class="admin-submit-status" role="status"></p></form></dialog></>}
 </aside>}
 </div>}
</AdminLayout>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('[data-delete-dialog]');document.querySelector('[data-delete-test]')?.addEventListener('click',()=>dialog?.showModal());document.querySelector('[data-close-delete]')?.addEventListener('click',()=>dialog?.close());
</script>
