---
export const prerender=false;
import {env} from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AssetEditor from '../../components/admin/AssetEditor.astro';
import MasterFields from '../../components/admin/MasterFields.astro';
import {AdminError} from '../../admin/tournaments.mjs';
import {authorizeAdmin} from '../../admin/auth.mjs';
import {masterDefinitions,masterRevision,readMasterForm,saveMaster} from '../../admin/master-data.mjs';
const key=Astro.params.database!;const definition=Object.hasOwn(masterDefinitions,key)?masterDefinitions[key]:null;
if(!definition)Astro.response.status=404;
const db=(await authorizeAdmin(Astro.request,import.meta.env.DEV,env)).db;
let rows=[];let teams=[];let failed=false;let message='';let submitted;let history=[];
if(definition)try{
 if(Astro.request.method==='POST'){submitted=await readMasterForm(Astro.request,key);const id=await saveMaster(db,key,Astro.url.searchParams.get('selected'),submitted);return Astro.redirect(`/admin/${key}?selected=${encodeURIComponent(id)}&saved=1`,303);}
}catch(error){message=error instanceof AdminError?error.message:'Could not save record. Try again.';Astro.response.status=error instanceof AdminError?error.status:503;}
if(definition)try{const result=await db.prepare(`SELECT * FROM ${key} ORDER BY ${key==='players'?'current_ign':'name'} COLLATE NOCASE,id`).all();if(!result.success)throw new Error();rows=result.results;teams=(await db.prepare('SELECT id,name FROM teams ORDER BY name').all()).results;}catch{failed=true;Astro.response.status=503;}
const q=Astro.url.searchParams.get('q')??'';const selected=rows.find(row=>row.id===Astro.url.searchParams.get('selected'));const creating=Astro.url.searchParams.has('create')||submitted?.intent==='create';
if(selected&&key==='players')try{history=(await db.prepare('SELECT t.name AS tournament,teams.name AS team,tr.ign_snapshot AS ign FROM tournament_rosters tr JOIN tournaments t ON t.id=tr.tournament_id JOIN teams ON teams.id=tr.team_id WHERE tr.player_id=? ORDER BY t.start_date DESC,t.id LIMIT 5').bind(selected.id).all()).results;}catch{}
const columns=key==='players'?['uid','current_ign','current_team_id']:key==='teams'?['name','tag','region']:['name','active'];
const label={uid:'UID',current_ign:'Current IGN',current_team_id:'Current Team',name:'Name',tag:'Tag',region:'Region',active:'Status'};
const filtered=rows.filter(row=>(key==='players'?`${row.uid??''} ${row.current_ign}`:`${row.name} ${row.tag??''} ${row.region??''}`).toLowerCase().includes(q.toLowerCase()));
const values=submitted??selected??(key==='maps'?{active:'1'}:key==='teams'?{region:'ID'}:{});
const preview=selected?.logo??selected?.thumbnail;
const safePreview=preview&&(preview.startsWith('/')&&!preview.startsWith('//')&&!preview.includes('\\')||/^https:\/\//i.test(preview));
---
<AdminLayout title={definition?.title??'Page not found'}>
 {!definition?<h1>Page not found</h1>:<>
 <header class="admin-heading"><h1>{definition.title}</h1><a class="admin-button" href="?create=1">Create {definition.singular}</a></header>
 {message&&!creating&&<p role="alert" class="admin-error">{message}</p>}{Astro.url.searchParams.has('saved')&&<p role="status">{definition.singular} saved.</p>}
 {failed?<p class="admin-error" role="alert">Could not load records. Reload to try again.</p>:<div class:list={['admin-master-detail',{'has-inspector':!!selected&&!creating}]}><section class="admin-master">
 <form method="get" class="admin-toolbar"><label>Search {key==='players'?'UID / IGN':definition.title.toLowerCase()}<input type="search" name="q" value={q}/></label><button class="admin-outline" type="submit">Search</button></form>
 {filtered.length?<table class="admin-table operational-table"><thead><tr>{columns.map(column=><th>{label[column]}</th>)}</tr></thead><tbody>{filtered.map(row=><tr class:list={{'is-selected':selected?.id===row.id}}>{columns.map((column,index)=>{const value=column==='active'?row.active===1?'Active':'Inactive':column==='current_team_id'?teams.find(team=>team.id===row.current_team_id)?.name??'Unassigned':row[column]??'Not set';return <td data-label={label[column]}>{index===0||column==='current_ign'?<a href={`?selected=${encodeURIComponent(row.id)}&q=${encodeURIComponent(q)}`}>{value}</a>:value}</td>;})}</tr>)}</tbody></table>:<p class="admin-empty">No matching records.</p>}</section>
 {selected&&!creating&&<aside class="admin-inspector"><header class="admin-heading"><h2>{selected.current_ign??selected.name}</h2><a href={`/admin/${key}`}>Close</a></header>
 <AssetEditor category={key} entity={selected}/>
 <form method="post" class="admin-form" data-pending-form><input type="hidden" name="intent" value="edit"/><input type="hidden" name="revision" value={submitted?.revision??masterRevision(key,selected)}/><MasterFields definition={definition} key={key} values={values} teams={teams}/><button type="submit" class="admin-button">Save Changes</button><p class="admin-submit-status" role="status"></p></form>
 {history.length>0&&<section class="detail-section"><h3>Tournament History</h3><ul>{history.map(row=><li><strong>{row.tournament}</strong><br/>{row.team} · {row.ign}</li>)}</ul></section>}
 </aside>}
 </div>}
 {creating&&<dialog class="admin-dialog" data-master-create aria-labelledby="master-create-title"><header class="admin-heading"><h2 id="master-create-title">Create {definition.singular}</h2><a href={`/admin/${key}`}>Close</a></header>
 {message&&<p role="alert" class="admin-error">{message}</p>}
 <form method="post" class="admin-form" data-pending-form><input type="hidden" name="intent" value="create"/><MasterFields definition={definition} key={key} values={values} teams={teams} creating/><button class="admin-button" type="submit">Create {definition.singular}</button><p class="admin-submit-status" role="status"></p></form></dialog>}
 </>}
</AdminLayout>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('[data-master-create]');dialog?.showModal();dialog?.addEventListener('cancel',()=>window.location.assign(window.location.pathname));
</script>
