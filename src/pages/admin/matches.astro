---
export const prerender=false;
import { env } from 'cloudflare:workers';
import {authorizeAdmin} from '../../admin/auth.mjs';
const db=(await authorizeAdmin(Astro.request,import.meta.env.DEV,env)).db;
const id=Astro.url.searchParams.get('tournament');
return Astro.redirect(id&&/^[a-z0-9-]{1,120}$/.test(id)?`/admin/tournaments/${id}/matches`:'/admin/tournaments',302);
---
