---
export const prerender = false;
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listTournaments, requireLocalAdmin } from '../../admin/tournaments.mjs';
const db = requireLocalAdmin(Astro.request, import.meta.env.DEV, env);
let tournaments = []; let unavailable = false;
try { tournaments = await listTournaments(db); }
catch (error) { console.error('[admin] Tournament list failed', error); unavailable = true; Astro.response.status = 503; }
---
<AdminLayout title="Tournaments">
  <header class="admin-heading"><div><h1>Tournaments</h1><p>Manage tournament setup and schedules.</p></div><a class="admin-button" href="/admin/tournaments/new">Create Tournament</a></header>
  {unavailable ? <p role="alert" class="admin-error">Could not load tournaments from staging. Check the database connection and migrations, then reload.</p> : tournaments.length === 0 ?
    <section class="admin-empty"><h2>No tournaments yet</h2><p>Create a tournament to begin its setup.</p></section> :
    <ul class="admin-list">{tournaments.map(tournament => <li>
      <div><h2><a href={`/admin/tournaments/${tournament.id}/setup`}>{tournament.name}</a></h2><p>{tournament.start_date} to {tournament.end_date}</p><p>{tournament.region} · {tournament.format}</p></div>
      <div class="admin-row-end"><span class={`status-badge status-${tournament.status}`}>{tournament.status}</span><a href={`/admin/tournaments/${tournament.id}/setup`}>Open setup</a></div>
    </li>)}</ul>}
</AdminLayout>
