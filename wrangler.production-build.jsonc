{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfl-production-build-only",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false
}
